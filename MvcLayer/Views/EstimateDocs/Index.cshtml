@model IEnumerable<MvcLayer.Models.EstimateDocViewModel>
@using BusinessLayer.Enums;
@using BusinessLayer.Helpers
@using BusinessLayer.Interfaces.Shared
@using BusinessLayer.Models;
@using BusinessLayer.Models.KDO
@inject BusinessLayer.Interfaces.ContractInterfaces.IFileService Files
@inject IHttpContextUserProvider HttpHelper


@{
    var permissions = HttpHelper.GetUserPermissions();
    ViewData["Title"] = "Проектно-сметная документация";
    // bool isAdmin = true;
    string redirectAction = "Index";
    string redirectController = "EstimateDocs"; 
    var isGRP_Contract = permissions.GroupeName.Contains(Constants.GRP_CONTRACT);

}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create">Добавить</a>
</p>
<table class="table table-main table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Number)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DateChange)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DateOutput)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Reason)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsChange)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Contract)
            </th>
            <th>Файл</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Number)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DateChange)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DateOutput)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Reason)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.IsChange)
                </td>
                <td>
                    @foreach (FileDTO file in Files.GetAttachedFiles(item.Id, Folder.EstimateDocumentations))
                    {
                        <div>
                            <a href="~/Files/OpenFile?id=@file.Id" target="_blank">@file.FileName</a>
                            @if (permissions is not null && (permissions.IsDeleter || permissions.IsAdmin) && isGRP_Contract)
                            {
                                <a asp-controller="Files" asp-action="Delete" asp-route-id="@file.Id"
                                   asp-route-redirectAction="@redirectAction"
                                   asp-route-redirectController="@redirectController"
                                   asp-route-page="@ViewBag.Page"
                                   title="Удалить файл"
                                   class="modal-link del-btn"
                                   data-message="Прикрепленный файл будет удален. Продолжить?"> × </a>
                            }
                        </div>
                    }
                </td>
                <td>
                    @if (permissions is not null && permissions.IsCreator && isGRP_Contract)
                    {
                        <a asp-action="AddFile" asp-controller="Files"
                           asp-route-entityId="@item.Id"
                           asp-route-fileCategory="@Folder.EstimateDocumentations"
                           asp-route-redirectAction=@redirectAction
                           asp-route-redirectController=@redirectController>Добавить файл</a>
                        <span>|</span>
                    }
                    @if (permissions is not null && permissions.IsEditor && isGRP_Contract)
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id">Редактировать</a>
                        <span>|</span>
                    }
                    @if (permissions is not null && (permissions.IsDeleter || permissions.IsAdmin) && isGRP_Contract)
                    {
                        <a asp-action="Delete" asp-route-id="@item.Id">Удалить</a>
                        <span>|</span>
                    }
                    <a asp-action="Details" asp-route-id="@item.Id">Детали</a>
                </td>
            </tr>
        }
    </tbody>
</table>