            <span class="ch-badge-count" id="release-notes-badge"></span>
        </a>
        @{
            var user = @User?.Identities?.FirstOrDefault()?.Claims?.FirstOrDefault(x => x.Type == "given_name")?.Value.Split(' ');
        }
        <div class="ch-user-menu">
            <button class="ch-user-trigger" aria-expanded="false" onclick="toggleUserMenu(this)">
                <span class="ch-user-avatar">@user[0][0] @user[1][0]</span>
                <span class="ch-user-name">@String.Join(' ', user)</span>
                <svg class="ch-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><path d="M6 9l6 6 6-6" /></svg>
            </button>
            <div class="ch-user-dropdown" id="ch-user-dropdown">

                @if (permissions is not null && permissions.IsLeadAdmin)
                {
                    <a class="ch-user-dropdown-item" href="~/admin/dashboard" title="Видно только администраторам">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" /></svg>
                        Админка
                    </a>
                }
                <div class="ch-user-dropdown-divider"></div>


                @if ((User?.Identity == null) || (!(User.Identity.IsAuthenticated)))
                {
                    <a class="ch-user-dropdown-item" asp-controller="Account" asp-action="Login">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                        Войти
                    </a>
                }
                else
                {                 

                    <a class="ch-user-dropdown-item" asp-controller="Account" asp-action="Logout">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                        Выйти
                    </a>
                }

               
            </div>
        </div>

        <button class="ch-burger-btn" onclick="openMobilePanel()" title="Меню">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="4" y1="7" x2="20" y2="7" /><line x1="4" y1="12" x2="20" y2="12" /><line x1="4" y1="17" x2="20" y2="17" /></svg>
        </button>

    </div>

</div>
