                <a class="ch-mega-item" asp-controller="Payments" asp-action="GetPayableCash">
                    <span class="ch-mega-item-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2" /><path d="M2 10h20M6 15h4" /></svg></span>
