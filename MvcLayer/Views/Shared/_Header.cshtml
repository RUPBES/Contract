<script>
    (function(){
      'use strict';

      function ready(fn){
        if(document.readyState !== 'loading'){ fn(); }
        else{ document.addEventListener('DOMContentLoaded', fn); }
      }

      ready(function(){

        /* ---- hover full-width меню с задержками открытия/закрытия ---- */
        var OPEN_DELAY = 180;
        var CLOSE_DELAY = 250;
        var openTimer = null, closeTimer = null;
        var currentFwPanel = null, currentFwTrigger = null;

        function openFw(navItemEl, panelId){
          closeFwImmediate();
          var panel = document.getElementById(panelId);
          var trigger = navItemEl.querySelector('.ch-nav-link');
          if(!panel || !trigger) return;
          panel.classList.add('ch-open');
          trigger.classList.add('ch-is-open');
          currentFwPanel = panel; currentFwTrigger = trigger;
        }
        function scheduleOpenFw(navItemEl, panelId){
          clearTimeout(closeTimer); clearTimeout(openTimer);
          openTimer = setTimeout(function(){ openFw(navItemEl, panelId); }, OPEN_DELAY);
        }
        function scheduleCloseFw(){
          clearTimeout(openTimer); clearTimeout(closeTimer);
          closeTimer = setTimeout(closeFwImmediate, CLOSE_DELAY);
        }
        function cancelCloseFw(){ clearTimeout(closeTimer); }
        function closeFwImmediate(){
          if(currentFwPanel){ currentFwPanel.classList.remove('ch-open'); }
          if(currentFwTrigger){ currentFwTrigger.classList.remove('ch-is-open'); }
          currentFwPanel = null; currentFwTrigger = null;
        }

        document.querySelectorAll('[data-ch-fw-trigger]').forEach(function(navItemEl){
          var panelId = navItemEl.getAttribute('data-ch-fw-trigger');
          navItemEl.addEventListener('mouseenter', function(){ scheduleOpenFw(navItemEl, panelId); });
          navItemEl.addEventListener('mouseleave', scheduleCloseFw);
        });
        document.querySelectorAll('.ch-fw-panel').forEach(function(panelEl){
          panelEl.addEventListener('mouseenter', cancelCloseFw);
          panelEl.addEventListener('mouseleave', scheduleCloseFw);
        });

        /* ---- меню пользователя ---- */
        var userTrigger = document.querySelector('[data-ch-user-toggle]');
        var userDropdown = document.getElementById('ch-user-dropdown');
        if(userTrigger && userDropdown){
          userTrigger.addEventListener('click', function(e){
            e.stopPropagation();
            var isOpen = userDropdown.classList.contains('ch-open');
            userDropdown.classList.toggle('ch-open', !isOpen);
            userTrigger.setAttribute('aria-expanded', String(!isOpen));
          });
          document.addEventListener('click', function(e){
            if(userDropdown.classList.contains('ch-open') &&
               !userDropdown.contains(e.target) && !userTrigger.contains(e.target)){
              userDropdown.classList.remove('ch-open');
              userTrigger.setAttribute('aria-expanded', 'false');
            }
          });
        }

        /* ---- мобильная панель: портал в body + addEventListener ---- */
        var overlayEl = document.getElementById('ch-mobile-overlay');
        var panelEl   = document.getElementById('ch-mobile-panel');
        var burgerOpenBtns  = document.querySelectorAll('[data-ch-burger-open]');
        var burgerCloseEls  = document.querySelectorAll('[data-ch-burger-close]');

        if(overlayEl && panelEl){
          // переносим оба узла в самый конец body — исключает влияние
          // чужого transform/overflow/z-index на родителях шапки/layout
          document.body.appendChild(overlayEl);
          document.body.appendChild(panelEl);

          function openMobilePanel(){
            overlayEl.classList.add('ch-open');
            panelEl.classList.add('ch-open');
            document.body.style.overflow = 'hidden';
          }
          function closeMobilePanel(){
            overlayEl.classList.remove('ch-open');
            panelEl.classList.remove('ch-open');
            document.body.style.overflow = '';
          }

          burgerOpenBtns.forEach(function(btn){
            btn.addEventListener('click', openMobilePanel);
          });
          burgerCloseEls.forEach(function(el){
            el.addEventListener('click', closeMobilePanel);
          });
          document.addEventListener('keydown', function(e){
            if(e.key === 'Escape' && panelEl.classList.contains('ch-open')){ closeMobilePanel(); }
          });
        }

        /* ---- аккордеоны внутри мобильной панели ---- */
        document.querySelectorAll('[data-ch-mobile-accordion]').forEach(function(link){
          var bodyId = link.getAttribute('data-ch-mobile-accordion');
          var body = document.getElementById(bodyId);
          if(!body) return;
          link.addEventListener('click', function(e){
            e.preventDefault();
            var isOpen = body.classList.contains('ch-open');
            body.classList.toggle('ch-open', !isOpen);
            link.setAttribute('aria-expanded', String(!isOpen));
          });
        });

      });
    })();
</script>


