<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
       @if (ViewData["Title"] != null)
    {
        <title>@ViewData["Title"]</title>
    }
    else
    {
    <title>Учет договоров</title>
    }

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/filter-widget.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chosen.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/selectize.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/selectize.default.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/TableStyle.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modalWindow.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/element-styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/md3-modal.css" asp-append-version="true" />
    <link href="~/kendoui/kendo.common.min.css" rel="stylesheet" />
    <link href="~/kendoui/kendo.bootstrap-main.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/organization-details.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/partial-modal-form.css" asp-append-version="true" />
    <style>
        header {
            position: sticky;
            top: 0;
            z-index: 1000;
        }
    </style>

    <link rel="stylesheet" href="~/lib/bootstrap-datepicker-1.9.0-dist/css/bootstrap-datepicker.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-datepicker-1.9.0-dist/css/bootstrap-datepicker3.min.css" />
    @* из-за partial jquery не успевает увидеть *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
</head>
<body>
    <div id="modDialog" class="modal fade" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" style="background: rgba(0, 0, 0, 0.65);">
        <div id="dialogContent" class="modal-dialog" style="display: flex; justify-content: center; margin-top: 10vh"></div>
    </div>
    <div class="contract-filter-container">
    </div>
    <div class="flex-container">
        <header class="header_container">
            @Html.Partial("_Header")
        </header>

        @if (IsSectionDefined("Table"))
        {
            <div class="table-container">
                @RenderSection("Table")
            </div>
        }
        else
        {
            <div class="container">
                <main role="main" class="pb-3" style="display: flex; justify-content: center;">
                    <img src="/images/logo-min1.svg" style="width:50%; height:50%; background-color: #2e354e;" />
                    @RenderBody()
                </main>
            </div>
        }
        <div class="footer">
            &copy; <span style="text-transform:uppercase;">РУП "Белэнергострой" - Договоры</span>   <span>@DateTime.Now.Year </span>@* <a asp-controller="Home" asp-action="Privacy">Документация</a> *@
        </div>
    </div>

    <!-- Notification container -->
    <div class="notification-container">
        @if (TempData["NotificationMessage"] != null)
        {
            <div class="notification @TempData["NotificationType"]">
                @TempData["NotificationMessage"]
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        }
    </div>
  

    <!-- Alert message container -->
    <div id="alert-modal" class="md-overlay" style="display:none; align-content: center;">
        <div class="md-modal" style="max-width:500px;">
            <div class="md-card">
                <div class="md-card-header">
                    <h1 class="md-title" id="alert-modal_title">Предупреждение</h1>
                    <div class="md-subtitle" id="alert-modal_message">Вы уверены?</div>
                </div>
                <div class="md-actions">
                    <button class="md-button md-button--filled" id="alert-modal_confirm">
                        <svg class="md-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg>
                        Да
                    </button>
                    <button class="md-button" id="alert-modal_cancel">
                        <svg class="md-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.3 5.71 12 12.01 5.7 5.7 4.29 7.11l6.3 6.3-6.3 6.3 1.41 1.41 6.3-6.29 6.29 6.29 1.41-1.41-6.29-6.3 6.29-6.3z"/></svg>
                        Отмена
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap-datepicker-1.9.0-dist/js/bootstrap-datepicker.min.js"></script>
    <script src="~/lib/bootstrap-datepicker-1.9.0-dist/locales/bootstrap-datepicker.ru.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.unobtrusive-ajax.min.js"></script>
    <script src="~/lib/jquery-validation/dist/additional-methods.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/customJs.js" asp-append-version="true"></script>

    <script src="~/js/helpers/MonthYearWidget.js"></script>
    <script src="~/js/helpers/PeriodManager.js"></script>
    <script src="~/js/helpers/PaginationManager.js"></script>
    <script src="~/js/helpers/ScrollManager.js"></script>
    <script src="~/js/viewTemplate.js" asp-append-version="true"></script>
    <script src="~/js/helpers/ActionButtonManager.js"></script>

    <script src="~/js/contracts-table-manager.js" asp-append-version="true"></script>
    <script src="~/kendoui/kendo.all.min.js"></script>
    <script src="~/js/chosen.jquery.min.js"></script>
    <script src="~/js/selectize.min.js"></script>
    <script src="~/kendoui/kendo.culture.by-BY.min.js"></script>
    <script src="~/kendoui/kendo.time.date.class-style.js"></script>
    <script src="~/js/release-notes-badge.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
