@model MVC_layer.Models.ErrorViewModel
@{
    ViewData["Title"] = "Ошибка";
}

<div class="md-overlay">
    <div class="md-modal">
        <div class="md-card">
            <div class="md-card-header">
                <h1 class="md-title">@Model.Error</h1>
                <div class="md-subtitle">@Model.ErrorDescription</div>
                <div class="md-chips">
                    @if (Model.StatusCode.HasValue) { <span class="md-chip">Код: @Model.StatusCode</span> }
                    @if (!string.IsNullOrEmpty(Model.Method)) { <span class="md-chip">Метод: @Model.Method</span> }
                    @if (!string.IsNullOrEmpty(Model.Path)) { <span class="md-chip">Путь: @Model.Path</span> }
                    @if (Model.ShowRequestId) { <span class="md-chip">ID запроса: @Model.RequestId</span> }
                </div>
            </div>
            <div class="md-card-body">
                <div class="md-section">
                    <div class="md-kv">
                        <div class="k">Пользователь</div>
                        <div class="v">@(string.IsNullOrEmpty(Model.UserName) ? "—" : Model.UserName)</div>
                        <div class="k">Строка запроса</div>
                        <div class="v">@(string.IsNullOrEmpty(Model.QueryString) ? "—" : Model.QueryString)</div>
                        @if (!string.IsNullOrEmpty(Model.ExceptionType)) {
                            <div class="k">Тип исключения</div>
                            <div class="v"><code>@Model.ExceptionType</code></div>
                        }
                    </div>
                </div>

                @if (Model.IsDevelopment && !string.IsNullOrEmpty(Model.StackTrace))
                {
                    <div class="md-section">
                        <details class="md-expansion" open>
                            <summary>Диагностика (Dev)</summary>
                            <div class="content">
                                <div class="md-code"><pre>@Model.StackTrace</pre></div>
                            </div>
                        </details>
                    </div>
                }
            </div>
            <div class="md-actions">
                <a href="/" class="md-button md-button--filled">
                    <svg class="md-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
                    На главную
                </a>
                <a href="javascript:history.back()" class="md-button">
                    <svg class="md-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H19v-2z"/></svg>
                    Назад
                </a>
            </div>
        </div>
    </div>
    
</div>