@using BusinessLayer.Enums
@using BusinessLayer.Helpers
@using BusinessLayer.Models
@model MvcLayer.Models.SelectionProcedureViewModel
@inject BusinessLayer.Interfaces.ContractInterfaces.IContractService Contract
@inject BusinessLayer.Interfaces.CommonInterfaces.IHttpHelper HttpHelper
@inject BusinessLayer.Interfaces.ContractInterfaces.IFileService Files

@{
    var permissions = HttpHelper.GetUserPermissions();
    var isGRP_Contract = permissions.GroupeName.Contains(Constants.GRP_CONTRACT);
    var contract = Model?.ContractId > 0 ? Contract.GetById((int)Model?.ContractId) : null;
    ViewData["Title"] = "Процедура выбора";
    string redirectAction = "GetByContractId";
    string redirectController = "SelectionProcedures";
}

<div class="dm-overlay">
    <div class="dm-table">
        <div class="dm-cell">
            <div class="dm-modal">
                <div class="top-modal-block">
                    <label class="my-modal-title">@ViewData["Title"] по договору @contract?.Number</label>
                    @if (@contract?.Id != null && @contract?.Id > 0)
                    {
                        <a asp-controller="Contracts" asp-action="Details" asp-route-id="@contract?.Id" class="close-btn"></a>
                    }
                    @if (@contract?.Id == null || @contract?.Id == 0)
                    {
                        <a asp-controller="Contracts" asp-action="" class="close-btn"></a>
                    }
                </div>
                <hr class="modal-line" />
                <table class="table table-striped table-bordered table-main">
                    <thead>
                        <tr>
                            <th rowspan="2">
                                @Html.DisplayNameFor(model => model.TypeProcedure)
                            </th>
                            <th class="text-center" colspan="2">
                                Cроки проведения
                            </th>
                            <th rowspan="2">
                                @Html.DisplayNameFor(model => model.Name)
                            </th>
                            <th rowspan="2">
                                @Html.DisplayNameFor(model => model.StartPrice)
                            </th>
                            <th rowspan="2">
                                @Html.DisplayNameFor(model => model.AcceptancePrice)
                            </th>
                            <th rowspan="2">
                                Снижение
                            </th>
                            <th rowspan="2">
                                @Html.DisplayNameFor(model => model.AcceptanceNumber),
                                @Html.DisplayNameFor(model => model.DateAcceptance)
                            </th>
                            <th rowspan="2">Файлы</th>
                            <th rowspan="2"></th>
                        </tr>
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.DateBegin)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.DateEnd)
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @*  @foreach (var item in Model)
                        { *@
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => Model.TypeProcedure)
                            </td>
                            <td>
                                @Model.DateBegin?.ToShortDateString()
                            </td>
                            <td>
                                @Model.DateEnd?.ToShortDateString()
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => Model.Name)
                            </td>
                            <td class="text-end">
                                @Convert.ToDecimal(Model.StartPrice).ToString("N2")
                            </td>
                            <td class="text-end">
                                @Convert.ToDecimal(Model.AcceptancePrice).ToString("N2")
                            </td>
                            <td class="text-end">
                                @{
                                    var discont = Convert.ToDecimal(Model.StartPrice) - Convert.ToDecimal(Model.AcceptancePrice);
                                }
                                @discont.ToString("N2")
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => Model.AcceptanceNumber)
                                @if (@Model.DateAcceptance != null)
                                {
                                    <span>
                                        от
                                    </span>
                                    @Model.DateAcceptance?.ToShortDateString()
                                }
                            </td>
                            <td>

                                @foreach (FileDTO item2 in Files.GetAttachedFiles(Model.Id, FolderEnum.SelectionProcedures))
                                {
                                    <div>
                                        <a href="~/Files/OpenFile?id=@item2.Id&fileType=@item2.FileType" target="_blank">@item2.FileName</a>
                                        @if (permissions is not null && (permissions.IsAdmin || permissions.IsDeleter) && isGRP_Contract)
                                        {
                                            
                                                <a asp-controller="Files" asp-action="Delete" asp-route-id="@item2.Id"
                                                   asp-route-redirectAction="@redirectAction"
                                                   asp-route-redirectController="@redirectController"
                                                   asp-route-fileCategory="@FolderEnum.SelectionProcedures"
                                                   asp-route-contractId="@Model.ContractId"
                                                   title="Удалить файл"
                                                   class="modal-link del-btn"
                                               data-message="Прикрепленный файл будет удален. Продолжить?">×</a>
                                            
                                        }
                                    </div>
                                }
                            </td>
                            <td>
                                @if (permissions is not null && permissions.IsEditor && isGRP_Contract)
                                {
                                    <span class="icon edit" title="Редактировать процедуру закупки">
                                        <a asp-action="Edit" asp-route-id="@Model.Id" asp-route-contractId="@Model.ContractId"></a>
                                    </span>
                                }
                                @if (permissions is not null && (permissions.IsDeleter || permissions.IsAdmin) && isGRP_Contract)
                                {
                                    <span class="icon delete" title="Удалить процедуру закупки">
                                        <a asp-action="Delete"
                                           asp-route-id="@Model.Id"
                                           asp-route-contractId="@Model.ContractId"
                                           class="modal-link"
                                           data-message="Процедура закупки и прикрепленные файлы будут удалены. Продолжить?">
                                        </a>
                                    </span>
                                }
                            </td>
                        </tr>
                        @* } *@
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>