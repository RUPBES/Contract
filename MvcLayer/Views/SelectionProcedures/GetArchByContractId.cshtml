@using BusinessLayer.Enums
@using BusinessLayer.Models.KDO
@model MvcLayer.Models.SelectionProcedureViewModel
@inject BusinessLayer.Interfaces.ContractInterfaces.IContractService Contract
@inject BusinessLayer.Interfaces.ContractInterfaces.IFileService Files

@{
    ViewData["Title"] = "Процедура выбора";

    

    int backId = ViewBag.returnContractId == 0
         ? (int)ViewBag.contractId
         : (int)ViewBag.returnContractId;

    var contract = Model?.ContractId is > 0
       ? Contract.GetById((int)Model?.ContractId, useArchiveData:true)
       : (ViewBag.contractId is > 0 
            ? Contract.GetById((int)ViewBag.contractId, useArchiveData: true)
            : null
         );

    var actionReturn = ViewBag.IsEngineering == true
        ? "EngineeringsArch"
        : "IndexArch";
}
<style>
    .dm-modal {
        width: min(90vw, 1600px) !important;
        max-width: 1600px !important;
    }
</style>
<link rel="stylesheet" href="~/css/organization-details.css" asp-append-version="true" />

<div class="dm-overlay">
    <div class="dm-table">
        <div class="dm-cell">
            <div class="dm-modal">
                <div class="am-wrap">
                    <!-- Шапка -->
                    <div class="am-header">
                        <span class="am-header-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                <polyline points="14 2 14 8 20 8" />
                                <line x1="16" y1="13" x2="8" y2="13" />
                                <line x1="16" y1="17" x2="8" y2="17" />
                            </svg>
                        </span>
                        <div class="am-header-info">
                            <h1 class="am-header-title">
                                @ViewData["Title"]
                                @if (contract != null)
                                {
                                    <span> по договору <span style="color:var(--md3-primary);">№@contract.Number</span></span>
                                }
                            </h1>
                            @if (contract?.NameObject != null)
                            {
                                <div class="am-header-sub">@contract.NameObject</div>
                            }
                        </div>
                        <div class="am-header-actions">
                            @if (backId is > 0)
                            {
                                <a asp-controller="Contracts" asp-action="DetailsArch" asp-route-id="@backId" class="close-btn" aria-label="Закрыть"></a>
                            }
                            else
                            {
                                <a asp-controller="Contracts" asp-action="@actionReturn" class="close-btn" aria-label="Закрыть"></a>
                            }
                        </div>
                    </div>

                    <!-- Карточка -->
                    <div class="am-card">
                        <div class="am-table-scroll">
                            <table class="am-table">
                                <thead>
                                    <!-- Строка 1: основные колонки + объединённый «Сроки» -->
                                    <tr>
                                        <th class="col-5per-50max" rowspan="2">
                                            @Html.DisplayNameFor(model => model.TypeProcedure)
                                        </th>
                                        <th class="col-6per-67max" colspan="2">
                                            Cроки проведения
                                        </th>
                                        <th class="col-22per-160min" rowspan="2">
                                            @Html.DisplayNameFor(model => model.Name)
                                        </th>
                                        <th class="col-6per-67max" rowspan="2">
                                            @Html.DisplayNameFor(model => model.StartPrice)
                                        </th>
                                        <th class="col-6per-67max" rowspan="2">
                                            @Html.DisplayNameFor(model => model.AcceptancePrice)
                                        </th>
                                        <th class="col-6per-67max" rowspan="2">
                                            Снижение
                                        </th>
                                        <th class="col-6per-67max" rowspan="2">
                                            @Html.DisplayNameFor(model => model.AcceptanceNumber)
                                        </th>
                                        <th class="col-4per-120max" rowspan="2">Файлы</th>                                        
                                    </tr>
                                    <!-- Строка 2: подгруппа «выполнения работ» -->
                                    <tr>
                                        <th class="col-6per-67max">
                                            начало
                                        </th>
                                        <th class="col-5per-67max" style="border-right: 1px solid var(--md3-outline);">
                                            окончание
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td class="col-5per-50max">
                                            <div class="am-num"> @Html.DisplayFor(modelItem => Model.TypeProcedure)</div>
                                        </td>
                                        <td class="col-6per-67max am-col-date">
                                            <span class="am-date-val">
                                                @Model?.DateBegin?.ToString("dd MMM yyyy")
                                            </span>
                                        </td>
                                        <td class="col-6per-67max am-col-date">
                                            <span class="am-date-val">
                                                @Model?.DateEnd?.ToString("dd MMM yyyy")
                                            </span>
                                        </td>
                                        <td class="col-22per-160min">
                                            @Html.DisplayFor(m => Model.Name)
                                        </td>
                                        <td class="am-col-price col-6per-67max responsive-text">
                                            <span class="am-price">
                                                @(decimal.TryParse(Model?.StartPrice, out var startPrice)
                                                                                                ? startPrice.ToString("N2")
                                                                                                : "0,00")
                                            </span>
                                        </td>
                                        <td class="am-col-price col-6per-67max responsive-text">
                                            <span class="am-price">
                                                @(decimal.TryParse(Model?.AcceptancePrice, out var acceptPrice)
                                                                                                ? acceptPrice.ToString("N2")
                                                                                                : "0,00")
                                            </span>
                                        </td>
                                        <td class="col-6per-67max am-col-price responsive-text">
                                            <span class="am-price">
                                                @((startPrice - acceptPrice).ToString("N2"))
                                            </span>
                                        </td>
                                        <td class="col-6per-67max">
                                            <div class="am-num"> @Html.DisplayFor(modelItem => Model.AcceptanceNumber)</div>
                                            @if (Model.DateAcceptance.HasValue)
                                            {
                                                <div class="am-date-sub ">
                                                    от  @Model.DateAcceptance?.ToString("dd MMM yyyy")
                                                </div>
                                            }
                                        </td>
                                        <!-- Файлы -->
                                        <td class="col-4per-120max">
                                            @foreach (FileDTO item2 in Files.GetAttachedFiles(Model.Id, Folder.SelectionProcedures))
                                            {
                                                <div class="am-file-row">
                                                    <a href="~/Files/OpenFile?id=@item2.Id&fileType=@item2.FileType"
                                                       title="@item2.FileName"
                                                       class="am-file-link"
                                                       target="_blank">@item2.FileName</a>                                                    
                                                </div>
                                            }
                                        </td>                                       
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>