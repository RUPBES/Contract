@using OfficeOpenXml
@model IEnumerable<ExcelWorksheet>
@{
    var isEstimate = ViewBag.IsEstimate;
    var isChange = ViewBag.IsChange;
    var estimateId = ViewBag.EstimateId;

    string classBox = string.Empty;
    if (isEstimate)
    {
        classBox = "box-hidden";
    }
}
@if (Model.Count() > 2)
{
    @if (isEstimate && !isChange)
    {
        <div class="row">
            <div class="col-6"><button id="btnChooseOneId" class="mt-3 col-12 btn btn-primary" type="button">Выбрать страницу со сметой</button></div>
            <div class="col-6">
                <button id="btnChooseAllId" class="mt-3 col-12 btn btn-primary" type="button">Загрузить все сметы из Excel</button>
                <input id="countDocumentPages" type="number" value="@Model.Count()" hidden />
            </div>
        </div>
    }
    <div class="@classBox">
        <input id="changeEstimateId" type="number" value="@estimateId" hidden />

        <label style="font-weight:700 !important; font-size:0.95rem;">Выберите необходимую страницу Excel</label>
        <select name="page" id="ex" class="form-select underline-green">
            <option selected disabled>
                <span>Выбрать</span>
            </option>
            @foreach (var item in Model)
            {
                <option value="@item.Index">
                    <span>
                        @item.Name
                    </span>
                </option>
            }
        </select>
        <button id="GetDataFromFile" class="mt-3 btn btn-hidden btn-primary" type="button">Извлечь данные</button>
    </div>


}
else if (Model.Count() == 1)
{
    <select name="page" id="ex" class="form-select" hidden>
        <option selected value="@Model.FirstOrDefault().Index">
            <span>
                @Model.FirstOrDefault().Name
            </span>
        </option>
    </select>
    <button id="GetDataFromFile" class="mt-3 btn btn-primary" type="button">Извлечь данные</button>
}

<script>
    $("select#ex").change((e) => {
        e.target.classList.remove("underline-green");
        let elem = document.querySelector("button#GetDataFromFile");
        elem.classList.remove('btn-hidden');
    });

    $("#btnChooseOneId").click((e) => {
        e.target.parentElement.parentElement.remove();
        let elem = document.querySelector(".box-hidden");
        elem.classList.remove('box-hidden');
    });
</script>