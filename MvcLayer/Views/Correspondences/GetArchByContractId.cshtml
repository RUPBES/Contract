@model IEnumerable<MvcLayer.Models.CorrespondenceViewModel>
@using BusinessLayer.Enums;
@using BusinessLayer.Models.KDO
@inject BusinessLayer.Interfaces.ContractInterfaces.IFileService Files
@inject BusinessLayer.Interfaces.ContractInterfaces.IContractService Contract

@{
    ViewData["Title"] = "Переписка с заказчиком";

    int backId = ViewBag.returnContractId == 0
        ? (int)ViewBag.contractId
        : (int)ViewBag.returnContractId;

    var contract = ViewData["contractId"] is > 0
        ? Contract.GetById((int)ViewData["contractId"], useArchiveData: true)
        : null;
}

<link rel="stylesheet" href="~/css/organization-details.css" asp-append-version="true" />
<style>
    .dm-modal {
        width: min(90vw, 1600px) !important;
        max-width: 1600px !important;
    }
</style>
<div class="dm-overlay">
    <div class="dm-table">
        <div class="dm-cell">
            <div class="dm-modal">
                <div class="am-wrap">
                    <!-- Шапка -->
                    <div class="am-header">
                        <span class="am-header-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                <polyline points="14 2 14 8 20 8" />
                                <line x1="16" y1="13" x2="8" y2="13" />
                                <line x1="16" y1="17" x2="8" y2="17" />
                            </svg>
                        </span>
                        <div class="am-header-info">
                            <h1 class="am-header-title">
                                @ViewData["Title"]
                                @if (contract != null)
                                {
                                    <span> по договору <span style="color:var(--md3-primary);">№@contract?.Number</span></span>
                                }

                            </h1>
                            @if (contract?.NameObject != null)
                            {
                                <div class="am-header-sub">@contract.NameObject</div>
                            }
                        </div>
                        <div class="am-header-actions">
                            @if (backId > 0)
                            {
                                <a asp-controller="Contracts" asp-action="DetailsArch" asp-route-id="@backId" class="close-btn" aria-label="Закрыть"></a>
                            }
                            else
                            {
                                <a asp-controller="Contracts" asp-action="IndexArch" class="close-btn" aria-label="Закрыть"></a>
                            }
                        </div>
                    </div>
                   
                    <!-- Карточка -->
                    <div class="am-card">
                        @if (Model.Any())
                        {
                            <div class="am-table-scroll">
                                <table class="am-table">
                                    <thead>
                                        <tr>
                                            <th class="col-6per-50min"> @Html.DisplayNameFor(model => model.Number)</th>
                                            <th class="col-6per-50min">@Html.DisplayNameFor(model => model.Date)</th>
                                            <th class="col-6per-50min">Тип письма</th>
                                            <th class="col-40per-250max">@Html.DisplayNameFor(model => model.Summary)</th>
                                            <th class="col-5per-50max-files">
                                                Файлы
                                            </th>                                            
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.OrderByDescending(x => x.Date))
                                        {
                                            <tr>
                                                <!-- Номер -->
                                                <td class="col-6per-50min">
                                                    <div class="am-num">
                                                        @Html.DisplayFor(modelItem => item.Number)
                                                    </div>
                                                </td>

                                                <!-- Дата -->
                                                <td class="col-6per-50min">
                                                    <span class="am-date-val">
                                                        @item?.Date?.ToString("dd MMMM yyyy")
                                                    </span>
                                                </td>
                                                <td class="col-6per-50min">

                                                    @if (item.IsInBox is true)
                                                    {
                                                        <span class="mail-badge incoming">
                                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                                                                 stroke="currentColor" stroke-width="2"
                                                                 stroke-linecap="round" stroke-linejoin="round">

                                                                <rect x="3" y="8" width="18" height="12" rx="2"></rect>

                                                                <polyline points="3,10 12,16 21,10"></polyline>

                                                                <polyline points="12,2 12,8"></polyline>
                                                                <polyline points="9,5 12,8 15,5"></polyline>

                                                            </svg>
                                                            Входящее
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="mail-badge outgoing">
                                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                                                                 stroke="currentColor" stroke-width="2"
                                                                 stroke-linecap="round" stroke-linejoin="round">

                                                                <!-- Конверт -->
                                                                <rect x="3" y="8" width="18" height="12" rx="2"></rect>
                                                                <polyline points="3,10 12,16 21,10"></polyline>

                                                                <!-- Стрелка вверх (исходящее) -->
                                                                <line x1="12" y1="8" x2="12" y2="2"></line>
                                                                <polyline points="9,5 12,2 15,5"></polyline>

                                                            </svg>
                                                            Исходящее
                                                        </span>
                                                    }

                                                </td>
                                                <td class="col-40per-250max responsive-text">
                                                    @Html.DisplayFor(modelItem => item.Summary)
                                                </td>

                                                <!-- Файлы -->
                                                <td class="col-4per-120max">
                                                    @foreach (FileDTO file in Files.GetAttachedFiles(item.Id, Folder.Correspondences))
                                                    {
                                                        <div class="am-file-row">
                                                            <a href="~/Files/OpenFile?id=@file.Id" title="@file.FileName" class="am-file-link" target="_blank">@file.FileName</a>                                                           
                                                        </div>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <!-- Подвал с итогами -->
                            <div class="am-footer-row">
                                <span class="am-footer-badge count">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="8" y1="6" x2="21" y2="6" />
                                        <line x1="8" y1="12" x2="21" y2="12" />
                                        <line x1="8" y1="18" x2="21" y2="18" />
                                        <line x1="3" y1="6" x2="3.01" y2="6" />
                                        <line x1="3" y1="12" x2="3.01" y2="12" />
                                        <line x1="3" y1="18" x2="3.01" y2="18" />
                                    </svg>
                                    Сообщений: @Model.Count()
                                </span>
                            </div>
                        }
                        else
                        {
                            <!-- Пустое состояние -->
                            <div class="am-empty">
                                <svg class="am-empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                    <polyline points="14 2 14 8 20 8" />
                                    <line x1="9" y1="13" x2="15" y2="13" />
                                </svg>
                                <p class="am-empty-text">Переписка с заказчиком отсутствует</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>