    $("form#files3").submit(function () {
        let formData = new FormData(files3);
        event.preventDefault();
        function setProgress(e) {
            if (e.lengthComputable) {
                $("#container_progress").removeAttr('style');
                var complete = e.loaded / e.total;
                var completeFloor = Math.floor(complete * 100)
                $("#pBar").attr('style', `width:${completeFloor}%`);
                $("#pBar").text(`${completeFloor}%`);
            }
        }

        $.ajax({
            xhr: function () {
                var xhr = new window.XMLHttpRequest();
                xhr.upload.addEventListener("progress", setProgress, false);
                xhr.addEventListener("progress", setProgress, false);
                return xhr;
            },
            type: 'POST',
            url: '@Url.Action("DownloadFile", "Parse")',
            data: formData,
            success: function (data) {
                let path = data;
                let typeName = $('#typeDrawId').val();
                let contractId = $('#contractId').val();
                let buildingsCodeId = $('#buildingsCodeId').val();

                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("UpdateByLaborCost", "Estimate")',
                    data: { path: path, type: typeName, contractId: contractId, buildingsCode: buildingsCodeId },
                    success: function (data) {
                        showResultMessage("#result", `<div class="alert alert-success" role="alert"><span><h3>${data}</h3></span></div>`);
                        $.ajax({
                            type: 'GET',
                            url: '@Url.Action("RedirectToView", "Estimate")',
                            data: { path: path, type: typeName, contractId: contractId, updateByType: 'contractCost', buildingsCode: buildingsCodeId },
                            success: function (viewData) {
                                $("#divForm").html(viewData);
                                $("#HeaderLabel").text("Загрузка расчета стоимости/ведомости объемов работ");
                                GoNextStep();

                                $.ajax({
                                    type: 'GET',
                                    url: '@Url.Action("GetEstimateDoneSmrCost", "Estimate")',
                                    data: { EstimateId: estimateId, type: typeName },
                                    success: function (viewData) {
                                        $("#divForm").html(viewData);
                                        $("#ListOfSheet").html("");
                                        $("#HeaderLabel").text("Загрузка акта формы С-2б")
                                    },
                                    error: function (error) {
                                        handleError(error, '@Url.Action("ShowError", "Parse")')
                                    },
                                });
                            },
                            error: function (error) {
                                handleError(error, '@Url.Action("ShowError", "Parse")')
                            },
                        });

                    },
                    error: function (error) {
                        handleError(error, '@Url.Action("ShowError", "Parse")')
                    },
                });
                $("#container_progress").attr('style', `display:none`);
            },
            error: function (error) {
                handleError(error, '@Url.Action("ShowError", "Parse")', "#container_progress")
            },
            contentType: false,
            processData: false
        });
    });
</script>