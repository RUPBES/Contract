@using BusinessLayer.Enums
@inject BusinessLayer.Interfaces.CommonInterfaces.IConverter Converter
@model string
@{
    ViewData["Title"] = ViewBag?.IsUpdate != true ? "Выберите программный комплекс, из которого выгружены данные" : "Выберите программный комплекс и название документа Excel, для обновления данных";
    var action = ViewBag?.IsUpdate != true ? "Create" : "Update";
    int backId = 0;
    if (ViewBag.returnContractId == 0)
        backId = ViewBag.contractId;
    else backId = ViewBag.returnContractId;
    var contid = ViewBag.contractId;
}
<style>
    .form_select {
        display: flex;
        flex-direction: column;
    }

    .btn {
        margin-left: 72%;
    }
</style>

<div class="dm-overlay">
    <div class="dm-table">
        <div class="dm-cell">
            <div class="dm-modal" style="max-width:670px;">
                <div class="top-modal-block">
                    <label class="my-modal-title">@ViewData["Title"]</label>
                    @if (backId != null && backId > 0)
                    {
                        <a asp-controller="Estimate" asp-action="Index" asp-route-contractId="@backId" class="close-btn"></a>
                    }
                    @if (backId == null || backId == 0)
                    {
                        <a asp-controller="Contracts" asp-action="" class="close-btn"></a>
                    }
                </div>
                <hr class="modal-line" />
                <form asp-action="@action" method="get" class="row">
                    <div>
                        <input id="contractId" name="contractId" value="@ViewBag.contractId" hidden />
                        <input name="returnContractId" value="@ViewBag.returnContractId" hidden />
                        <input name="isChange" value="@ViewBag.IsChange" hidden />
                        <input name="estimateId" value="@ViewBag.EstimateId" hidden />
                        <input name="isUpdate" id="isUpdateId" value="@ViewBag.IsUpdate" hidden />
                        <select name="type" class="form-select" id="selectTypeId">
                            @foreach (var item in Enum.GetValues<EstimateType>())
                            {
                                <option value="@item.ToString()">
                                    <span>
                                        @Converter?.GetTypeOfEstimateApp((int)item)
                                    </span>
                                </option>
                            }
                        </select>
                        @if (ViewBag?.IsUpdate == true)
                        {
                            <select name="updateByType" id="updateByTypeId" class="form-select mt-4">
                                <option selected value="laborCost"><span>Расчет стоимости / Ведомость объемов работ</span></option>
                                <option value="contractCost"><span>График производства работ</span></option>
                                <option value="doneSMR"><span>Акт С-2Б</span></option>
                            </select>
                        }
                        @if (ViewBag?.IsUpdate == true)
                        {
                            <select name="BuildingsCode" id="selectBildingsCODE" class="form-select mt-4">
                                <option value="doneSMR"><span>Выбрать код объекта</span></option>
                            </select>
                        }
                    </div>
                    <div>
                        <button class="mt-3 btn btn-primary" style="margin-left: 0px;" type="submit">Выбрать</button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {            
            $.ajax({
                type: 'POST',
                url: '@Url.Action("GetEstimatesByContractId", "Estimate")',
                dataType: 'json',
                data: { contractId: $("#contractId").val() },
                success: function (estimate) {
                   
                    if (estimate.length == 0)
                        return;
                    $.each(estimate, function (r, emp) {
                        $("#selectBildingsCODE").append('<option value="' + emp.code + '">' + emp.code + '</option>');
                    });
                },
                error: function (ex) {
                    alert('Ошибка загрузки данных');
                }
            });

        });

    </script>
}