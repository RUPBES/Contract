@using BusinessLayer.Models
@using BusinessLayer.Models.PRO
@using MvcLayer.Models
@inject BusinessLayer.Interfaces.ContractInterfaces.PRO.IKindOfWorkService KindOfWork
@inject BusinessLayer.Interfaces.ContractInterfaces.PRO.IAbbreviationKindOfWorkService AbbrKindOfWork
@model IndexViewModel
@{
    int backId = 0;
    int contractId = ViewBag.ContractId ?? 0;
    var isWrite = false;
    if (contractId == 0)
    {
        backId = contractId;
    }
    else
    {
        backId = (int)ViewData["returnContractId"];
    }
    Dictionary<string, EstimateCostResultModel> totalSumObj = ViewBag.TotalSumObject;
}

