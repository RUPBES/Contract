                                        @*
                            isWrite = true;
                            <input class="form-control" name="SearchString[Шифр здания]"  id="inputGroupSearch01" />

                            break;*@

                                        isWrite = true;
                                        <select name="SearchString[Шифр здания]" id="inputGroupSearch01">
