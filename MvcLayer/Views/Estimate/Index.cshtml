    <div class="header-view">
        <h1 class="list_agreement">Реестр полученной ПСД по договору №@ViewData["contractNumber"]</h1>
        <form asp-action="Index"
              asp-controller="Estimate"
              asp-route-contractId="@contractId" style="display: flex;"
              asp-route-returnContractId="@ViewData["returnContractId"]">
            <input id="contrctId" value="@contractId" hidden />

            <div class="modal fade" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h3 class="modal-title">Поиск:</h3>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="form-label">
                            <div class="input-group mb-3">
                                <label class="input-group-text" for="inputGroupSearch01">Шифр здания</label>
                                @foreach (KeyValuePair<string, string> item in ViewBag.CurrentSearchString)
                                {
                                    if (item.Key == "Шифр здания")
                                    {
                                        isWrite = true;
                                        <input class="form-control" name="SearchString[Шифр здания]" id="inputGroupSearch01" />
                                        break;

                                        isWrite = true;
                                        <select name="SearchString[Шифр здания]" id="inputGroupSearch02">
                                            <option value="@item.Value" selected>@item.Value</option>
                                        </select>
                                    }
                                }
                                @if (!isWrite)
                                {
                                    <input class="form-control" name="SearchString[Шифр здания]" value="" id="inputGroupSearch01" />
                                    <select name="SearchString[Шифр здания]" id="inputGroupSearch02">
                                        <option value="" selected disabled></option>
                                    </select>
                                }
                                else
                                {
                                    isWrite = false;
                                }
                            </div>
                            <div class="input-group mb-3">

                                <label class="input-group-text" for="inputGroupSearch03">Подрядчик</label>
                                @foreach (KeyValuePair<string, string> item in ViewBag.CurrentSearchString)
                                {
                                    if (item.Key == "Подрядчик")
                                    {
                                        isWrite = true;
                                        <input class="form-control" name="SearchString[Подрядчик]" value="@item.Value" id="inputGroupSearch03" />
                                        break;
                                    }
                                }
                                @if (!isWrite)
                                {
                                    <input class="form-control" name="SearchString[Подрядчик]" value="" id="inputGroupSearch03" />
                                }
                                else
                                {
                                    isWrite = false;
                                }
                            </div>
                            <div class="input-group mb-3">

                                <label class="input-group-text" for="StartPeriodDrawing">Начало периода получения чертежа</label>
                                @foreach (KeyValuePair<string, string> item in ViewBag.CurrentSearchString)
                                {
                                    if (item.Key == "Начало периода получения чертежа")
                                    {
                                        isWrite = true;
                                        <input class="form-control" name="SearchString[Начало периода получения чертежа]" id="StartPeriodDrawing" value="@item.Value" />
                                        break;
                                    }
                                }
                                @if (!isWrite)
                                {
                                    <input class="form-control" name="SearchString[Начало периода получения чертежа]" id="StartPeriodDrawing" value="" />
                                }
                                else
                                {
                                    isWrite = false;
                                }
                            </div>
                            <div class="input-group mb-3">

                                <label class="input-group-text" for="EndPeriodDrawing">Конец периода получения чертежа</label>
                                @foreach (KeyValuePair<string, string> item in ViewBag.CurrentSearchString)
                                {
                                    if (item.Key == "Конец периода получения чертежа")
                                    {
                                        isWrite = true;
                                        <input class="form-control" name="SearchString[Конец периода получения чертежа]" id="EndPeriodDrawing" value="@item.Value" />
                                        break;
                                    }
                                }
                                @if (!isWrite)
                                {
                                    <input class="form-control" name="SearchString[Конец периода получения чертежа]" id="EndPeriodDrawing" value="" />
                                }
                                else
                                {
                                    isWrite = false;
                                }
                            </div>
                            <div class="input-group mb-3">

                                <label class="input-group-text" for="StartPeriodEstimate">Начало периода получения сметы</label>
                                @foreach (KeyValuePair<string, string> item in ViewBag.CurrentSearchString)
                                {
                                    if (item.Key == "Начало периода получения сметы")
                                    {
                                        isWrite = true;
                                        <input class="form-control" name="SearchString[Начало периода получения сметы]" id="StartPeriodEstimate" value="@item.Value" />
                                        break;
                                    }
                                }
                                @if (!isWrite)
                                {
                                    <input class="form-control" name="SearchString[Начало периода получения сметы]" id="StartPeriodEstimate" value="" />
                                }
                                else
                                {
                                    isWrite = false;
                                }
                            </div>
                            <div class="input-group mb-3">

                                <label class="input-group-text" for="EndPeriodEstimate">Конец периода получения сметы</label>
                                @foreach (KeyValuePair<string, string> item in ViewBag.CurrentSearchString)
                                {
                                    if (item.Key == "Конец периода получения сметы")
                                    {
                                        isWrite = true;
                                        <input class="form-control" name="SearchString[Конец периода получения сметы]" id="EndPeriodEstimate" value="@item.Value" />
                                        break;
                                    }
                                }
                                @if (!isWrite)
                                {
                                    <input class="form-control" name="SearchString[Конец периода получения сметы]" id="EndPeriodEstimate" value="" />
                                }
                                else
                                {
                                    isWrite = false;
                                }
                            </div>
                            <div class="input-group mb-3">

                                <label class="input-group-text" for="letterIndex">Буквенный индекс чертежей</label>
                                @foreach (KeyValuePair<string, List<int>> item in ViewBag.CurrentListSearchString)
                                {
                                    if (item.Key == "Буквенный индекс чертежей")
                                    {
                                        isWrite = true;
                                        <select class="js-chosen" multiple name="ListSearchString[Буквенный индекс чертежей]" id="letterIndex">
                                            @foreach (var itemAbr in AbbrKindOfWork.GetAll())
                                            {
                                                var IsGet = false;
                                                foreach (var value in item.Value)
                                                {
                                                    if (itemAbr.Id == value)
                                                    {
                                                        IsGet = true;
                                                        <option value="@itemAbr.Id" selected>@itemAbr.Name</option>
                                                        break;
                                                    }
                                                }
                                                if (!IsGet)
                                                {
                                                    <option value="@itemAbr.Id">@itemAbr.Name</option>
                                                }
                                            }
                                        </select>
                                    }
                                }
                                @if (!isWrite)
                                {
                                    <select class="js-chosen" multiple name="ListSearchString[Буквенный индекс чертежей]" id="letterIndex">
                                        @foreach (var itemAbr in AbbrKindOfWork.GetAll())
                                        {
                                            <option value="@itemAbr.Id">@itemAbr.Name</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    isWrite = false;
                                }
                            </div>
                            <div class="input-group mb-3">

                                <label class="input-group-text" for="kindOfWork">Вид работы</label>
                                @{
                                    isWrite = false;
                                }
                                @foreach (KeyValuePair<string, List<int>> item in ViewBag.CurrentListSearchString)
                                {
                                    if (item.Key == "Вид работы")
                                    {
                                        isWrite = true;
                                        <select class="js-chosen" multiple id="kindOfWork" name="ListSearchString[Вид работы]">

                                            @foreach (var itemAbr in KindOfWork.GetAll())
                                            {
                                                var IsGet = false;
                                                foreach (var value in item.Value)
                                                {
                                                    if (itemAbr.Id == value)
                                                    {
                                                        IsGet = true;
                                                        <option value="@itemAbr.Id" selected>@itemAbr.name</option>
                                                        break;
                                                    }
                                                }
                                                if (!IsGet)
                                                {
                                                    <option value="@itemAbr.Id">@itemAbr.name</option>
                                                }
                                            }
                                        </select>
                                    }
                                }
                                @if (!isWrite)
                                {
                                    <select class="js-chosen" multiple id="kindOfWork" name="ListSearchString[Вид работы]">
                                        @foreach (var itemAbr in KindOfWork.GetAll())
                                        {
                                            <option value="@itemAbr.Id">@itemAbr.name</option>
                                        }
                                    </select>
                                }
                            </div>

                        </div>
                        <div class="modal-footer">
                            <button type="reset" class="btn btn-warning">Очистить фильтр</button>
                            <button class="btn btn-primary" type="submit" title="Поиск организации" alt="Поиск организации">Поиск</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="box-btn">
                <button class="btn btn-ctr btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#staticBackdrop">
                    <div>Поиск</div>
                </button>
            </div>
            @*UPDATE DATAs*@
            <div class="box-btn">
                <a class="btn btn-ctr btn-primary"
                   asp-action="GetType"
                   asp-controller="Estimate"
                   asp-route-contractId="@contractId"
                   asp-route-isUpdate="true"
                   asp-route-returnContractId="@ViewData["returnContractId"]">
                    <img class="icon" src="~/icons/update.svg" />
                    <div>Обновить данные</div>
                </a>
            </div>

            @*CREATE DATA*@
            <div class="box-btn">
                <a class="btn btn-ctr btn-success"
                   asp-action="GetType"
                   asp-controller="Estimate"
                   asp-route-contractId="@contractId"
                   asp-route-returnContractId="@ViewData["returnContractId"]">
                    <img class="icon" src="~/icons/plus-circle.svg" />
                    <div>Добавить данные</div>
                </a>
            </div>
        </form>
    </div>
    <div class="full-width">
        <table class="table table-main table-main-short table-bordered table-hover table-condensed search-table-db" id="dataTable">
            <thead>
                <tr>
                    <th data-filter="bCode">
                        <div>Шифр здания, сооружения</div>
                        <div class="filter-btn icon filter" data-column="department"></div>
                    </th>
                    <th data-filter="bName">
                        <div>Наименование здания, сооружения</div>
                        <div class="filter-btn icon filter" data-column="employee"></div>
                    </th>
                    <th data-filter="drwKit">
                        Комплект чертежей
                        @* <button class="filter-btn" data-column="metric">☰</button> *@
                    </th>
                    <th data-filter="drwName">
                        Наименование чертежа
                        @* <button class="filter-btn" data-column="value">☰</button> *@
                    </th>
                    <th data-filter="drwDate">
                        Дата получения чертежа
                    </th>
                    <th data-filter="drwChDate">
                        Дата получения изменения чертежа
                    </th>
                    <th data-filter="number">
                        Номер сметы
                    </th>
                    <th data-filter="estDate">
                        Дата получения сметы
                    </th>
                    <th>
                        Дата получения изменения сметы
                    </th>
                    <th>
                        Стоимость по договору, руб.
                    </th>
                    <th>
                        Трудозатраты, чел/час
                    </th>
                    <th>
                        Выполнено СМР, руб.
                    </th>
                    <th>
                        Процент выполнения, %
                    </th>
                    <th>
                        Остаток СМР, руб.
                    </th>
                    <th>
                        Подрядчик
                    </th>
                    <th>
                        Дейсвия
                    </th>
                </tr>
            </thead>
            <tbody class="table_tbody">
                @*
            ** отрисовка по объектам, всех смет **
            *@
                @foreach (EstimateViewModel estimateViewModel in Model.Objects)
                {
                    @*
            ** отрисовка по сметам      **
            *@
                    @foreach (EstimateItem estimate in estimateViewModel?.Estimates)
                    {
                        var classes = estimate.ChangeEstimateId.HasValue ? "toggle-sub-rows" : null;

                        <tr class="@classes" data-est="@estimate.Id">
                            @if (estimateViewModel?.Estimates[0] == estimate)
                            {
                                int rowspanCount = estimateViewModel?.Estimates?.Count() ?? 0;
                                <td rowspan="@rowspanCount" class="text-center align-middle common-col">
                                    @estimateViewModel.BuildingCode
                                    @*         TODO: ПЕРЕСМОТРЕТЬ ВСЕ ССЫЛКИ !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!*@
                                    <div class="icon file-store" title="Файлы">
                                        <a asp-action="ShowFiles"
                                           asp-route-contractId="@contractId"
                                           asp-route-buildingCode="@estimateViewModel.BuildingCode">
                                        </a>
                                    </div>
                                </td>
                                <td rowspan="@rowspanCount" class="text-center align-middle common-col">
                                    @estimateViewModel.Estimates?.FirstOrDefault()?.BuildingName
                                </td>
                            }
                            <td>
                                @estimate?.DrawingsKit
                            </td>
                            <td>
                                @estimate?.DrawingsName
                            </td>
                            <td class="text-center align-middle">
                                @if (estimate?.DrawingsDate != default)
                                {
                                    @estimate?.DrawingsDate?.ToShortDateString()
                                    //.ToString("dd MMMM yyyy")

                                    <div class="icon file-add" title="Добавить изменения по смете">
                                        <a asp-action="GetType"
                                           asp-route-contractId="@contractId"
                                           asp-route-isChange=true
                                           asp-route-estimateId="@estimate?.Id">
                                        </a>
                                    </div>
                                }
                            </td>
                            <td class="text-center align-middle">
                                @estimate?.ChangeDrawingDate?.ToShortDateString()
                            </td>
                            <td class="text-center align-middle">
                                @estimate?.Number
                            </td>
                            <td class="text-center align-middle">
                                @estimate?.EstimateDate?.ToShortDateString() @* //?.ToString("dd MMMM yyyy")*@

                            </td>
                            <td class="text-center align-middle">
                                @estimate?.ChangeEstimateDate?.ToShortDateString()
                            </td>
                            <td class="text-end align-middle">
                                @estimate?.ContractsCost?.ToString("N2")
                            </td>
                            <td class="text-end align-middle">
                                @estimate?.LaborCost?.ToString("N2")
                            </td>
                            <td class="text-end align-middle">
                                @estimate?.DoneSmrCost?.ToString("N2")
                            </td>
                            <td class="text-end align-middle">
                                @estimate?.PercentOfContrPrice?.ToString("N2")
                            </td>
                            <td class="text-end align-middle">
                                @estimate?.RemainsSmrCost?.ToString("N2")
                            </td>
                            <td class="text-center align-middle">
                                @estimate?.SubContractor
                            </td>
                            @*
                * Действия по смете
                *
                *@
                            <td>
                                <div class="icon edit" title="Редактировать смету">
                                    <a asp-action="Edit" asp-route-id="@estimate?.Id"
                                       asp-route-contractId="@contractId"
                                       asp-route-returnContractId="@ViewData["returnContractId"]"></a>
                                </div>
                                <div class="icon file-store" title="Просмотр файлов">
                                    <a asp-action="ShowFiles" asp-route-estimateId="@estimate?.Id"
                                       asp-route-contractId="@contractId"
                                       asp-route-buildingCode="@estimateViewModel.BuildingCode"
                                       asp-route-estimateNumber="@estimate?.Number"
                                       asp-route-isDrawing="false">
                                    </a>
                                </div>
                                <div class="icon drawing-add" title="Добавить чертежи">
                                    <a asp-action="AddDrawings"
                                       asp-route-id="@estimate?.Id"
                                       asp-route-contractId="@contractId"
                                       asp-route-returnContractId="@ViewData["returnContractId"]">
                                    </a>
                                </div>
                                <div class="icon delete" title="Удалить запись">
                                    <a asp-action="Delete"
                                       asp-controller="Estimate"
                                       asp-route-id="@estimate?.Id"
                                       asp-route-contractId="@contractId"
                                       class="modal-link"
                                       data-message="Смета и прикрепленные файлы будут удалены. Продолжить?">
                                    </a>
                                </div>
                            </td>
                        </tr>

                    }
                    @*
            ** отрисовка итоговых стоимостей (согласно видам работ) по сметам   **
            *@
                    <tr class="summary-row">
                        <td class="text-end" colspan="9">
                            Итого по зданию, сооружению:
                        </td>
                        <td class="text-end align-middle">
                            @estimateViewModel?.CostResults["totalSum"].ContractsCost?.ToString("N2")
                        </td>
                        <td class="text-end align-middle">
                            @estimateViewModel?.CostResults["totalSum"].LaborCost?.ToString("N2")
                        </td>
                        <td class="text-end align-middle">
                            @estimateViewModel?.CostResults["totalSum"].DoneSmrCost?.ToString("N2")
                        </td>
                        <td class="text-end align-middle">
                            @estimateViewModel?.CostResults["totalSum"].PercentOfContrPrice?.ToString("N2")
                        </td>
                        <td class="text-end align-middle">
                            @estimateViewModel?.CostResults["totalSum"].RemainsSmrCost?.ToString("N2")
                        </td>
                        <td colspan="2">
                        </td>
                    </tr>
                    <tr class="summary-row">
                        <td class="text-end" colspan="9">
                            в том числе:
                        </td>
                        <td colspan="7">
                        </td>
                    </tr>
                    foreach (var result in @estimateViewModel?.CostResults.Where(x => x.Key != "totalSum"))
                    {
                        <tr class="summary-row">
                            <td class="text-end" colspan="9">
                                @result.Key
                            </td>
                            <td class="text-end align-middle">
                                @result.Value?.ContractsCost?.ToString("N2")
                            </td>
                            <td class="text-end align-middle">
                                @result.Value?.LaborCost?.ToString("N2")
                            </td>
                            <td class="text-end align-middle">
                                @result.Value?.DoneSmrCost?.ToString("N2")
                            </td>
                            <td class="text-end align-middle">
                                @result.Value?.PercentOfContrPrice?.ToString("N2")
                            </td>
                            <td class="text-end align-middle">
                                @result.Value?.RemainsSmrCost?.ToString("N2")
                            </td>
                            <td colspan="2">
                            </td>
                        </tr>
                    }

                    <tr class="summary-row">
                        <td colspan="16" style="background-color:white;">
                        </td>
                    </tr>
                }
                @*
            ** отрисовка итоговых стоимостей (согласно видам работ) по ОБЪЕКТУ       **
            *@
                <tr class="summary-row-total">
                    <td colspan="16">
                    </td>
                </tr>
                <tr class="summary-row-total">
                    <td class="text-end" colspan="9">
                        ВСЕГО по объекту:
                    </td>
                    <td class="text-end align-middle">
                        @totalSumObj["totalSum"].ContractsCost?.ToString("N2")
                    </td>
                    <td class="text-end align-middle">
                        @totalSumObj["totalSum"].LaborCost?.ToString("N2")
                    </td>
                    <td class="text-end align-middle">
                        @totalSumObj["totalSum"].DoneSmrCost?.ToString("N2")
                    </td>
                    <td class="text-end align-middle">
                        @totalSumObj["totalSum"].PercentOfContrPrice?.ToString("N2")
                    </td>
                    <td class="text-end align-middle">
                        @totalSumObj["totalSum"].RemainsSmrCost?.ToString("N2")
                    </td>
                    <td colspan="2"></td>
                </tr>
                <tr class="summary-row-total">
                    <td class="text-end" colspan="9">
                        в том числе:
                    </td>
                    <td colspan="7">
                    </td>
                </tr>
                @foreach (var item in totalSumObj.Where(x => x.Key != "totalSum"))
                {
                    <tr class="summary-row-total">
                        <td class="text-end" colspan="9">
                            @item.Key
                        </td>
                        <td class="text-end align-middle">
                            @item.Value.ContractsCost?.ToString("N2")
                        </td>
                        <td class="text-end align-middle">
                            @item.Value.LaborCost?.ToString("N2")
                        </td>
                        <td class="text-end align-middle">
                            @item.Value.DoneSmrCost?.ToString("N2")
                        </td>
                        <td class="text-end align-middle">
                            @item.Value.PercentOfContrPrice?.ToString("N2")
                        </td>
                        <td class="text-end align-middle">
                            @item.Value.RemainsSmrCost?.ToString("N2")
                        </td>
                        <td colspan="2">
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div id="filterModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Фильтр</h2>
                <span class="close">&times;</span>
            </div>
            <div class="modal-body">
                <div class="filter-search">
                    <input type="text" id="filterSearch" placeholder="Поиск...">
                </div>
                <div id="filterCheckboxes"></div>
            </div>
            <div class="modal-footer">
                <button id="selectAll">Выбрать все</button>
                <button id="clearAll">Очистить все</button>
                <button id="applyFilter">Применить</button>
                <button id="cancelFilter">Отмена</button>
            </div>
        </div>
    </div>
}

@section Scripts {

    <script>
        // Инициализация datepicker для полей дат чертежей и смет
        // Настраивает формат даты как "день месяц год" на русском языке
        // Показывает номера недель, автоматически закрывается при выборе
        // Отключает навигацию с клавиатуры, включает предположение ближайшего года
        // Позволяет переключать активное состояние
        $("#StartPeriodDrawing, #EndPeriodDrawing, #StartPeriodEstimate, #EndPeriodEstimate").datepicker({
            format: "d MM yyyy",
            language: "ru",
            calendarWeeks: true,
            autoclose: true,
            keyboardNavigation: false,
            assumeNearbyYear: true,
            toggleActive: true
        });

        // document.querySelectorAll(`.search-table-db>thead>tr>[data-filter]`).forEach((e) => {
        //     e.addEventListener('click', function () {
        //         $.ajax({
        //             type: 'POST',
        //             url: '@Url.Action("GetListData", "Estimate")',
        //             dataType: 'json',
        //             data: { contractId: $("#contrctId").val(), attName: "test1" },
        //             success: function (estimate) {
        //                 let ssa = estimate;
        //                 //if (estimate.length == 0)
        //                 //    return;
        //                 //$.each(estimate, function (r, emp) {
        //                 //    $("#inputGroupSearch01").append('<option value="' + emp.code + '">' + emp.code + '</option>');
        //                 //});
        //             },
        //             error: function (ex) {
        //                 alert('Ошибка загрузки данных');
        //             }
        //         });
        //     });
        // })

        let list = [];

        const onClickOpen = function () {
            const target = event.target;
            let parentROW = target.parentElement;
            let estId;
            ///если кликнули по ячейке, то data-set берем у родителя - строка TR
            /// усли по строке TR - то ее data-set берем

            if (target.tagName === 'TD') {
                estId = parentROW.dataset.est;
            } else {
                estId = target.dataset.est;
            }

            if (!parentROW.firstElementChild.classList.contains('common-col')) {
                ///ищем строку, которая содержит два первых, общих для всех строк, столбца
                while (parentROW && parentROW.previousElementSibling) {
                    if (parentROW.previousElementSibling.firstElementChild.classList.contains('common-col')) {
                        parentROW = parentROW.previousElementSibling;
                        break;
                    }
                    parentROW = parentROW.previousElementSibling;
                }
            }

            const firstROW = parentROW.firstElementChild;
            const secondROW = firstROW.nextElementSibling;
            const rowspans = firstROW.getAttribute("rowspan");

            ////////////
            ///
            ///

            $.ajax({
                type: 'POST',
                url: '@Url.Action("GetListChangedEstimate", "Estimate")',
                dataType: 'json',
                data: { contractId: $("#contrctId").val(), estId: estId },
                success: function (estimates) {
                    if (estimates.length == 0) return;
                    estimates = estimates.sort(function (a, b) { return b.id > a.id });
                    $.each(estimates, function (r, estimate) {
                        const newTR = document.createElement("tr");
                        newTR.className = 'sub-row text-center align-middle';

                        // for (let index = 0; index < 14; index++) {
                        const newTD1 = document.createElement("td");
                        newTD1.innerText = estimate.drawingsKit;
                        newTR.appendChild(newTD1);

                        const newTD2 = document.createElement("td");
                        newTD2.innerText = estimate.drawingsName;
                        newTR.appendChild(newTD2);

                        const newTD3 = document.createElement("td");
                        newTD3.innerText = estimate.drawingsDate;
                        newTR.appendChild(newTD3);

                        const newTD4 = document.createElement("td");
                        newTD4.innerText = estimate.changeDrawingDate;
                        newTR.appendChild(newTD4);

                        const newTD5 = document.createElement("td");
                        newTD5.innerText = estimate.number;
                        newTR.appendChild(newTD5);

                        const newTD6 = document.createElement("td");
                        newTD6.innerText = estimate.estimateDate;
                        newTR.appendChild(newTD6);

                        const newTD7 = document.createElement("td");
                        newTD7.innerText = estimate.changeEstimateDate;
                        newTR.appendChild(newTD7);

                        const newTD8 = document.createElement("td");
                        newTD8.innerText = estimate.contractsCost;
                        newTR.appendChild(newTD8);

                        const newTD9 = document.createElement("td");
                        newTD9.innerText = estimate.laborCost;
                        newTR.appendChild(newTD9);

                        const newTD10 = document.createElement("td");
                        newTD10.innerText = estimate.doneSmrCost;
                        newTR.appendChild(newTD10);

                        const newTD11 = document.createElement("td");
                        newTD11.innerText = estimate.percentOfContrPrice;
                        newTR.appendChild(newTD11);

                        const newTD12 = document.createElement("td");
                        newTD12.innerText = estimate.remainsSmrCost;
                        newTR.appendChild(newTD12);

                        const newTD13 = document.createElement("td");
                        newTD13.innerText = estimate.subContractor;
                        newTR.appendChild(newTD13);

                        const newTD14 = document.createElement("td");
                        newTD14.innerText = '';
                        newTR.appendChild(newTD14);

                        target.parentElement.after(newTR);
                    });

                    target.parentElement.removeEventListener('click', onClickOpen);
                    target.parentElement.addEventListener('click', onClickClose);

                    firstROW.setAttribute("rowspan", +rowspans + estimates.length);
                    secondROW.setAttribute("rowspan", +rowspans + estimates.length);
                },
                error: function (ex) {
                    alert('Ошибка загрузки данных');
                }
            });



        };
        const onClickClose = function () {
            const target = event.target;
            let parentROW = target.parentElement;
            if (!parentROW.firstElementChild.classList.contains('common-col')) {
                ///ищем строку, которая содержит два первых, общих для всех строк, столбца
                while (parentROW) {
                    if (parentROW?.previousElementSibling.firstElementChild.classList.contains('common-col')) {
                        parentROW = parentROW?.previousElementSibling;
                        break;
                    }
                    parentROW = parentROW?.previousElementSibling;
                }
            }
            const firstROW = parentROW.firstElementChild;
            const secondROW = firstROW.nextElementSibling;

            const rowspans = firstROW.getAttribute("rowspan");
            let countRemoveSpanRow = 0;

            //если
            while (event.target) {
                if (event.target.parentElement.nextElementSibling.classList.contains('sub-row')) {
                    event.target.parentElement.nextElementSibling.remove();
                    countRemoveSpanRow++;
                } else {
                    break;
                }
            }

            firstROW.setAttribute("rowspan", +rowspans - countRemoveSpanRow);
            secondROW.setAttribute("rowspan", +rowspans - countRemoveSpanRow);

            ////////////
            ///
            ///
            target.parentElement.removeEventListener('click', onClickClose);
            target.parentElement.addEventListener('click', onClickOpen);
        };
        function onClickRow() {
            document.querySelectorAll(".toggle-sub-rows")?.forEach((value) => {
                value.addEventListener("click", onClickOpen);
            });
        };

        onClickRow();

        $(document).ready(function () {
            $.ajax({
                type: 'POST',
                url: '@Url.Action("GetEstimatesByContractId", "Estimate")',
                dataType: 'json',
                data: { contractId: $("#contrctId").val() },
                success: function (estimate) {

                    if (estimate.length == 0)
                        return;
                    $.each(estimate, function (r, emp) {
                        $("#inputGroupSearch02").append('<option value="' + emp.code + '">' + emp.code + '</option>');
                    });
                },
                error: function (ex) {
                    alert('Ошибка загрузки данных');
                }
            });
        });
    </script>

    @* <script src="~/js/filterTableData.js"></script> *@
}