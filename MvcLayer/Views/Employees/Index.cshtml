@model BusinessLayer.Models.IndexViewModel
@inject BusinessLayer.Interfaces.ContractInterfaces.IEmployeeService Employee
@inject BusinessLayer.Interfaces.ContractInterfaces.IDepartmentService Department
@inject BusinessLayer.Interfaces.ContractInterfaces.IOrganizationService Organization
@inject BusinessLayer.Interfaces.ContractInterfaces.IPhoneService Phone
@using BusinessLayer.Models;
@inject BusinessLayer.Interfaces.CommonInterfaces.IHttpHelper HttpHelper


@{
    var permissions = HttpHelper.GetUserPermissions();
    ViewData["Title"] = "Cотрудники";
}
<style>    
    .input-group_flex {
        justify-content: right;
    }
    .up::after {
        content: "▲";
        margin-left: 5px;
    }

    .down::after {
        content: "▼";
        margin-left: 5px;
    }
</style>
<div class="dm-overlay">
    <div class="dm-table">
        <div class="dm-cell">
            <div class="dm-modal">
                <div class="top-modal-block flex-column">
                    <div class="input-group m-2">
                        <span class="my-modal-title m-auto">@ViewData["Title"]</span>
                        <a asp-controller="Home" asp-action="" class="close-btn"></a>
                    </div>
                    <div class="input-group m-2 input-group_flex">
                        <div class="nav_panel_btns">
                            <div class="link_add_emp"></div>
                            <div class="btn_panel_search">
                                <form asp-controller="Employees" asp-action="Index" style="search-form" method="get">
                                    <input class="btn-ctr" type="text" name="searchString" placeholder="Поиск по ФИО" value="@ViewData["CurrentFilter"]" />
                                    <button type="submit" class="subSearch"><img src="~/icons/search.svg" title="Поиск сотрудника" alt="Поиск сотрудника" /></button>
                                </form>
                                @if (permissions is not null && permissions.IsCreator)
                                {
                                    <button type="button" class="btn btn-success btn-ctr" onclick="location.href='@Url.Action("Create", "Employees")'"><img class="icon" src="~/icons/plus-circle.svg" />Добавить сотрудника</button>
                                }
                            </div>
                        </div>
                    </div>
                    <div style="max-height:500px; overflow-y:scroll">
                        <table class="table table-bordered table-main table-hover">
                            <thead>
                                <tr>
                                    <th>
                                        <span class="column_300">
                                            Фамилия, имя, отчество
                                            @* @Html.ActionLink(" ", "Index", 
                                                new { 
                                                    sortOrder = ViewBag.FullNameSortParm, 
                                                    currentFilter = ViewData["CurrentFilter"],
                                                    pageNum = Model.PageViewModel.PageNumber 
                                                }, 
                                                new { id = "arrayFullName", @class = "up" }) *@
                                        </span>
                                    </th>
                                    <th>
                                        <span class="column_150">
                                            Электронная почта
                                            @* @Html.ActionLink(" ", "Index", 
                                                new { 
                                                    sortOrder = ViewBag.EmailSortParm, 
                                                    currentFilter = ViewData["CurrentFilter"],
                                                    pageNum = Model.PageViewModel.PageNumber 
                                                }, 
                                                new { id = "arrayEmail", @class = "up" }) *@
                                        </span>
                                    </th>
                                    <th>
                                        <span class="column_130">
                                            Телефон
                                        </span>
                                    </th>
                                    <th>
                                        <span class="column_100">
                                            Действие
                                        </span>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (EmployeeDTO item in Model.Objects)
                                {
                                    <tr>
                                        <td>
                                            <span class="column_300">
                                                @Html.DisplayFor(modelItem => item.FullName)
                                            </span>
                                        </td>                                      
                                        <td>
                                            <span class="column_250">
                                                @Html.DisplayFor(modelItem => item.Email)
                                            </span>
                                        </td>
                                        <td>
                                            <span class="column_130">
                                                @foreach (var phone in Phone.Find(x => x.EmployeeId == item.Id))
                                                {
                                                    <span>@phone.Number</span>
                                                }
                                            </span>
                                        </td>
                                        <td>
                                            <div class="d-flex flex-row">
                                                @if (permissions is not null && permissions.IsReader)
                                                {
                                                    <span class="icon info" title="Детальная информация">
                                                        <a asp-action="Details" asp-route-id="@item.Id" asp-route-page="@ViewBag.Page" asp-route-filter="@ViewData["CurrentFilter"]"></a>
                                                    </span>
                                                }
                                                @if (permissions is not null && permissions.IsEditor)
                                                {
                                                    <span class="icon edit" title="Редактировать">
                                                        <a asp-action="Edit" asp-route-id="@item.Id"></a>
                                                    </span>
                                                }
                                                @if (permissions is not null && (permissions.IsDeleter || permissions.IsAdmin))
                                                {
                                                    <span class="icon delete" title="Удалить">
                                                        <a onclick="deleteEmpl(@item.Id)"></a>
                                                    </span>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <nav aria-label="Page navigation example" style="margin-top:10px;">
                        <ul class="pagination justify-content-center">
                            <li class="page-item previous_btn">
                                @{
                                    @if (Model.PageViewModel.PageNumber > 1)
                                    {
                                        <a class="page-link" asp-action="Index"
                                           asp-route-pageNum="@(Model.PageViewModel.PageNumber - 1)"
                                           asp-route-sortOrder="@ViewData["CurrentSort"]"
                                           asp-route-currentFilter="@ViewData["CurrentFilter"]">&lt;</a>
                                    }
                                    @if (Model.PageViewModel.PageNumber <= 1)
                                    {
                                        <a class="page-link" asp-action="Index"
                                           asp-route-pageNum="@(Model.PageViewModel.PageNumber - 1)"
                                           asp-route-sortOrder="@ViewData["CurrentSort"]"
                                           asp-route-currentFilter="@ViewData["CurrentFilter"]"
                                           tabindex="-1" aria-disabled="true">&lt;</a>
                                    }
                                }

                            </li>
                            @{
                                int counter = 1;
                                int index = Model.PageViewModel.PageNumber <= 5 ? 1 : Model.PageViewModel.PageNumber;
                                for (int i = index; i <= Model.PageViewModel.TotalPages; i++)
                                {
                                    <li class="page-item pag_btn_num">
                                        <a class="page-link"
                                           asp-action="Index"
                                           asp-route-pageNum="@i"
                                           asp-route-sortOrder="@ViewData["CurrentSort"]"
                                           asp-route-currentFilter="@ViewData["CurrentFilter"]"
                                           value="@i">@i</a>
                                    </li>
                                    if (counter == 5)
                                    {
                                        counter = 1;
                                        break;
                                    }
                                }
                            }

                            <li class="page-item next_btn">
                                @{
                                    @if (Model.PageViewModel.PageNumber <= Model.PageViewModel.TotalPages)
                                    {
                                        <a class="page-link" asp-action="Index"
                                           asp-route-pageNum="@(Model.PageViewModel.PageNumber + 1)"
                                           asp-route-sortOrder="@ViewData["CurrentSort"]"
                                           asp-route-currentFilter="@ViewData["CurrentFilter"]">&gt;</a>
                                    }
                                    else
                                    {
                                        <a class="page-link" asp-action="Index"
                                           asp-route-pageNum="@(Model.PageViewModel.PageNumber + 1)"
                                           asp-route-sortOrder="@ViewData["CurrentSort"]"
                                           asp-route-currentFilter="@ViewData["CurrentFilter"]"
                                           aria-disabled="true">&gt;</a>
                                    }
                                }
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script type="text/javascript">
        addition_nav_bar();
        ////// Pagination
        paginationFunc(@Model.PageViewModel.PageNumber, @Model.PageViewModel.TotalPages);
        //////ENd pagination
        function deleteEmpl(id) {
            $.ajax({
                type: 'POST',
                url: '@Url.Action("ShowDeleteMessage", "Home")',
                contentType: "application/html; charset=utf-8",
                dataType: 'html',
                success: function (result) {
                    $('#dialogContent').html(result);
                    $('#modDialog').modal({ backdrop: false });
                    $('#modDialog').modal('show');

                    let elementDeleteButton = document.querySelectorAll('#modal-button-delete');
                    elementDeleteButton[0].addEventListener('click', () => {
                        $.ajax({
                            type: 'GET',
                            url: '@Url.Action("Delete", "Employees")',
                            data: { id: id },
                            success: function (result) {
                                window.location.reload();
                            },
                            error: function (result) {
                                window.location.reload();
                            }
                        });
                    });
                },
                error: function (result) {
                    // alert("Ошибка отображения");
                }
            })
        }
        window.onload = function () {
            const actualUrl = window.location.search;
            const elementArrayFullName = document.getElementById("arrayFullName");
            const elementArrayEmail = document.getElementById("arrayEmail");
            
            if (actualUrl.includes('fullNameDesc')) {
                elementArrayFullName.classList.remove("up");
                elementArrayFullName.classList.add("up-down-active", "down");
            }
            else if (actualUrl.includes('fullName')) {
                elementArrayFullName.classList.add("up-down-active");
                elementArrayFullName.classList.add("up");
            }
            
            if (actualUrl.includes('emailDesc')) {
                elementArrayEmail.classList.remove("up");
                elementArrayEmail.classList.add("up-down-active", "down");
            }
            else if (actualUrl.includes('email')) {
                elementArrayEmail.classList.add("up-down-active");
                elementArrayEmail.classList.add("up");
            }
        }
        $(document).ready(function() {
            // Get current sort order from ViewData
            var currentSort = '@ViewData["CurrentSort"]';
            
            // Update sort icons based on current sort
            if (currentSort) {
                if (currentSort.includes('Desc')) {
                    $('#array' + currentSort.replace('Desc', '')).removeClass('up').addClass('down');
                } else {
                    $('#array' + currentSort).removeClass('down').addClass('up');
                }
            }
        });
    </script>
}