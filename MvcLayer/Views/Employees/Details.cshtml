@model MvcLayer.Models.EmployeeViewModel
@inject BusinessLayer.Interfaces.ContractInterfaces.IDepartmentService Department
@inject BusinessLayer.Interfaces.ContractInterfaces.IOrganizationService Organization
@inject BusinessLayer.Interfaces.ContractInterfaces.IPhoneService Phone
@{
    ViewData["Title"] = "Детальная информация";
}
<div class="dm-overlay">
    <div class="dm-table">
        <div class="dm-cell">
            <div class="dm-modal" style="max-width:50%">
                <div class="top-modal-block flex-column">
                    <div class="input-group m-2">
                        <span class="my-modal-title m-auto">@ViewData["Title"]</span>
                        <a asp-controller="Organizations" asp-action="Index" class="close-btn"></a>
                    </div>
                    <hr class="modal-line" />
                    <div>
                        <dl class="row">
                            <dt class="col-sm-3">
                                @Html.DisplayNameFor(model => model.FullName)
                            </dt>
                            <dd class="col-sm-9">
                                @Html.DisplayFor(model => model.FullName)
                            </dd>
                            <dt class="col-sm-3">
                                Организация
                            </dt>
                            <dd class="col-sm-9">
                                @foreach (var department in Model.DepartmentEmployees)
                                {
                                    <span>@Organization.GetById((int)Department.GetById(department.DepartmentId).OrganizationId).Name</span>

                                }

                            </dd>

                            <dt class="col-sm-3">
                                Отдел
                            </dt>
                            <dd class="col-sm-9">
                                @foreach (var department in Model.DepartmentEmployees)
                                {
                                    <span>@Department.GetById(@department.DepartmentId).Name</span>
                                }
                            </dd>
                            <dt class="col-sm-3">
                                @Html.DisplayNameFor(model => model.Position)
                            </dt>
                            <dd class="col-sm-9">
                                @Html.DisplayFor(model => model.Position)
                            </dd>
                            <dt class="col-sm-3">
                                Телефон
                            </dt>
                            <dd class="col-sm-9">
                                @foreach (var phone in Phone.Find(x => x.EmployeeId == Model.Id))
                                {
                                    <span>@phone.Number</span>
                                }
                            </dd>
                            <dt class="col-sm-3">
                                @Html.DisplayNameFor(model => model.Email)
                            </dt>
                            <dd class="col-sm-9">
                                @Html.DisplayFor(model => model.Email)
                            </dd>
                        </dl>
                    </div>
                    <div>
                        <a asp-action="Index" asp-route-page="@ViewBag.Page" asp-route-currentFilter="@ViewBag.Filter">Вернуться назад</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>