        background: var(--md3-surface);
        border: 1px solid var(--md3-outline);
        border-radius: var(--md3-radius-lg);
        box-shadow: var(--md3-shadow-2);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .wizard-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 16px 20px;
        border-bottom: 1px solid var(--md3-outline);
    }

        .wizard-header .dlg-icon {
            background: var(--md3-gen);
        }

    .wizard-title {
        font-size: 15px;
        font-weight: 700;
        flex: 1;
    }

    .wizard-steps {
        display: flex;
        align-items: center;
        padding: 14px 20px 0;
        gap: 0;
    }

    .wstep {
        display: flex;
        align-items: center;
        gap: 8px;
        flex: 1;
    }

        .wstep .num {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: var(--md3-surface-3);
            color: var(--md3-on-surface-low);
            font-size: 12px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: all var(--md3-transition);
        }

        .wstep .lbl {
            font-size: 11.5px;
            font-weight: 600;
            color: var(--md3-on-surface-low);
            white-space: nowrap;
        }

        .wstep .line {
            flex: 1;
            height: 2px;
            background: var(--md3-outline);
            margin: 0 4px;
        }

        .wstep:last-child .line {
            display: none;
        }

        .wstep.active .num {
            background: var(--md3-primary);
            color: #fff;
        }

        .wstep.active .lbl {
            color: var(--md3-primary);
        }

        .wstep.done .num {
            background: var(--md3-gen);
            color: #fff;
        }

        .wstep.done .lbl {
            color: var(--md3-gen);
        }

        .wstep.done .line {
            background: var(--md3-gen);
        }

    .wizard-body {
        padding: 20px;
        overflow-y: auto;
        flex: 1;
    }

    .wpanel {
        display: none;
    }

        .wpanel.active {
            display: block;
        }

    .wcard {
        border: 1px solid var(--md3-outline);
        border-radius: var(--md3-radius-md);
        padding: 16px;
        background: var(--md3-surface-2);
    }

        .wcard h4 {
            margin: 0 0 6px;
            font-size: 13.5px;
        }

        .wcard p {
            margin: 0;
            font-size: 12.5px;
            color: var(--md3-on-surface-med);
            line-height: 1.5;
        }

    .dropzone {
        border: 2px dashed var(--md3-outline-strong);
        border-radius: var(--md3-radius-md);
        padding: 32px 20px;
        text-align: center;
        color: var(--md3-on-surface-med);
        background: var(--md3-surface-2);
        cursor: pointer;
        transition: all var(--md3-transition);
    }

        .dropzone:hover {
            background: var(--md3-primary-light);
            border-color: var(--md3-primary);
        }

        .dropzone .dz-title {
            font-size: 13.5px;
            font-weight: 600;
            margin: 8px 0 3px;
            color: var(--md3-on-surface);
        }

        .dropzone .dz-sub {
            font-size: 11.5px;
            color: var(--md3-on-surface-low);
        }

    .file-picked {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 14px;
        border: 1px solid var(--md3-outline);
        border-radius: var(--md3-radius-md);
        background: var(--md3-gen-light);
        margin-top: 12px;
    }

        .file-picked .msi {
            color: var(--md3-gen);
            font-size: 22px;
        }

        .file-picked .fp-name {
            font-size: 13px;
            font-weight: 600;
            flex: 1;
        }

        .file-picked .fp-remove {
            background: none;
            border: none;
            color: var(--md3-danger);
            cursor: pointer;
            display: flex;
        }

    .wizard-footer {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 20px;
        border-top: 1px solid var(--md3-outline);
    }

        .wizard-footer .spacer {
            flex: 1;
        } */
</style>
<div class="dm-overlay">
    <div class="dm-table">
        <div class="dm-cell">
            <div class="dm-modal">


                @*   {{-- ══ ШАПКА ══ --}} *@
                <div class="org-header" style="border-bottom:1.5px solid var(--md3-outline); gap:10px;">
                    <div class="org-header-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none">
                            <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"
                                  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"
                                  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </div>
                    <div class="org-header-info">
                        <h2 class="org-header-title" id="editOrgTitle"
                            style="font-size:15px; margin:0 0 1px;">
                            @ViewData["Title"] по договору №@contract?.Number
                        </h2>
                        <p class="org-header-sub" style="font-size:11px;">
                            Заполните данные
                        </p>
                    </div>
                    @if (backId > 0)
                    {
                        <a asp-controller="Contracts" asp-action="Details" asp-route-id="@backId" class="close-btn" aria-label="Закрыть"></a>
                    }
                    else
                    {
                        <a asp-controller="Contracts" asp-action="" class="close-btn" aria-label="Закрыть"></a>
                    }
                </div>

                @* {{-- ══ ФОРМА ══ --}} *@
                <form asp-action=@actionName asp-route-returnContractId="@backId" novalidate>             
                    <input asp-for="@Model.AmendmentId" hidden />
                    <input asp-for="@Model.ContractId" hidden />
                    <input asp-for="@Model.IsChange" hidden />
                    <input asp-for="@Model.ChangePrepaymentId" hidden />
                    <input name="returnContractId" value="@ViewBag.returnContractId" hidden>

                    <div class="org-body" style="padding:12px 16px 5px; gap:10px;">
                        <div class="dlg-content">
                          @*   <div class="toolbar">
                                <button type="button" class="md3-btn md3-btn-secondary-tonal" id="openWizardBtn" style="max-width: fit-content;">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                        <polyline points="14 2 14 8 20 8" />
                                        <path d="M8 13l2.5 4M10.5 13L8 17" />
                                    </svg>
                                    Импорт из Excel
                                </button>                                
                            </div>            *@               

                            <div class="table-outer">
                                <div class="table-scroll">
                                    <div class="periods-grid" id="periodsGrid" style="grid-template-columns: 200px repeat(@(Model.PrepaymentPlans.Count), minmax(170px, 1fr));">
                                        <div class="g-cell g-head g-label">Период</div>
                                        @foreach (var item in Model.PrepaymentPlans)
                                        {
                                            <input asp-for="@Model.PrepaymentPlans[index].Id" hidden />
                                            <input asp-for="@Model.PrepaymentPlans[index].PrepaymentId" hidden />
                                            <div class="g-cell g-head">@item.Period?.ToString("MMMM yyyy")</div>
                                            <input asp-for="@Model.PrepaymentPlans[index].Period" type="text" value="@item.Period" hidden />
                                            index++;
                                        }
                                        @{
                                            index = 0;
                                        }

                                        @if (ViewBag.Current != null)
                                        {
                                            <div class="g-cell g-label row-current">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                     stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                    <circle cx="12" cy="12" r="9" />
                                                    <polyline points="12 7 12 12 15 14.5" />
                                                </svg>
                                                Текущий аванс
                                            </div>
                                            @foreach (var item in Model?.PrepaymentPlans)
                                            {
                                                <div class="g-cell g-input-cell row-current">
                                                    <input class="g-input cost-format"
                                                           type="text" inputmode="decimal"
                                                           placeholder="0,00" data-row="current"                                                           
                                                           asp-for="@Model.PrepaymentPlans[index].CurrentValue"
                                                           data-col="@index">
                                                </div>
                                                index++;
                                            }
                                            index = 0;
                                        }

                                        @if (ViewBag.Target != null)
                                        {
                                            <div class="g-cell g-label row-target">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                     stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M5 21V4" />
                                                    <path d="M5 4c1.5-1 3-1 5 0s3.5 1 5 0v9c-1.5 1-3 1-5 0s-3.5-1-5 0" />
                                                </svg>
                                                Целевой аванс
                                            </div>
                                            @foreach (var item in Model?.PrepaymentPlans)
                                            {
                                                <div class="g-cell g-input-cell row-target">
                                                    <input class="g-input cost-format"
                                                           type="text" inputmode="decimal"
                                                           placeholder="0,00" 
                                                           data-row="target"                                                           
                                                           asp-for="@Model.PrepaymentPlans[index].TargetValue"
                                                           data-col="@index">
                                                </div>
                                                index++;
                                            }
                                            index = 0;

                                            @* <div class="g-cell g-label row-worked">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                     stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                    <circle cx="12" cy="12" r="9" />
                                                    <polyline points="8 12.5 10.5 15 16 9" />
                                                </svg>
                                                Отработка целевого
                                            </div>

                                            @foreach (var item in Model?.PrepaymentPlans)
                                            {
                                                <div class="g-cell g-input-cell row-worked">
                                                    <input class="g-input cost-format"
                                                           type="text"
                                                           inputmode="decimal"
                                                           placeholder="0,00"
                                                           data-row="worked"                                                           
                                                           asp-for="@Model.PrepaymentPlans[index].WorkingOutValue"
                                                           data-col="@index">
                                                </div>
                                                index++;
                                            }
                                            index = 0; *@
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="section-label" style="padding: 2px 40px 5px;">Итоговые суммы за весь период</div>
                    <div style="display: flex;gap: 20px;padding: 2px 40px 16px;white-space: nowrap;">
                        
                            @if (ViewBag.Current != null)
                            {
                                <div class="summary-item current">
                                    <span class="k">Текущий:</span>
                                    <span class="v zero">
                                        <span id="sumCurrent">0,00</span>
                                        <span>@contract?.Сurrency</span>
                                    </span>
                                </div>
                            }
                            @if (ViewBag.Target != null)
                            {
                                <div class="summary-item target">
                                    <span class="k">Целевой:</span>
                                    <span class="v">
                                        <span id="sumTarget">0,00</span>
                                        <span>@contract?.Сurrency</span>
                                    </span>
                                </div>
                               @*  <div class="summary-item worked">
                                <span class="k" style="width: min-content;">Отработка целевого:</span>
                                    <span class="v">
                                        <span id="sumWorked">0,00</span>
                                        <span>@contract?.Сurrency</span>
                                    </span>

                                </div> *@
                                @* <div class="summary-item diff">
                                    <span class="k">Разница:</span>
                                    <span class="v zero" id="sumDiff">0,00</span>
                                </div> *@
                            }
                        </div>
                    
                    @*  {{-- ══ ФУТЕР ══ --}} *@
                    <div class="org-footer" style="padding:10px 16px 14px;">

                        <a asp-controller="Prepayments"
                           asp-action="GetByContractId"
                           asp-route-contractId=@(backId > 0 ? @backId : null)
                           asp-route-returnContractId="@ViewBag.returnContractId"
                               class="md3-btn md3-btn-ghost" style="padding:6px 14px; font-size:12px;">
                                <svg viewBox="0 0 24 24" width="13" height="13" fill="none">
                                    <path d="M19 12H5M12 5l-7 7 7 7"
                                          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                Отмена
                            </a>
                        <div class="org-footer-spacer"></div>
                            <button type="submit" class="md3-btn md3-primary-btn" style="padding:6px 16px; font-size:12px;">
                                <svg viewBox="0 0 24 24" width="13" height="13" fill="none">
                                    <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"
                                          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                    <path d="M17 21v-8H7v8M7 3v5h8"
                                          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                Сохранить
                            </button>
                       
                        
                    </div>
                </form>
