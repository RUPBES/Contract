@using MvcLayer.Models;
@using Newtonsoft.Json;
@model MvcLayer.Models.PrepaymentViewModelOld
@inject BusinessLayer.Interfaces.ContractInterfaces.IContractService Contract

@{
    bool isEdit = ViewBag.IsEdit ?? false;
    ViewData["Title"] = isEdit is true ? "Редактирование авансов" : "Добавление авансов";
    int index = 0;

    int backId = ViewBag.returnContractId == 0
        ? (int)ViewBag.contractId
        : (int)ViewBag.returnContractId;

    string actionName = isEdit == true ? "Edit" : "Create";

    var contract = ViewData["contractId"] is > 0
        ? Contract.GetById((int)ViewData["contractId"])
        : null;
}

<link rel="stylesheet" href="~/css/organization-details.css" asp-append-version="true" />
<style>
    .dlg-content {
        overflow-y: auto;
        padding: 5px 20px 20px;
        flex: 1 1 auto;
    }

    .btn-filled {
        background: var(--md3-primary);
        color: #fff;
    }

        .btn-filled:hover {
            background: #154784;
        }

    .btn-outlined {
        background: var(--md3-surface);
        color: var(--md3-primary);
        border-color: var(--md3-outline-strong);
    }

        .btn-outlined:hover {
            background: var(--md3-primary-light);
            border-color: var(--md3-primary-mid);
        }

    .btn-excel {
        color: var(--md3-gen);
        border-color: var(--md3-outline-strong);
    }

        .btn-excel:hover {
            background: var(--md3-gen-light);
            border-color: var(--md3-gen);
        }

    .btn-text {
        background: transparent;
        color: var(--md3-on-surface-med);
        padding: 9px 12px;
    }

        .btn-text:hover {
            background: var(--md3-surface-2);
        }

    .btn[disabled] {
        opacity: .45;
        cursor: not-allowed;
    }

    .demo-switch {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 11.5px;
        color: var(--md3-on-surface-low);
    }

    .seg {
        display: flex;
        border: 1px solid var(--md3-outline-strong);
        border-radius: 999px;
        overflow: hidden;
    }

        .seg button {
            border: none;
            background: var(--md3-surface);
            color: var(--md3-on-surface-med);
            font-size: 12px;
            font-weight: 600;
            padding: 6px 13px;
            cursor: pointer;
            transition: all var(--md3-transition);
            border-right: 1px solid var(--md3-outline);
        }

            .seg button:last-child {
                border-right: none
            }

            .seg button.active {
                background: var(--md3-primary);
                color: #fff;
            }

            .seg button:hover:not(.active) {
                background: var(--md3-primary-light);
            }


    .toolbar {
        display: flex;
        align-items: center;       
        margin-bottom: 16px;
        flex-wrap: wrap;
        justify-content: end;
    }

    .section-label {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .04em;
        color: var(--md3-on-surface-med);
        margin: 2px 0 8px 2px;
        text-transform: uppercase;
    }

    .table-outer {
       /*  width: 90%; */
        margin: 0 auto;
    }

    .scrim {
        position: fixed;
        inset: 0;
        background: rgba(15,20,35,.36);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        z-index: 10;
    }
    .table-scroll {
        overflow-x: auto;
        overflow-y: hidden;
        border: 1px solid var(--md3-outline);
        border-radius: var(--md3-radius-md);
        background: var(--md3-surface);
    }

        .table-scroll::-webkit-scrollbar {
            height: 10px
        }

        .table-scroll::-webkit-scrollbar-thumb {
            background: var(--md3-outline-strong);
            border-radius: 8px
        }

    .periods-grid {
        display: grid;
        width: max-content;
        min-width: 100%;
    }

        .periods-grid > .g-cell:nth-last-child(-n+1000) {
        }
        /* noop reset for specificity safety */
        .periods-grid .g-cell:last-child, .periods-grid > .g-cell:nth-child(1n) {
        }

    .g-cell {
        padding: 10px 12px;
        border-bottom: 1px solid var(--md3-outline);
        border-right: 1px solid var(--md3-outline);
        display: flex;
        align-items: center;
        min-height: 46px;
        gap: 5px;
    }

    .g-head {
        position: sticky;
        top: 0;
        z-index: 2;
        background: var(--md3-surface-2);
        font-size: 11.5px;
        font-weight: 700;
        color: var(--md3-on-surface-med);
        justify-content: center;
        text-align: center;
        text-transform: uppercase;
        letter-spacing: .03em;
    }

        .g-head.g-label {
            z-index: 4;
        }

    .g-label {
        position: sticky;
        left: 0;
        z-index: 3;
        background: var(--md3-surface-2);
        font-size: 12.5px;
        font-weight: 600;
        color: var(--md3-on-surface);
        box-shadow: 1px 0 0 var(--md3-outline);
    }

        .g-label .msi {
            font-size: 16px;
            margin-right: 6px;
            color: var(--md3-primary);
            flex-shrink: 0;
        }


    .g-input-cell {
        padding: 7px 8px;
    }

    .g-input {
        width: 100%;
        border: 1px solid var(--md3-outline);
        border-radius: var(--md3-radius-sm);
        padding: 8px 10px;
        font-size: 13px;
        /* font-family: 'Roboto Mono', monospace; */
        color: var(--md3-on-surface);
        background: var(--md3-surface);
        transition: border-color var(--md3-transition), box-shadow var(--md3-transition);
    }

        .g-input:hover {
            border-color: var(--md3-outline-strong);
        }

        .g-input:focus {
            outline: none;
            border-color: var(--md3-primary);
            box-shadow: 0 0 0 3px var(--md3-primary-light);
        }

        .g-input::placeholder {
            color: var(--md3-on-surface-low);
            font-family: 'Roboto', sans-serif;
        }

    .row-current .g-input {
    }

    .row-target .g-input {
    }

    .row-worked .g-input {
    }

    div.g-label > svg {
        stroke: var(--md3-primary);
    }

    .summary-item {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 250px;
        max-width: 320px;
        width: 100%;
    }

        .summary-item .k {
            font-size: 12px;
            font-weight: 600;
            color: var(--md3-on-surface-med);
        }

        .summary-item .v {
            font-size: 15px;
            font-weight: 700;
            font-family: 'Roboto Mono', monospace;
            padding: 5px 10px;
            border-radius: 999px;
        }

        .summary-item.target .v {
            background: var(--md3-primary-light);
            color: var(--md3-primary);
        }

        .summary-item.worked .v {
            background: var(--md3-gen-light);
            color: var(--md3-gen);
        }

        .summary-item.current .v {
            background: var(--md3-warning-fill);
            color: var(--md3-warning);
        }

            .summary-item.current .v.zero {
                background: var(--md3-surface-3);
                color: var(--md3-on-surface-low);
            }




    @@media (max-width:640px) {
        .dialog {
            border-radius: 16px;
            max-height: 94vh
        }

        .table-outer {
            width: 100%
        }

        .summary-bar {
            flex-direction: column;
            align-items: stretch
        }

        .summary-item {
            justify-content: space-between
        }
    }

    .dm-modal {
        width: min(90vw, 1600px) !important;
        max-width: 1600px !important;
    }





