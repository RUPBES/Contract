    <script>
       

                /* ---- number helpers ---- */

                const grid = document.querySelector('.periods-grid');
        function parseNum(v){
          const n = parseFloat(String(v ?? '0').replace(/\s/g,'').replace(',', '.'));
          return isNaN(n) ? 0 : n;
        }
        function fmt(n){
          return n.toLocaleString('ru-RU', {minimumFractionDigits:2, maximumFractionDigits:2});
        }

        /* ---- core summary calculation ----
           Суммирует все поля в каждой из трёх строк (Текущий / Целевой / Отработка)
           по всем отрисованным периодам и пишет итоги + разницу в summary-bar. */
        function updateSummary(){
          let current = 0, target = 0, worked = 0;

          grid.querySelectorAll('.g-input[data-row="current"]').forEach(i => current += parseNum(i.value));
          grid.querySelectorAll('.g-input[data-row="target"]').forEach(i => target += parseNum(i.value));
          // grid.querySelectorAll('.g-input[data-row="worked"]').forEach(i => worked += parseNum(i.value));

          document.getElementById('sumCurrent').textContent = fmt(current);
          document.getElementById('sumTarget').textContent = fmt(target);
          // document.getElementById('sumWorked').textContent = fmt(worked);

          // const diff = target - worked;
          // const diffEl = document.getElementById('sumDiff');
          // diffEl.textContent = fmt(diff);
          // diffEl.classList.toggle('zero', diff === 0);
        }

        /* Делегирование: один слушатель на контейнере ловит input с любого поля,
           включая появившиеся позже (например, после смены числа периодов) */
        grid.addEventListener('input', (e) => {
          if (e.target.classList.contains('g-input')) updateSummary();
        });

        /* Пересчёт сразу при загрузке страницы */
        window.addEventListener('DOMContentLoaded', updateSummary);

        /* Для программного заполнения полей (например, после импорта из Excel) —
           input.value = ... в JS НЕ генерирует событие 'input', поэтому обычный
           слушатель его не поймает; эта функция заполняет ячейки и сама
           пересчитывает суммы сразу после заполнения. */
        function fillPeriodValues(data){
          ['current','target'].forEach(row => {
            const inputs = grid.querySelectorAll(`.g-input[data-row="${row}"]`);
            (data[row] || []).forEach((val, idx) => {
              if (inputs[idx]) inputs[idx].value = val;
            });
          });
          updateSummary();
        }



