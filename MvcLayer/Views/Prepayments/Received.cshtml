@using MvcLayer.Models;
@using Newtonsoft.Json;
@model MvcLayer.Models.PrepaymentViewModelOld
@inject BusinessLayer.Interfaces.ContractInterfaces.IContractService Contract

@{
    bool isEdit = ViewBag.IsEdit ?? false;
    ViewData["Title"] = isEdit is true ? "Редактирование полученых авансов" : "Добавление полученых авансов";
    int index = 0;

    int backId = ViewBag.returnContractId == 0
        ? (int)ViewBag.contractId
        : (int)ViewBag.returnContractId;

    string actionName = isEdit == true ? "Edit" : "Create";

    var contract = ViewData["contractId"] is > 0
        ? Contract.GetById((int)ViewData["contractId"])
        : null;
}

<link rel="stylesheet" href="~/css/organization-details.css" asp-append-version="true" />
<style>
    .dlg-content {
        overflow-y: auto;
        padding: 5px 20px 20px;
        flex: 1 1 auto;
    }

    .btn-filled {
        background: var(--md3-primary);
        color: #fff;
    }

        .btn-filled:hover {
            background: #154784;
        }

    .btn-outlined {
        background: var(--md3-surface);
        color: var(--md3-primary);
        border-color: var(--md3-outline-strong);
    }

        .btn-outlined:hover {
            background: var(--md3-primary-light);
            border-color: var(--md3-primary-mid);
        }

    .btn-excel {
        color: var(--md3-gen);
        border-color: var(--md3-outline-strong);
    }

        .btn-excel:hover {
            background: var(--md3-gen-light);
            border-color: var(--md3-gen);
        }

    .btn-text {
        background: transparent;
        color: var(--md3-on-surface-med);
        padding: 9px 12px;
    }

        .btn-text:hover {
            background: var(--md3-surface-2);
        }

    .btn[disabled] {
        opacity: .45;
        cursor: not-allowed;
    }

    .demo-switch {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 11.5px;
        color: var(--md3-on-surface-low);
    }

    .seg {
        display: flex;
        border: 1px solid var(--md3-outline-strong);
        border-radius: 999px;
        overflow: hidden;
    }

        .seg button {
            border: none;
            background: var(--md3-surface);
            color: var(--md3-on-surface-med);
            font-size: 12px;
            font-weight: 600;
            padding: 6px 13px;
            cursor: pointer;
            transition: all var(--md3-transition);
            border-right: 1px solid var(--md3-outline);
        }

            .seg button:last-child {
                border-right: none
            }

            .seg button.active {
                background: var(--md3-primary);
                color: #fff;
            }

            .seg button:hover:not(.active) {
                background: var(--md3-primary-light);
            }


    .toolbar {
        display: flex;
        align-items: center;
        margin-bottom: 16px;
        flex-wrap: wrap;
        justify-content: end;
    }

    .section-label {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .04em;
        color: var(--md3-on-surface-med);
        margin: 2px 0 8px 2px;
        text-transform: uppercase;
    }

    .table-outer {
        /*  width: 90%; */
        margin: 0 auto;
    }

    .scrim {
        position: fixed;
        inset: 0;
        background: rgba(15,20,35,.36);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        z-index: 10;
    }

    .table-scroll {
        overflow-x: auto;
        overflow-y: hidden;
        border: 1px solid var(--md3-outline);
        border-radius: var(--md3-radius-md);
        background: var(--md3-surface);
    }

        .table-scroll::-webkit-scrollbar {
            height: 10px
        }

        .table-scroll::-webkit-scrollbar-thumb {
            background: var(--md3-outline-strong);
            border-radius: 8px
        }

    .periods-grid {
        display: grid;
        width: max-content;
        min-width: 100%;
    }

        .periods-grid > .g-cell:nth-last-child(-n+1000) {
        }
        /* noop reset for specificity safety */
        .periods-grid .g-cell:last-child, .periods-grid > .g-cell:nth-child(1n) {
        }

    .g-cell {
        padding: 10px 12px;
        border-bottom: 1px solid var(--md3-outline);
        border-right: 1px solid var(--md3-outline);
        display: flex;
        align-items: center;
        min-height: 46px;
        gap: 5px;
    }

    .g-head {
        position: sticky;
        top: 0;
        z-index: 2;
        background: var(--md3-surface-2);
        font-size: 11.5px;
        font-weight: 700;
        color: var(--md3-on-surface-med);
        justify-content: center;
        text-align: center;
        text-transform: uppercase;
        letter-spacing: .03em;
    }

        .g-head.g-label {
            z-index: 4;
        }

    .g-label {
        position: sticky;
        left: 0;
        z-index: 3;
        background: var(--md3-surface-2);
        font-size: 12.5px;
        font-weight: 600;
        color: var(--md3-on-surface);
        box-shadow: 1px 0 0 var(--md3-outline);
    }

        .g-label .msi {
            font-size: 16px;
            margin-right: 6px;
            color: var(--md3-primary);
            flex-shrink: 0;
        }


    .g-input-cell {
        padding: 7px 8px;
    }

    .g-input {
        width: 100%;
        border: 1px solid var(--md3-outline);
        border-radius: var(--md3-radius-sm);
        padding: 8px 10px;
        font-size: 13px;
        /* font-family: 'Roboto Mono', monospace; */
        color: var(--md3-on-surface);
        background: var(--md3-surface);
        transition: border-color var(--md3-transition), box-shadow var(--md3-transition);
    }

        .g-input:hover {
            border-color: var(--md3-outline-strong);
        }

        .g-input:focus {
            outline: none;
            border-color: var(--md3-primary);
            box-shadow: 0 0 0 3px var(--md3-primary-light);
        }

        .g-input::placeholder {
            color: var(--md3-on-surface-low);
            font-family: 'Roboto', sans-serif;
        }

    .row-current .g-input {
    }

    .row-target .g-input {
    }

    .row-worked .g-input {
    }

    div.g-label > svg {
        stroke: var(--md3-primary);
    }

    .summary-item {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 250px;
        max-width: 320px;
        width: 100%;
    }

        .summary-item .k {
            font-size: 12px;
            font-weight: 600;
            color: var(--md3-on-surface-med);
        }

        .summary-item .v {
            font-size: 15px;
            font-weight: 700;
            font-family: 'Roboto Mono', monospace;
            padding: 5px 10px;
            border-radius: 999px;
        }

        .summary-item.target .v {
            background: var(--md3-primary-light);
            color: var(--md3-primary);
        }

        .summary-item.worked .v {
            background: var(--md3-gen-light);
            color: var(--md3-gen);
        }

        .summary-item.current .v {
            background: var(--md3-warning-fill);
            color: var(--md3-warning);
        }

            .summary-item.current .v.zero {
                background: var(--md3-surface-3);
                color: var(--md3-on-surface-low);
            }




    @@media (max-width:640px) {
        .dialog {
            border-radius: 16px;
            max-height: 94vh
        }

        .table-outer {
            width: 100%
        }

        .summary-bar {
            flex-direction: column;
            align-items: stretch
        }

        .summary-item {
            justify-content: space-between
        }
    }

    .dm-modal {
        width: min(90vw, 1600px) !important;
        max-width: 1600px !important;
    }
</style>
<div class="dm-overlay">
    <div class="dm-table">
        <div class="dm-cell">
            <div class="dm-modal">


                @*   {{-- ══ ШАПКА ══ --}} *@
                <div class="org-header" style="border-bottom:1.5px solid var(--md3-outline); gap:10px;">
                    <div class="org-header-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none">
                            <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"
                                  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"
                                  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </div>
                    <div class="org-header-info">
                        <h2 class="org-header-title" id="editOrgTitle"
                            style="font-size:15px; margin:0 0 1px;">
                            @ViewData["Title"] по договору №@contract?.Number
                        </h2>
                        <p class="org-header-sub" style="font-size:11px;">
                            Заполните данные
                        </p>
                    </div>
                    @if (backId > 0)
                    {
                        <a asp-controller="Contracts" asp-action="Details" asp-route-id="@backId" class="close-btn" aria-label="Закрыть"></a>
                    }
                    else
                    {
                        <a asp-controller="Contracts" asp-action="" class="close-btn" aria-label="Закрыть"></a>
                    }
                </div>

                @* {{-- ══ ФОРМА ══ --}} *@
                <form asp-action="FillRecieved" asp-route-contractId="@backId" novalidate>                   
                    <input asp-for="@Model.ContractId" hidden />
                    <input name="returnContractId" value="@ViewBag.returnContractId" hidden />

                    <div class="org-body" style="padding:12px 16px 5px; gap:10px;">
                        <div class="dlg-content">
                            <div class="table-outer">
                                <div class="table-scroll">
                                    <div class="periods-grid" id="periodsGrid" style="grid-template-columns: 200px repeat(@(Model.PrepaymentPlans.Count), minmax(170px, 1fr));">
                                        <div class="g-cell g-head g-label">Период</div>
                                        @foreach (var item in Model.PrepaymentPlans)
                                        {
                                            <input asp-for="@Model.PrepaymentPlans[index].Id" hidden />
                                            <input asp-for="@Model.PrepaymentPlans[index].PrepaymentId" hidden />
                                            <div class="g-cell g-head">@item.Period?.ToString("MMMM yyyy")</div>
                                            <input asp-for="@Model.PrepaymentPlans[index].Period" type="text" value="@item.Period" hidden />
                                            index++;
                                        }
                                        @{
                                            index = 0;
                                        }

                                        @if (ViewBag.Current != null)
                                        {
                                            <div class="g-cell g-label row-current">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                     stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                    <circle cx="12" cy="12" r="9" />
                                                    <polyline points="12 7 12 12 15 14.5" />
                                                </svg>
                                                Текущий аванс
                                            </div>
                                            @foreach (var item in Model?.PrepaymentPlans)
                                            {
                                                <div class="g-cell g-input-cell row-current">
                                                    <input class="g-input cost-format"
                                                           type="text" inputmode="decimal"
                                                           placeholder="0,00" data-row="current"
                                                           asp-for="@Model.PrepaymentPlans[index].CurrentValue"
                                                           data-col="@index">
                                                </div>
                                                index++;
                                            }
                                            index = 0;
                                        }

                                        @if (ViewBag.Target != null)
                                        {
                                            <div class="g-cell g-label row-target">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                     stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M5 21V4" />
                                                    <path d="M5 4c1.5-1 3-1 5 0s3.5 1 5 0v9c-1.5 1-3 1-5 0s-3.5-1-5 0" />
                                                </svg>
                                                Целевой аванс
                                            </div>
                                            @foreach (var item in Model?.PrepaymentPlans)
                                            {
                                                <div class="g-cell g-input-cell row-target">
                                                    <input class="g-input cost-format"
                                                           type="text" inputmode="decimal"
                                                           placeholder="0,00"
                                                           data-row="target"
                                                           asp-for="@Model.PrepaymentPlans[index].TargetValue"
                                                           data-col="@index">
                                                </div>
                                                index++;
                                            }
                                            index = 0;
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="section-label" style="padding: 2px 40px 5px;">Итоговые суммы за весь период</div>
                    <div style="display: flex;gap: 20px;padding: 2px 40px 16px;white-space: nowrap;">

                        @if (ViewBag.Current != null)
                        {
                            <div class="summary-item current">
                                <span class="k">Текущий:</span>
                                <span class="v zero">
                                    <span id="sumCurrent">0,00</span>
                                    <span>@contract?.Сurrency</span>
                                </span>
                            </div>
                        }
                        @if (ViewBag.Target != null)
                        {
                            <div class="summary-item target">
                                <span class="k">Целевой:</span>
                                <span class="v">
                                    <span id="sumTarget">0,00</span>
                                    <span>@contract?.Сurrency</span>
                                </span>
                            </div>                           
                        }
                    </div>

                    @*  {{-- ══ ФУТЕР ══ --}} *@
                    <div class="org-footer" style="padding:10px 16px 14px;">

                        <a asp-controller="Prepayments"
                           asp-action="GetByContractId"
                           asp-route-contractId=@(backId > 0 ? @backId : null)
                           class="md3-btn md3-btn-ghost" style="padding:6px 14px; font-size:12px;">
                            <svg viewBox="0 0 24 24" width="13" height="13" fill="none">
                                <path d="M19 12H5M12 5l-7 7 7 7"
                                      stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            Отмена
                        </a>
                        <div class="org-footer-spacer"></div>
                        <button type="submit" class="md3-btn md3-primary-btn" style="padding:6px 16px; font-size:12px;">
                            <svg viewBox="0 0 24 24" width="13" height="13" fill="none">
                                <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"
                                      stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                <path d="M17 21v-8H7v8M7 3v5h8"
                                      stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            Сохранить
                        </button>
                    </div>
                </form>                
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/cost-formatter.js"></script>
    <script>
                const grid = document.querySelector('.periods-grid');
        function parseNum(v){
          const n = parseFloat(String(v ?? '0').replace(/\s/g,'').replace(',', '.'));
          return isNaN(n) ? 0 : n;
        }
        function fmt(n){
          return n.toLocaleString('ru-RU', {minimumFractionDigits:2, maximumFractionDigits:2});
        }

        /* ---- core summary calculation ----
           Суммирует все поля в каждой из трёх строк (Текущий / Целевой / Отработка)
           по всем отрисованным периодам и пишет итоги + разницу в summary-bar. */
        function updateSummary(){
          let current = 0, target = 0, worked = 0;

          grid.querySelectorAll('.g-input[data-row="current"]').forEach(i => current += parseNum(i.value));
          grid.querySelectorAll('.g-input[data-row="target"]').forEach(i => target += parseNum(i.value));

          document.getElementById('sumCurrent').textContent = fmt(current);
          document.getElementById('sumTarget').textContent = fmt(target);
         
        }

        /* Делегирование: один слушатель на контейнере ловит input с любого поля,
           включая появившиеся позже (например, после смены числа периодов) */
        grid.addEventListener('input', (e) => {
          if (e.target.classList.contains('g-input')) updateSummary();
        });

        /* Пересчёт сразу при загрузке страницы */
        window.addEventListener('DOMContentLoaded', updateSummary);

        /* Для программного заполнения полей (например, после импорта из Excel) —
           input.value = ... в JS НЕ генерирует событие 'input', поэтому обычный
           слушатель его не поймает; эта функция заполняет ячейки и сама
           пересчитывает суммы сразу после заполнения. */
        function fillPeriodValues(data){
          ['current','target'].forEach(row => {
            const inputs = grid.querySelectorAll(`.g-input[data-row="${row}"]`);
            (data[row] || []).forEach((val, idx) => {
              if (inputs[idx]) inputs[idx].value = val;
            });
          });
          updateSummary();
        }
    </script>
}
