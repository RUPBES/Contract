@model MvcLayer.Models.AdditionalTermViewModel

@{
    ViewData["Title"] = "Редактирование продление сроков исполнения обязательств по договору";
    int backId = 0;
    if (ViewBag.returnContractId == 0)
        backId = ViewBag.contractId;
    else backId = ViewBag.returnContractId;
    var contid = ViewBag.contractId;
}

<div class="dm-overlay">
    <div class="dm-table">
        <div class="dm-cell">
            <div class="dm-modal" style="max-width:660px;">
                <div class="top-modal-block">
                    <label class="my-modal-title">@ViewData["Title"] @Model?.Number</label>
                    @if (backId != null && backId > 0)
                    {
                        <a asp-controller="AdditionalTerm" asp-action="GetByContractId" asp-route-id="@backId" class="close-btn"></a>
                    }
                    @if (backId == null || backId == 0)
                    {
                        <a asp-controller="AdditionalTerm" asp-action="" class="close-btn"></a>
                    }
                </div>
                <hr class="modal-line" />
                <div class="row">
                    <form asp-action="Edit" class="row">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input asp-for="Type" value="@Model?.Type" hidden>
                        <input asp-for="ContractId" value="@Model?.ContractId" hidden>
                        <input name="returnContractId" value="@ViewBag.returnContractId" hidden>

                        <div class="form-group col-6">
                            <label asp-for="Number" for="NumId"></label>
                            <div class="input-group">
                                <div class="input-group-text">№</div>
                                <input asp-for="Number" class="form-control" id="NumId">
                            </div>
                        </div>
                        <div class="form-group col-6">
                            <label asp-for="Date" class="control-label"></label>
                            <input asp-for="Date" class="form-control" value="@Model?.Date?.ToString("yyyy-MM-dd")" type="text" id="Date" required />
                            <span asp-validation-for="Date" class="text-danger"></span>
                        </div>
                        <div class="form-group ">
                            <label asp-for="DueDate" class="control-label"></label>
                            <input asp-for="DueDate" class="form-control" value="@Model?.DueDate?.ToString("yyyy-MM-dd")" type="text" id="DueDate" required />
                            <span asp-validation-for="DueDate" class="text-danger"></span>
                        </div>
                        <div class="form-group ">
                            <label asp-for="Reason" class="control-label"></label>
                            <textarea asp-for="Reason" class="form-control"></textarea>
                            <span asp-validation-for="Reason" class="text-danger"></span>
                        </div>


                        <div class="form-group ">
                            <div class="form-group ">
                                <label class="control-label">Претензионно-исковая работа?</label>
                                <br><br><label><input class="m-2" type="radio" name="IsClaimLitigation" value="true" @((Model.IsClaimLitigation == true) ? "checked" : "") /> Да</label>
                                <label><input type="radio" name="IsClaimLitigation" value="false" @((Model.IsClaimLitigation == false) ? "checked" : "") /> Нет</label>
                            </div>
                        </div>
                        @*                          
                       <div class="form-group ">
                            <label asp-for="FilesEntity" class="control-label"></label>
                            <input name="FilesEntity" type="file" class="form-control" />
                        </div>*@
                        <div class="form-group btn_position">
                            <input type="submit" value="Сохранить" class="btn btn-primary col-3 mt-3" />
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(function ($) {
            $('body').on('input', '#contractP', function (e) {
                digits_float(this);
            });
            digits_float('#contractP');
        });
        $("#Date").datepicker({
            format: "d MM yyyy",
            language: "ru",
            calendarWeeks: true,
            autoclose: true,
            keyboardNavigation: false,
            assumeNearbyYear: true,
            toggleActive: true
        });
        $("#DueDate").datepicker({
            format: "d MM yyyy",
            language: "ru",
            calendarWeeks: true,
            autoclose: true,
            keyboardNavigation: false,
            assumeNearbyYear: true,
            toggleActive: true
        });

        let date = document.querySelector("#Date");
        let dateDue = document.querySelector("#DueDate");

        $("#Date").datepicker('setDate', new Date(date.value));
        $("#DueDate").datepicker('setDate', new Date(dateDue.value));
    </script>
}