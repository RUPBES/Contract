@model MvcLayer.Models.AdditionalTermViewModel

@{
    ViewData["Title"] = "Редактирование продление сроков исполнения обязательств по договору";
    int backId = ViewBag.returnContractId == 0 ? (int)ViewBag.contractId : (int)ViewBag.returnContractId;
    var contid = ViewBag.contractId;
}


<link rel="stylesheet" href="~/css/organization-details.css" asp-append-version="true" />

<div class="dm-overlay">
    <div class="dm-table">
        <div class="dm-cell">
            <div class="dm-modal" style="max-width:760px; width:100%;">
                <div class="org-modal" role="dialog" aria-modal="true"
                     aria-labelledby="editOrgTitle">

                    @*   {{-- ══ ШАПКА ══ --}} *@
                    <div class="org-header" style="border-bottom:1.5px solid var(--md3-outline); gap:10px;">
                        <div class="org-header-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none">
                                <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"
                                      stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"
                                      stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </div>
                        <div class="org-header-info">
                            <h2 class="org-header-title" id="editOrgTitle"
                                style="font-size:15px; margin:0 0 1px;">
                                @ViewData["Title"]
                            </h2>
                            <p class="org-header-sub" style="font-size:11px;">
                                Соглашение от @Model?.Date?.ToShortDateString()
                            </p>
                        </div>
                        @if (backId > 0)
                        {
                            <a asp-controller="Contracts" asp-action="Details" asp-route-id="@backId" class="close-btn" aria-label="Закрыть"></a>
                        }
                        @if (backId == 0)
                        {
                            <a asp-controller="Contracts" asp-action="" class="close-btn" aria-label="Закрыть"></a>
                        }
                    </div>

                    @* {{-- ══ ФОРМА ══ --}} *@
                    <form asp-action="Edit" method="post" novalidate>
                        <input asp-for="Type" value="@Model?.Type" hidden>
                        <input asp-for="ContractId" value="@Model?.ContractId" hidden>
                        <input name="returnContractId" value="@ViewBag.returnContractId" hidden>

                        <div class="org-body" style="padding:12px 16px; gap:10px;">
                            @* {{-- ── Основные сведения ── --}} *@
                            <div>
                                <div class="org-section-badge edit-bdg">
                                    <svg viewBox="0 0 24 24" width="11" height="11" fill="none">
                                        <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"
                                              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                    Основные сведения
                                </div>
                            </div>
                            <div class="org-fieldset">
                                <div class="org-fieldset-body" style="grid-template-columns: 1fr;">
                                    <div class="md3-field full-width-org">
                                        <label asp-for="Number" class="md3-label">
                                            <span class="required-star">*</span>
                                            @Html.DisplayNameFor(m => m.Number)
                                        </label>
                                        <div class="md3-input-wrap">
                                            <input  asp-for="Number" class="md3-input" placeholder="Введите номер" required>
                                        </div>
                                        <span asp-validation-for="Number" class="md3-validation-msg"></span>
                                    </div>
                                    <div class="md3-field full-width-org">
                                        <label asp-for="Reason" class="md3-label">
                                            <span class="required-star">*</span>
                                            @Html.DisplayNameFor(m => m.Reason)
                                        </label>
                                        <div class="md3-input-wrap">
                                            <textarea rows="3" asp-for="Reason" class="md3-input" placeholder="Введите причину" required></textarea>
                                        </div>
                                        <span asp-validation-for="Reason" class="md3-validation-msg"></span>
                                    </div>
                                    <div class="md3-field full-width-org">
                                        <div class="md3-input-wrap">
                                            <label class="md3-label" style="cursor:pointer;">
                                                <span class="md3-input">
                                                    <input type="checkbox" name="IsClaimLitigation" value="true"
                                                           @(Model?.IsClaimLitigation == true ? "checked" : "") />
                                                    <input type="hidden" name="IsClaimLitigation" value="false" />
                                                </span>
                                                <span class="wz-opt-lbl" style="font-weight:600;">@Html.DisplayNameFor(m => m.IsClaimLitigation)</span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @* {{-- ── Основание и содержание изменений ── --}} *@
                            <div>
                                <div class="org-section-badge edit-bdg">
                                    <svg viewBox="0 0 24 24" width="11" height="11" fill="none">
                                        <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"
                                              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                    Сроки
                                </div>
                            </div>
                            <div class="org-fieldset">
                                <div class="org-fieldset-body" style="grid-template-columns: 1fr 1fr;">
                                    <div class="md3-field">
                                        <label asp-for="Date" class="md3-label">
                                            <br />
                                            <span class="required-star">*</span>
                                            @Html.DisplayNameFor(m => m.Date)
                                        </label>
                                        <div class="md3-input-wrap">
                                            <div class="md3-input-icon">
                                                <svg viewBox="0 0 24 24" width="13" height="13" fill="none">
                                                    <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.7" />
                                                    <path d="M7 17l3.5-10L14 17M8.5 13h5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                                                </svg>
                                            </div>
                                            <input asp-for="Date" type="text" value="@Model?.Date?.ToString("yyyy-MM-dd")" id="Date"  class="md3-input" required />
                                        </div>
                                        <span asp-validation-for="Date" class="md3-validation-msg"></span>
                                    </div>
                                    <div class="md3-field">
                                        <label asp-for="DueDate" class="md3-label"></label>
                                        <div class="md3-input-wrap">
                                            <div class="md3-input-icon">
                                                <svg viewBox="0 0 24 24" width="13" height="13" fill="none">
                                                    <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.7" />
                                                    <path d="M7 17l3.5-10L14 17M8.5 13h5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                                                </svg>
                                            </div>
                                            <input asp-for="DueDate"
                                                   type="text"
                                                   value="@Model?.DueDate?.ToString("yyyy-MM-dd")"
                                                   class="md3-input"
                                                   id="DueDate"
                                                   required />
                                        </div>
                                        <span asp-validation-for="DueDate" class="md3-validation-msg"></span>
                                    </div>                                    
                                </div>
                            </div>
                        </div>

                        @*  {{-- ══ ФУТЕР ══ --}} *@
                        <div class="org-footer" style="padding:10px 16px 14px;">
                            <a asp-controller="AdditionalTerm" asp-action="GetByContractId"
                               asp-route-id=@(backId > 0 ? @backId : null)
                               class="md3-btn md3-btn-ghost" style="padding:6px 14px; font-size:12px;">
                                <svg viewBox="0 0 24 24" width="13" height="13" fill="none">
                                    <path d="M19 12H5M12 5l-7 7 7 7"
                                          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                Отмена
                            </a>
                            <div class="org-footer-spacer"></div>
                            <button type="submit" class="md3-btn md3-primary-btn" style="padding:6px 16px; font-size:12px;">
                                <svg viewBox="0 0 24 24" width="13" height="13" fill="none">
                                    <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"
                                          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                    <path d="M17 21v-8H7v8M7 3v5h8"
                                          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                Сохранить
                            </button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script type="text/javascript">
        $(document).ready(function () {

            // 1. Управление значением чекбокса
            $("#checkActId").on("change", function () {
                $(this).val($(this).prop('checked') ? "true" : "false");
            });

                  // 2. Инициализация календарей (datepicker)
            let datepickerOptions = {
                format: "d MM yyyy",
                language: "ru",
                calendarWeeks: true,
                autoclose: true,
                keyboardNavigation: false,
                assumeNearbyYear: true,
                toggleActive: true,
                todayHighlight: true
            };

            $("#Date").datepicker(datepickerOptions);

            $("#DueDate").datepicker(datepickerOptions).on('changeDate', function () {
                changeDateBeg();
            });
            
            // 4. Безопасный парсинг даты из формата "yyyy-MM-dd" (избегает сдвига часовых поясов)
            function parseISODate(isoString) {
                if (!isoString) return null;
                let parts = isoString.split('-');
                if (parts.length === 3) {
                    let year = parseInt(parts[0], 10);
                    let month = parseInt(parts[1], 10) - 1; // в JS месяцы начинаются с 0
                    let day = parseInt(parts[2], 10);
                    let date = new Date(year, month, day);
                    return isNaN(date.getTime()) ? null : date;
                }
                return null;
            }            

            // 6. Безопасная первоначальная установка значений (только если они есть в HTML)
            setupInitialDate("#Date");
            setupInitialDate("#DueDate");

            function setupInitialDate(selector) {
                let input = document.querySelector(selector);
                if (input && input.value) {
                    let parsedDate = parseISODate(input.value);
                    if (parsedDate) {
                        $(selector).datepicker("setDate", parsedDate);
                    }
                }
            }
        });
                  

    </script>
}