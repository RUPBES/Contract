@using BusinessLayer.Enums;
@using BusinessLayer.Helpers
@using BusinessLayer.Interfaces.Shared
@using BusinessLayer.Models;
@using BusinessLayer.Models.KDO
@model IEnumerable<MvcLayer.Models.AdditionalTermViewModel>
@inject BusinessLayer.Interfaces.ContractInterfaces.IFileService Files
@inject BusinessLayer.Interfaces.ContractInterfaces.IContractService Contract
@inject IHttpContextUserProvider HttpHelper


@{
    var permissions = HttpHelper.GetUserPermissions();
    ViewData["Title"] = "Продление сроков исполнения обязательств по договору";

    int backId = ViewBag.returnContractId == 0 ? (int)ViewBag.contractId : (int)ViewBag.returnContractId;

    var contract = Model?.FirstOrDefault()?.ContractId is > 0
        ? Contract.GetById(Model?.FirstOrDefault()?.ContractId ?? 0)
        : null;

    string redirectAction = "GetByContractId";
    string redirectController = "AdditionalTerm";

    var isGRP_Contract = permissions.GroupeName.Contains(Constants.GRP_CONTRACT);
}
<style>
    .dm-modal {
        width: min(90vw, 1600px) !important;
        max-width: 1600px !important;
    }
</style>
<link rel="stylesheet" href="~/css/organization-details.css" asp-append-version="true" />

<div class="dm-overlay">
    <div class="dm-table">
        <div class="dm-cell">
            <div class="dm-modal">
                <div class="am-wrap">
                    <!-- Шапка -->
                    <div class="am-header">
                        <span class="am-header-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                <polyline points="14 2 14 8 20 8" />
                                <line x1="16" y1="13" x2="8" y2="13" />
                                <line x1="16" y1="17" x2="8" y2="17" />
                            </svg>
                        </span>
                        <div class="am-header-info">
                            <h1 class="am-header-title">
                                @ViewData["Title"]
                                @if (contract != null)
                                {
                                    <span> по договору <span style="color:var(--md3-primary);">№@contract.Number</span></span>
                                }
                            </h1>
                            @if (contract?.NameObject != null)
                            {
                                <div class="am-header-sub">@contract.NameObject</div>
                            }
                        </div>
                        <div class="am-header-actions">
                            @if (backId > 0)
                            {
                                <a asp-controller="Contracts" asp-action="Details" asp-route-id="@backId" class="close-btn" aria-label="Закрыть"></a>
                            }
                            else
                            {
                                <a asp-controller="Contracts" asp-action="" class="close-btn" aria-label="Закрыть"></a>
                            }
                        </div>
                    </div>

                    <!-- Карточка -->
                    <div class="am-card">
                        @if (Model.Any())
                        {
                            <div class="am-table-scroll">
                                <table class="am-table">
                                    <thead>
                                        <!-- Строка 1: основные колонки + объединённый «Сроки» -->
                                        <tr>
                                            <th class="col-6per-67max " > @Html.DisplayNameFor(model => model.Number)</th>
                                            <th class="col-6per-67max">@Html.DisplayNameFor(model => model.Date)</th>
                                            <th class="col-8per-110max">@Html.DisplayNameFor(model => model.DueDate)</th>
                                            <th class="col-40per-250max">@Html.DisplayNameFor(model => model.Reason)</th>
                                            <th class="col-6per-50min">Претензионно-исковая работа</th>                                            
                                            <th class="col-8per-110max" >Файлы</th>
                                            <th class="am-col-actions col-2per-50max"></th>
                                        </tr>                                       
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            <tr>
                                                <!-- NUMBER -->
                                                <td class="col-6per-67max">
                                                    <div class="am-num">
                                                        @Html.DisplayFor(modelItem => item.Number)
                                                    </div>
                                                </td>                                                
                                               
                                                <!-- Начало работ -->
                                                <td class="col-6per-67max am-col-date">
                                                    <span class="am-date-val">
                                                        @item.Date?.ToShortDateString()
                                                    </span>
                                                </td>
                                                <!-- Окончание работ -->
                                                <td class="col-8per-110max am-col-date">
                                                    <span class="am-date-val">
                                                        @item.DueDate?.ToShortDateString()
                                                    </span>
                                                </td>                                               
                                                <!-- Причина -->
                                                <td class="col-40per-250max">
                                                    @Html.DisplayFor(modelItem => item.Reason)
                                                </td>
                                                <!--  -->
                                                <td class="am-col-price col-6per-50min">
                                                    <span @* class="am-price" *@>
                                                        @(item.IsClaimLitigation == true ? "да" : "нет")
                                                    </span>
                                                </td>
                                                <!-- Файлы -->
                                                <td class="col-8per-110max">
                                                    @foreach (FileDTO file in Files.GetAttachedFiles(item.Id, Folder.AdditionalTerms))
                                                    {
                                                        <div class="am-file-row">
                                                            <a href="~/Files/OpenFile?id=@file.Id" title="@file.FileName" class="am-file-link" target="_blank">@file.FileName</a>
                                                            @if (permissions is not null && (permissions.IsDeleter || permissions.IsAdmin) && isGRP_Contract)
                                                            {
                                                                <a asp-controller="Files" asp-action="Delete" asp-route-id="@file.Id"
                                                                   asp-route-redirectAction="@redirectAction"
                                                                   asp-route-redirectController="@redirectController"
                                                                   asp-route-contractId="@item.ContractId"
                                                                   title="Удалить файл"
                                                                   class="modal-link del-btn"
                                                                   data-message="Прикрепленный файл будет удален. Продолжить?"> × </a>
                                                            }
                                                        </div>
                                                    }
                                                </td>

                                                <!-- Действия -->
                                                <td class="am-col-actions col-2per-50max">
                                                    <div class="am-actions-cell">
                                                        @if (permissions is not null && permissions.IsCreator && isGRP_Contract)
                                                        {
                                                            <span class="icon file-add" title="Добавить файл к согласованию">
                                                                <a asp-action="AddFile"
                                                                   asp-controller="Files"
                                                                   asp-route-entityId="@item.Id"
                                                                   asp-route-fileCategory="@Folder.AdditionalTerms"
                                                                   asp-route-redirectAction=@redirectAction
                                                                   asp-route-redirectController=@redirectController
                                                                   asp-route-contractId="@item.ContractId"
                                                                   asp-route-returnContractId="@ViewBag.returnContractId">
                                                                </a>
                                                            </span>
                                                        }

                                                        @if (permissions is not null && permissions.IsEditor && isGRP_Contract)
                                                        {
                                                            <span class="icon edit" title="Редактировать согласование продления сроков по договору">
                                                                <a asp-action="Edit" asp-route-id="@item.Id" asp-route-contractId="@item.ContractId" asp-route-returnContractId="@ViewBag.returnContractId"></a>
                                                            </span>
                                                        }
                                                        @if (permissions is not null && (permissions.IsDeleter || permissions.IsAdmin) && isGRP_Contract)
                                                        {
                                                            <span class="icon delete" title="Удалить доп. соглашение">
                                                                <a asp-action="Delete"
                                                                   asp-route-id="@item.Id"
                                                                   asp-route-contractId="@item.ContractId"
                                                                   class="modal-link"
                                                                   data-message="Дополнительное соглашение и прикрепленные файлы будут удалены. Продолжить?"></a>
                                                            </span>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <!-- Подвал с итогами -->
                            <div class="am-footer-row">
                                <span class="am-footer-badge count">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="8" y1="6" x2="21" y2="6" />
                                        <line x1="8" y1="12" x2="21" y2="12" />
                                        <line x1="8" y1="18" x2="21" y2="18" />
                                        <line x1="3" y1="6" x2="3.01" y2="6" />
                                        <line x1="3" y1="12" x2="3.01" y2="12" />
                                        <line x1="3" y1="18" x2="3.01" y2="18" />
                                    </svg>
                                    Соглашений: @Model.Count()
                                </span>

                                <span class="am-footer-badge total">
                                    @* <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="12" y1="1" x2="12" y2="23" />
                                            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                                        </svg> *@
                                    Претензионно-исковая работа?: <span style="text-transform:uppercase"> @(Model?.LastOrDefault()?.IsClaimLitigation is true ? "Да" : "Нет")</span>
                                </span>
                            </div>
                        }
                        else
                        {
                            <!-- Пустое состояние -->
                            <div class="am-empty">
                                <svg class="am-empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                    <polyline points="14 2 14 8 20 8" />
                                    <line x1="9" y1="13" x2="15" y2="13" />
                                </svg>
                                <p class="am-empty-text">Заполненные соглашения отсутствуют</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>