                                                        {
                                                            <div class="d-flex flex-row">
                                                                <span class="p-1 k-mr-5 text-break">@address.FullAddress</span>
                                                            </div>
                                                        }
                                                    }
                                                </span>
                                            </td>
                                            <td>
                                                @if (permissions is not null && permissions.IsReader)
                                                {
                                                    <span class="icon info" title="Детальная информация">
                                                        <a asp-action="Details" asp-route-id="@item.Id" asp-route-page="@ViewBag.Page" asp-route-filter="@ViewBag.CurrentFilter"></a>
                                                    </span>
                                                }
                                                @if (permissions is not null && permissions.IsEditor)
                                                {
                                                    <span class="icon edit" title="Редактировать">
                                                        <a asp-action="Edit" asp-route-id="@item.Id"></a>
                                                    </span>
                                                }
