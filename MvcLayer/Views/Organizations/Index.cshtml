@model IndexViewModel
@using BusinessLayer.Interfaces.Shared
@using BusinessLayer.Models;
@using BusinessLayer.Models.KDO
@inject IHttpContextUserProvider HttpHelper


@{
    var permissions = HttpHelper.GetUserPermissions();
    ViewData["Title"] = "Организации";
}

<style>
    .dropdown-menu {
        z-index: 1;
    }

    .input-group_flex {
        justify-content: right;
    }
</style>
<div class="dm-overlay">
    <div class="dm-table">
        <div class="dm-cell">
            <div class="dm-modal">
                <div class="top-modal-block flex-column">
                    <div class="input-group m-2">
                        <span class="my-modal-title m-auto">@ViewData["Title"]</span>
                        <a asp-controller="Home" asp-action="" class="close-btn"></a>
                    </div>
                    <div class="input-group m-2 input-group_flex">
                        <div class="nav_panel_btns">
                            <div class="link_add_emp"></div>
                            <div class="btn_panel_search">
                                <form asp-controller="Organizations" asp-action="Index" style="search-form" method="get">
                                    <input class="btn-ctr" type="text" name="searchString" placeholder="Поиск по названию" value="@ViewData["CurrentFilter"]" id="er" />
                                    <button type="submit" class="subSearch"><img src="~/icons/search.svg" title="Поиск организации" alt="Поиск организации" class="search_btn" /></button>
                                </form>
                                @if (permissions is not null && permissions.IsCreator)
                                {
                                    <button type="button" class="btn btn-success btn-ctr" onclick="location.href='@Url.Action("Create", "Organizations")'"><img class="icon" src="~/icons/plus-circle.svg" />Добавить организацию</button>
                                }
                            </div>
                        </div>
                    </div>
                    <hr class="modal-line" />
                    <div style="max-height:500px; overflow-y:scroll">
                        <table class="table table-bordered table-main table-hover">
                            <thead>
                                <tr>
                                    <th>
                                        <span class="column_400">
                                            Название
                                            @Html.ActionLink(" ", "Index", new { sortOrder = ViewBag.NameSortParm, currentFilter = ViewBag.CurrentFilter }, new { id = "arrayName", @class = "up" })

                                        </span>
                                    </th>
                                    <th>
                                        <span class="column_140">
                                            Телефоны
                                        </span>
                                    </th>
                                    <th>
                                        <span class="column_250">
                                            Юр. адрес
                                        </span>
                                    </th>
                                    <th>
                                        <span class="column_100">
                                            Действие
                                        </span>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (OrganizationDTO item in Model.Objects)
                                {
                                    <tr>
                                        <td>
                                            <span class="column_400">
                                                @Html.DisplayFor(modelItem => item.Name)
                                            </span>
                                        </td>
                                        <td>
                                            <span class="column_140">
                                                @foreach (var phone in item.Phones)
                                                {
                                                    <div class="d-flex flex-row">
                                                        <span class="p-1 k-mr-5 text-break">@phone.Number</span>
                                                    </div>
                                                }
                                            </span>
                                        </td>
                                        <td>
                                            <span class="column_250">
                                                @foreach (var address in item.Addresses)
                                                {
                                                    @if (address.FullAddress != null)
                                                    {
                                                        <div class="d-flex flex-row">
                                                            <span class="p-1 k-mr-5 text-break">@address.FullAddress</span>
                                                        </div>
                                                    }
                                                }
                                            </span>
                                        </td>
                                        <td>
                                            @if (permissions is not null && permissions.IsReader)
                                            {
                                                <span class="icon info" title="Детальная информация">
                                                    <a asp-action="Details" asp-route-id="@item.Id" asp-route-page="@ViewBag.Page" asp-route-filter="@ViewBag.CurrentFilter"></a>
                                                </span>
                                            }
                                            @if (permissions is not null && permissions.IsEditor)
                                            {
                                                <span class="icon edit" title="Редактировать">
                                                    <a asp-action="Edit" asp-route-id="@item.Id"></a>
                                                </span>
                                            }
                                            @if (permissions is not null && (permissions.IsDeleter || permissions.IsAdmin))
                                            {
                                                <span class="icon delete" title="Удалить">                                                   
                                                    <a asp-action="Delete"
                                                       asp-route-id="@item.Id"
                                                       asp-route-page="@Model.PageViewModel.PageNumber"
                                                       class="modal-link"
                                                       data-message="Организация будет удалена. Продолжить?"></a>
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <nav aria-label="Page navigation example" style="margin-top:10px;">
                        <ul class="pagination justify-content-center">
                            <li class="page-item previous_btn">
                                @{
                                        @if (Model.PageViewModel.PageNumber > 1)
                                    {
                                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageViewModel.PageNumber - 1)"
                                               asp-route-sortOrder="@ViewData["CurrentSort"]"
                                               asp-route-currentFilter="@ViewData["CurrentFilter"]">&lt;</a>
                                    }
                                        @if (Model.PageViewModel.PageNumber <= 1)
                                    {
                                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageViewModel.PageNumber - 1)"
                                               asp-route-sortOrder="@ViewData["CurrentSort"]"
                                               asp-route-currentFilter="@ViewData["CurrentFilter"]"
                                               tabindex="-1" aria-disabled="true">&lt;</a>
                                    }
                                }
                            </li>
                            @{
                                int counter = 1;
                                int index = Model.PageViewModel.PageNumber <= 5 ? 1 : Model.PageViewModel.PageNumber;
                                for (int i = index; i <= Model.PageViewModel.TotalPages; i++)
                                {
                                        <li class="page-item pag_btn_num">
                                            <a class="page-link " asp-action="Index" asp-route-page="@i"
                                               asp-route-sortOrder="@ViewData["CurrentSort"]"
                                               asp-route-currentFilter="@ViewData["CurrentFilter"]"
                                               value="@i">@i</a>
                                        </li>
                                    if (counter == 5)
                                    {
                                        counter = 1;
                                        break;
                                    }
                                }
                            }
                            <li class="page-item next_btn">
                                @{
                                        @if (Model.PageViewModel.PageNumber <= Model.PageViewModel.TotalPages)
                                    {
                                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageViewModel.PageNumber + 1)"
                                               asp-route-sortOrder="@ViewData["CurrentSort"]"
                                               asp-route-currentFilter="@ViewData["CurrentFilter"]">&gt;</a>
                                    }
                                    else
                                    {
                                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageViewModel.PageNumber + 1)"
                                               asp-route-sortOrder="@ViewData["CurrentSort"]"
                                               asp-route-currentFilter="@ViewData["CurrentFilter"]"
                                               aria-disabled="true">&gt;</a>
                                    }
                                }
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        addition_nav_bar();

        ////// Pagination
        paginationFunc(@Model.PageViewModel.PageNumber, @Model.PageViewModel.TotalPages);
        //////ENd pagination

        // Этот код управляет отображением стрелок сортировки в таблице организаций
        window.onload = function () {
            const actualUrl = window.location.search;
            const elementArrayName = document.getElementById("arrayName");  // Колонка "Название"
            
            if (actualUrl.includes('nameDesc')) {
                elementArrayName.classList.remove("up");
                elementArrayName.classList.add("up-down-active", "down"); 
            }
            else if (actualUrl.includes('name')) {
                elementArrayName.classList.add("up-down-active");
            }
        }

    </script>
}