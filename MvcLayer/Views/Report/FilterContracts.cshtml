@section Scripts {
    <script>
         document.addEventListener('DOMContentLoaded', () => {
            const period = new PeriodManager();
        });

        document.querySelectorAll('.md3-sort-type-toggle .md3-sort-radio').forEach(radio => {
            radio.addEventListener('change', () => {
                // Убираем active у всех label внутри этого toggle
                radio.closest('.md3-sort-type-toggle')
                     .querySelectorAll('.md3-sort-type-btn')
                     .forEach(btn => btn.classList.remove('active'));

                // Добавляем active только label текущего radio
                radio.nextElementSibling.classList.add('active');
            });
        });

        document.getElementById('getAllId').addEventListener('change', function () {
            // Получаем состояние чекбокса "Выбрать все"
            var isChecked = this.checked;

            // Получаем все чекбоксы со свойством name="props"
            var checkboxes = document.querySelectorAll('input[name="props"]');

            // Устанавливаем состояние для всех чекбоксов
            checkboxes.forEach(function (checkbox) {
                checkbox.checked = isChecked;
            });
        });

        document.getElementById('printContractsForm').addEventListener('submit', function(e) {
            e.preventDefault(); // Блокируем любой нативный сабмит
        });

        document.getElementById('applyButton').addEventListener('click', async function (event) {
            event.preventDefault(); // Предотвращаем стандартную отправку формы
            var formData = new FormData(document.getElementById('printContractsForm')); // Собираем данные формы

            // // Показываем прогресс-бар
            // document.getElementById('progressContainer').style.display = 'block';
            // document.getElementById('progressBar').value = 25;
            // document.getElementById('progressText').innerText = '25%';

            try {
                const response = await fetch('/Report/ExportFilterContracts', {
                    method: 'POST',
                    body: formData
                });

                if (!response.ok) {
                    throw new Error('Ошибка при загрузке файла');
                }

                const reader = response.body.getReader();
                const contentLength = +response.headers.get('Content-Length');
                let receivedLength = 0;
                let chunks = [];

                while (true) {
                    const { done, value } = await reader.read();

                    if (done) {
                        break;
                    }

                    chunks.push(value);
                    receivedLength += value.length;

                    // // Обновляем прогресс-бар
                    // const percentComplete = (receivedLength / contentLength) * 100;
                    // document.getElementById('progressBar').value = percentComplete;
                    // document.getElementById('progressText').innerText = Math.round(percentComplete) + '%';
                }

                // Собираем файл из chunks
                const blob = new Blob(chunks, { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });

                // Создаем ссылку для скачивания файла
                const link = document.createElement('a');
                link.href = window.URL.createObjectURL(blob);
                link.download = 'Договоры.xlsx'; // Имя файла
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);

                // // Скрываем прогресс-бар после завершения
                // document.getElementById('progressContainer').style.display = 'none';
            } catch (error) {
                console.error('Ошибка:', error);
                // document.getElementById('progressContainer').style.display = 'none';
            }
        });
    </script>
}