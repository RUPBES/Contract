@using BusinessLayer.Enums
@using BusinessLayer.Helpers
@inject BusinessLayer.Interfaces.CommonInterfaces.IHttpHelper HttpHelper
@inject BusinessLayer.Interfaces.CommonInterfaces.IConverter Convertor
@model Dictionary<string, string>
@{
    var permissions = HttpHelper.GetUserPermissions();
    var userOrgCode = HttpHelper.GetUserOrganizationFirstCode();
    ViewData["Title"] = "Выбор данных договора, для экспорта в Excell";

}
<style>
    .form-select-point {
        display: flex;
        flex-direction: column;
        /* width: 100%; */
    }

    .block-select-point {
        width: 98%;
    }

    #progressContainer {
        margin-top: 10px;
    }

    #progressBar {
        width: 100%;
        height: 20px;
        border-radius: 10px;
        background-color: #f3f3f3;
    }

        #progressBar::-webkit-progress-bar {
            background-color: #f3f3f3;
            border-radius: 10px;
        }

        #progressBar::-webkit-progress-value {
            background-color: #007bff;
            border-radius: 10px;
        }

        #progressBar::-moz-progress-bar {
            background-color: #007bff;
            border-radius: 10px;
        }

    #progressText {
        display: block;
        text-align: center;
        margin-top: 5px;
        font-size: 14px;
        color: #333;
    }
</style>
<div class="dm-overlay">
    <div class="dm-table">
        <div class="dm-cell">
            <div class="dm-modal" style="max-width:750px;">
                <div class="top-modal-block">
                    <div class="top-modal-left">
                        <div class="pl-left">
                            <img src="/Images/Icon/logotype.png">
                        </div>
                    </div>
                    <label class="my-modal-title">@ViewData["Title"]</label>
                    <a asp-controller="Home" asp-action="Index" class="close-btn"></a>
                </div>
                <hr class="modal-line" />
                <form asp-action="PrintContracts" method="post" class="form-select-point" id="printContractsForm">
                    @Html.AntiForgeryToken()
                    <div class="mb-4">
                        <label class="mb-3">Выбрать организацию</label>
                        <select name="organization" class="form-control js-chosen">
                            @if (userOrgCode == Constants.ORG_BES || userOrgCode == Constants.ORG_MAJOR)
                            {
                                <option value="all" selected>Все</option>
                                @foreach (var item in Enum.GetValues<OrganizationEnum>())
                                {
                                    string code = item.ToString();
                                    var name = Convertor.GetNameOrganizationByCode(item.ToString());
                                    <option value="@item">@name</option>
                                }
                            }
                            @if (userOrgCode != Constants.ORG_BES && userOrgCode != Constants.ORG_MAJOR)
                            {                               
                                var name = Convertor.GetNameOrganizationByCode(userOrgCode.ToString());
                                <option value="@userOrgCode" selected>@name</option>
                            }

                        </select>
                    </div>

                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" value="true" name="useArchiveData" id="checkNativeSwitch">
                        <label class="form-check-label" for="checkNativeSwitch">
                            Сформировать отчет для архивных договоров
                        </label>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" value="" id="getAllId" checked>
                        <label class="mb-3" for="getAllId">Выбрать все</label>
                    </div>
                    <div class="form-group ">
                        <div class="" style="height: 300px;overflow-y:scroll;">
                            @foreach (var item in Model)
                            {
                                <div class="input-group mb-2 block-select-point">
                                    <div class="input-group-text align-content-center">
                                        <input class="form-check-input m-2 p-2" type="checkbox" value="@item.Key" name="props" checked>
                                    </div>
                                    <input type="text" class="form-control" value="@item.Value" disabled>
                                </div>
                            }

                        </div>
                        <div id="progressContainer" style="display: none;">
                            <progress id="progressBar" value="0" max="100"></progress>
                            <span id="progressText">0%</span>
                        </div>
                        <button type="submit" class="btn btn-primary mt-2 justify-content-md-end">Создать Excel файл</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('getAllId').addEventListener('change', function () {
            // Получаем состояние чекбокса "Выбрать все"
            var isChecked = this.checked;

            // Получаем все чекбоксы со свойством name="props"
            var checkboxes = document.querySelectorAll('input[name="props"]');

            // Устанавливаем состояние для всех чекбоксов
            checkboxes.forEach(function (checkbox) {
                checkbox.checked = isChecked;
            });
        });

        document.getElementById('printContractsForm').addEventListener('submit', async function (event) {
            event.preventDefault(); // Предотвращаем стандартную отправку формы
            var formData = new FormData(this); // Собираем данные формы

            // Показываем прогресс-бар
            document.getElementById('progressContainer').style.display = 'block';
            document.getElementById('progressBar').value = 25;
            document.getElementById('progressText').innerText = '25%';

            try {
                const response = await fetch('/Report/PrintContracts', {
                    method: 'POST',
                    body: formData
                });

                if (!response.ok) {
                    throw new Error('Ошибка при загрузке файла');
                }

                const reader = response.body.getReader();
                const contentLength = +response.headers.get('Content-Length');
                let receivedLength = 0;
                let chunks = [];

                while (true) {
                    const { done, value } = await reader.read();

                    if (done) {
                        break;
                    }

                    chunks.push(value);
                    receivedLength += value.length;

                    // Обновляем прогресс-бар
                    const percentComplete = (receivedLength / contentLength) * 100;
                    document.getElementById('progressBar').value = percentComplete;
                    document.getElementById('progressText').innerText = Math.round(percentComplete) + '%';
                }

                // Собираем файл из chunks
                const blob = new Blob(chunks, { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });

                // Создаем ссылку для скачивания файла
                const link = document.createElement('a');
                link.href = window.URL.createObjectURL(blob);
                link.download = 'Договоры.xlsx'; // Имя файла
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);

                // Скрываем прогресс-бар после завершения
                document.getElementById('progressContainer').style.display = 'none';
            } catch (error) {
                console.error('Ошибка:', error);
                document.getElementById('progressContainer').style.display = 'none';
            }
        });
    </script>
}