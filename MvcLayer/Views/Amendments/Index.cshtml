@using BusinessLayer.Enums;
@using BusinessLayer.Models;
@using BusinessLayer.Models.KDO
@using MvcLayer.Models;

@inject BusinessLayer.Interfaces.ContractInterfaces.IFileService Files

@model IEnumerable<MvcLayer.Models.AmendmentViewModel>

@{
    ViewData["Title"] = "Доп.соглашения по договорам";
    bool isAdmin = true;
    string redirectAction = "Index";
    string redirectController = "Amendments";
}

<h1> @ViewData["Title"]</h1>

<table class="table table-striped table-main table-bordered">
    <thead>
        <tr>
            <th>
                Номер
            </th>
            <th>
                Дата
            </th>
            <th>
                Причина
            </th>
            <th>
                Договорная (контрактная) цена, руб. с НДС
            </th>
            <th>
                Срок выполнения работ (Начало)
            </th>
            <th>
                Срок выполнения работ (Окончание)
            </th>
            <th>
                Срок ввода объекта в эксплуатацию
            </th>
            <th>
                Существенные изменения пунктов Договора
            </th>
            <th>
                Файлы ДС
            </th>            
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (AmendmentViewModel item in Model)
        {
            <tr>
                <td>
                    @item.Number
                </td>
                <td>
                    @item.Date?.ToShortDateString()
                </td>                
                <td>
                    @item.Reason
                </td>
                <td>
                    @item.ContractPrice?.ToString("N2")
                </td>
                <td>
                    @item.DateBeginWork?.ToShortDateString()
                </td>
                <td>
                    @item.DateEndWork?.ToShortDateString()
                </td>
                <td>
                    @item.DateEntryObject?.ToShortDateString()
                </td>
                <td>
                    @item.ContractChanges
                </td>                
                <td>
                    @foreach (FileDTO file in Files.GetAttachedFiles(item.Id, Folder.Amendment))
                    {
                        <div>
                            <a href="~/Files/OpenFile?id=@file.Id" target="_blank">@file.FileName</a>
                            @if (isAdmin)
                            {
                                <a asp-controller="Files" asp-action="Delete" asp-route-id="@file.Id"
                                   asp-route-redirectAction="@redirectAction"
                                   asp-route-redirectController="@redirectController"
                                   asp-route-page="@ViewBag.Page"
                                   title="Удалить файл"
                                   class="modal-link del-btn"
                                   data-message="Прикрепленный файл будет удален. Продолжить?"> × </a>
                            }
                        </div>
                    }
                </td>
                <td>
                    <a asp-action="AddFile" asp-controller="Files" asp-route-entityId="@item.Id" asp-route-fileCategory="@Folder.Amendment" asp-route-redirectAction=@redirectAction asp-route-redirectController=@redirectController>Добавить файл</a> |
                    <a asp-action="Edit" asp-route-id="@item.Id">Редактировать</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Детали</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Удалить</a>|
                </td>
            </tr>
        }
    </tbody>
</table>