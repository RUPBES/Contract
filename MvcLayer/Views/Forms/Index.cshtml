@model IEnumerable<MvcLayer.Models.FormViewModel>
@using BusinessLayer.Enums;
@using BusinessLayer.Helpers
@using BusinessLayer.Interfaces.Shared
@using BusinessLayer.Models;
@using BusinessLayer.Models.KDO
@inject BusinessLayer.Interfaces.ContractInterfaces.IFileService Files
@inject IHttpContextUserProvider HttpHelper

@{
    var permissions = HttpHelper.GetUserPermissions();
    ViewData["Title"] = "Фактическое выполнение работ согласно справкам С-3а";
    // bool isAdmin = true;
    string redirectAction = "Index";
    string redirectController = "Forms";
    var isGRP_Contract = permissions.GroupeName.Contains(Constants.GRP_CONTRACT);

}
<h2>@ViewData["Title"]</h2>
@if (permissions is not null && permissions.IsCreator && isGRP_Contract)
{
    <p><a asp-action="Create">Добавить</a></p>
}
<table class="table table-main">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Period)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DateSigning)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TotalCost)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SmrCost)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PnrCost)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EquipmentCost)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OtherExpensesCost)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AdditionalCost)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MaterialCost)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GenServiceCost)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsOwnForces)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Period)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DateSigning)
                </td>
                <td>
                    @item.TotalCost.ToString("N2")
                </td>
                <td>
                    @item.SmrCost.ToString("N2")
                </td>
                <td>
                    @item.PnrCost.ToString("N2")
                </td>
                <td>
                    @item.EquipmentCost.ToString("N2")
                </td>
                <td>
                    @item.OtherExpensesCost.ToString("N2")
                </td>
                <td>
                    @item.AdditionalCost.ToString("N2")
                </td>
                <td>
                    @item.MaterialCost.ToString("N2")
                </td>
                <td>
                    @item.GenServiceCost.ToString("N2")
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.IsOwnForces)
                </td>
                <td>
                    @foreach (FileDTO file in Files.GetAttachedFiles(item.Id, Folder.Form3C))
                    {
                        <div>
                            <a href="~/Files/OpenFile?id=@file.Id" target="_blank">@file.FileName</a>
                            @if (permissions is not null && (permissions.IsDeleter || permissions.IsAdmin) && isGRP_Contract)
                            {
                                <a asp-controller="Files" asp-action="Delete" asp-route-id="@file.Id"
                                   asp-route-redirectAction="@redirectAction"
                                   asp-route-redirectController="@redirectController"
                                   asp-route-page="@ViewBag.Page"
                                   title="Удалить файл"
                                   class="modal-link del-btn"
                                   data-message="Прикрепленный файл будет удален. Продолжить?"> × </a>
                            }
                        </div>
                    }
                </td>
                <td>
                    @if (permissions is not null && permissions.IsCreator && isGRP_Contract)
                    {
                        <a asp-action="AddFile" asp-controller="Files" asp-route-entityId="@item.Id" asp-route-fileCategory="@Folder.Form3C" asp-route-redirectAction=@redirectAction asp-route-redirectController=@redirectController>Добавить файл</a>
                        <span>|</span>
                    }
                    @if (permissions is not null && permissions.IsEditor && isGRP_Contract)
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id">Редактировать</a>
                        <span>|</span>
                    }

                    @if (permissions is not null && (permissions.IsDeleter || permissions.IsAdmin) && isGRP_Contract)
                    {
                        <a asp-action="Delete" asp-route-id="@item.Id">Удалить</a>
                        <span>|</span>
                    }
                    <a asp-action="Details" asp-route-id="@item.Id">Детали</a>
                </td>
            </tr>
        }
    </tbody>
</table>