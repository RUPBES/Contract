                                                                <circle cx="12" cy="12" r="10" />
                                                                <path d="M14.5 9.5c0-1.1-1.1-2-2.5-2s-2.5.9-2.5 2c0 1.1 1.1 1.5 2.5 2s2.5.9 2.5 2c0 1.1-1.1 2-2.5 2s-2.5-.9-2.5-2" />
                                                                <line x1="12" y1="6" x2="12" y2="7.5" />
                                                                <line x1="12" y1="16.5" x2="12" y2="18" />
                                                            </svg>
                                                        </span>
                                                        <input asp-for="AdditionalNdsCost" value="@Model.AdditionalNdsCost" type="text"
                                                               class="wz-in smr-cost not-null-summ" id="AdditionalNdsCost" placeholder="0.00" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- ═══ СЛАЙД 2: ОБорудование+Другие ═══ -->
                                    <div class="wz-slide">
                                        <!-- Fieldset PNR badge -->
                                        <div class="org-section">
                                            <div class="org-section-header">
