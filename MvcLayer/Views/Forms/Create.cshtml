                                                </div>
                                                <!-- Цена -->
                                                <div class="wz-field">
                                                    <label class="wz-lbl">@Html.DisplayNameFor(x => x.AdditionalContractCost)</label>
                                                    <div class="wz-iw">
                                                        <span class="wz-iw-ic">
