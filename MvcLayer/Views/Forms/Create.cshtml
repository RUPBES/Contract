    <script>
                //обновляет сумму к оплате!
                               (function () {
                         const SELECTOR = '.total-amount-input';
                         const ANIMATION_DURATION = 500; // мс, должно совпадать с CSS-анимацией

                         // Универсальная функция применения стилей/анимации
                         function applyUpdateEffects(inputEl) {
                           const rawValue = inputEl.value.replace(/\s/g, '').replace(',', '.');
                           const numericValue = parseFloat(rawValue);

                           // Цвет для отрицательного значения
                           inputEl.classList.toggle('is-negative', !isNaN(numericValue) && numericValue < 0);

                           // Перезапуск анимации
                           inputEl.classList.remove('is-updating');
                           void inputEl.offsetWidth; // форсируем reflow
                           inputEl.classList.add('is-updating');

                           clearTimeout(inputEl._updateTimeout);
                           inputEl._updateTimeout = setTimeout(() => {
                             inputEl.classList.remove('is-updating');
                           }, ANIMATION_DURATION);
                         }

                         // Перехват программного изменения .value (когда сумму меняет JS, а не пользователь)
                         function watchValueChanges(inputEl) {
                           const prototype = Object.getPrototypeOf(inputEl);
                           const nativeDescriptor = Object.getOwnPropertyDescriptor(prototype, 'value');

                           Object.defineProperty(inputEl, 'value', {
                             get() {
                               return nativeDescriptor.get.call(this);
                             },
                             set(newVal) {
                               const oldVal = nativeDescriptor.get.call(this);
                               nativeDescriptor.set.call(this, newVal);
                               if (oldVal !== newVal) {
                                 applyUpdateEffects(this);
                               }
                             },
                             configurable: true
                           });
                         }

                         // Инициализация для всех текущих полей с нужным классом
                         function initAll() {
                           document.querySelectorAll(SELECTOR).forEach((el) => {
                             if (el._watched) return; // избегаем повторной инициализации
                             el._watched = true;

                             watchValueChanges(el);

                             // На случай, если пользователь тоже может вводить сумму вручную
                             el.addEventListener('input', () => applyUpdateEffects(el));
                           });
                         }

                         // Наблюдаем за DOM — вдруг поле появится позже (динамический рендер)
                         const observer = new MutationObserver(() => initAll());
                         observer.observe(document.body, { childList: true, subtree: true });

                         // Первичный запуск
                         initAll();
                       })();

                       // let minDate = $('#min').val();

                       $("#DateSigning").datepicker({
                           format: "d MM yyyy",
                           language: "ru",
                           // startDate: minDate,
                           calendarWeeks: true,
                           autoclose: true,
                           keyboardNavigation: false,
                           assumeNearbyYear: true,
                           toggleActive: true,
                           todayHighlight: true
                       });

                document.querySelectorAll('.not-null-summ').forEach((elem) => {
          elem.addEventListener('blur', function () {
            if (this.value.trim() === '') {
              this.value = '0';
            }
          });
        });

    </script>
