@model MvcLayer.Models.FormViewModel
@inject BusinessLayer.Interfaces.ContractInterfaces.IContractService Contract
@inject BusinessLayer.Interfaces.ContractInterfaces.IFormService Form
@{
    // var filter = new DateOnly((int)Model?.Period?.Year, (int)Model?.Period?.Month, 1);
    int backId = 0;
    bool isEng = ViewBag.IsEngin is true ? true : false;

    ViewData["Title"] = isEng
        ? "Добавить справку о стоимости выполненных работ"
        : "Добавить справку о стоимости акта оказанных услуг";

    backId = (int)ViewData["returnContractId"] == 0
        ? (int)ViewData["contractId"]
        : (int)ViewData["returnContractId"];

    var currency = Contract.GetById((Model?.ContractId ?? 0)).Сurrency;
}

<link rel="stylesheet" href="~/css/wizzard-view.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/organization-details.css" asp-append-version="true" />
<style>
    .selectize-dropdown-content {
        max-height: 78px !important;
    }

    .org-section-badge.create-bdg {
        margin: 0 0 7px 0px;
    }

    .wz-ta[disabled] {
        background-color: #f5f5f5;
        color: #888;
        cursor: not-allowed;
    }

    /* Базовый стиль поля суммы */
    .total-amount-input {
        transition: color 0.2s ease;
        font-weight: 600;
        color: var(--md3-create);
    }

        /* Отрицательное значение — красный текст */
        .total-amount-input.is-negative {
            color: #e53e3e; /* можно заменить на ваш акцентный красный */
        }

        /* Анимация при обновлении значения (пульс + fade) */
        .total-amount-input.is-updating {
            animation: amount-pulse 0.5s ease;
        }

    @@keyframes amount-pulse {
        0% {
            opacity: 0.4;
            transform: scale(0.97);
            background-color: rgba(255, 214, 0, 0.15); /* лёгкая подсветка при изменении */
        }

        50% {
            opacity: 1;
            transform: scale(1.03);
        }

        100% {
            opacity: 1;
            transform: scale(1);
            background-color: transparent;
        }
    }

    .sum-row {
        gap: 10px;
    }

    a:hover {
        color: var(--md3-primary-mid);
    }
</style>

<div class="dm-overlay">
    <div class="dm-table">
        <div class="dm-cell">
            <div class="dm-modal" style="max-width:1100px;">
                <div class="top-modal-block">
                </div>

                <!-- ══ ЗАГОЛОВОК ══ -->
                <div class="wz">
                    <div class="wz-head">
                        <span class="wz-head-icon">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                <polyline points="14 2 14 8 20 8" />
                            </svg>
                        </span>
                        <h1>@ViewData["Title"]</h1>
                        @if (backId > 0)
                        {
                            <a asp-controller="Contracts" asp-action="Details" asp-route-id="@backId" class="close-btn" aria-label="Закрыть"></a>
                        }
                        else
                        {
                            <a asp-controller="Contracts" asp-action="" class="close-btn" aria-label="Закрыть"></a>
                        }
                    </div>
                    <div style="display: flex;justify-content: flex-end;margin-bottom: 5px;">
                        <a class="wz-btn wz-btn-next"
                           style="text-decoration: none;"
                           asp-action="CreateByFile"
                           asp-route-returnContractId="@ViewData["returnContractId"]"
                           asp-route-contractId="@ViewData["contractId"]">⬆ Загрузить данные из Excel</a>

                    </div>
                    <!-- ══ STEPPER ══ -->
                    <div class="wz-stepper" id="wzStepper">
                        <div class="wz-step active" data-step="1">
                            <div class="wz-step-dot">1</div>
                            <div class="wz-step-lbl">Сроки и стоимость СМР</div>
                        </div>
                        <div class="wz-step" data-step="2">
                            <div class="wz-step-dot">2</div>
                            <div class="wz-step-lbl">Стоимость ПНР и оборудования</div>
                        </div>
                        <div class="wz-step" data-step="3">
                            <div class="wz-step-dot">3</div>
                            <div class="wz-step-lbl">Удержания</div>
                        </div>
                        <div class="wz-step" data-step="4">
                            <div class="wz-step-dot">4</div>
                            <div class="wz-step-lbl">Подтверждение</div>
                        </div>
                    </div>

                    <!-- ══ ФОРМА ══ -->
                    <form asp-action="Create" asp-controller="Forms" method="post" asp-route-returnContractId="@ViewBag.returnContractId" id="MainForm"
                          enctype="multipart/form-data" novalidate>
                        <input asp-for="ContractId" value="@Model.ContractId" hidden />
                        <input asp-for="IsOwnForces" value="@Model.IsOwnForces" hidden />

                        <!-- ═══════════════════════════════════════
                             КАРТОЧКА — фиксированный контейнер
                        ═══════════════════════════════════════ -->
                        <div class="wz-card-outer">

                            <!-- Шапка (меняется только текст) -->
                            <div class="wz-card-hdr">
                                <span class="wz-card-hdr-icon" id="hdrIcon">
                                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="10" />
                                        <line x1="12" y1="8" x2="12" y2="12" />
                                        <line x1="12" y1="16" x2="12.01" y2="16" />
                                    </svg>
                                </span>
                                <span class="wz-card-hdr-title" id="hdrTitle">Стоимость строительно-монтажных и пуско-наладочных работ</span>
                                <span class="wz-card-hdr-badge" id="hdrBadge">Шаг 1 из 4</span>
                            </div>

                            <!-- Слайдер -->
                            <div class="wz-slides-wrap">
                                <div class="wz-slides" id="wzSlides">

                                    <!-- ═══ СЛАЙД 1: СМР+ПНР ═══ -->
                                    <div class="wz-slide">
                                        <div class="org-section">
                                            <div class="org-section-header">
                                                <span class="org-section-badge create-bdg bdg-xl">
