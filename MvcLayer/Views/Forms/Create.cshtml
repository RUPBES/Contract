                                                        <circle cx="12" cy="12" r="10" />
                                                        <polyline points="12 6 12 12 16 14" />
                                                    </svg>
                                                    Сроки и файл справки
                                                </span>
                                            </div>
                                        </div>

                                        <!-- Сроки -->
                                        <div class="wz-fs">
                                            <div class="wz-fs-body g3">
                                                <!-- Дата -->
                                                @*  <input type="text" value="@Model?.Period?.ToString("MMMM yyyy")"
                                                    type="text" class="wz-in" required id="DateDC" placeholder="дд.мм.гггг"  />*@

                                                <!-- Период -->
                                                <div class="wz-field">
                                                    <label class="wz-lbl">Период заполнения справки <span class="required-star">*</span></label>
                                                    <div class="wz-iw">
                                                        <span class="wz-iw-ic">
                                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                                                <line x1="3" y1="10" x2="21" y2="10"></line>
                                                            </svg>
                                                        </span>
                                                        <select name="Period" class="js-chosen" id="DateDC" style="width:100%;" required>
                                                            <option value="" disabled>Выбрать период</option>
                                                            @foreach (DateTime item in ViewBag?.Periods ?? (Form.GetFreeForms((int)ViewData["contractId"])))
                                                            {
                                                                <option value="@(item)">@item.ToString("MMMM yyyy")</option>
                                                            }
                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="wz-field">
                                                    <label class="wz-lbl">@Html.DisplayNameFor(x => x.DateSigning) <span class="required-star">*</span></label>
                                                    <div class="wz-iw">
                                                        <span class="wz-iw-ic">
                                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                                                <line x1="3" y1="10" x2="21" y2="10"></line>
                                                            </svg>
                                                        </span>
                                                        <input name="DateSigning" type="text" class="wz-in" required value="@DateTime.Now.ToString("dd MMMM yyyy")"
                                                               id="DateSigning" placeholder="дд.мм.гггг" />
                                                    </div>
                                                </div>
                                                <div class="wz-field">
                                                    <label class="wz-lbl">Файл справки <span class="required-star">*</span></label>
