@section Scripts {
    <script>
                /*
         * Есть ли вложенные организации.
         *
         * true  -> показываем колонку "Организация"
         * false -> убираем её.
         */
        const hasChildOrganizations = true;


        /* =========================================================
           УДАЛЕНИЕ КОЛОНКИ ОРГАНИЗАЦИИ
           ========================================================= */

        function updateOrganizationColumn() {

            if (hasChildOrganizations) {
                return;
            }

            /*
             * Удаляем заголовок + значения.
             */
            document
                .querySelectorAll("[data-org-column]")
                .forEach(el => el.remove());


            /*
             * Переносим row-tools в ячейку периода,
             * поскольку организации больше нет.
             */
            document
                .querySelectorAll(".data-row")
                .forEach(row => {

                    const tools = row.querySelector(".row-tools");
                    const periodCell = row.children[0];

                    if (
                        tools &&
                        periodCell
                    ) {
                        periodCell.classList.add("main-cell");
                        periodCell.appendChild(tools);
                    }
                });
        }


        /* =========================================================
           РАСКРЫТИЕ СТРОКИ
           ========================================================= */

        function toggleRow(button) {
            const row = button.closest(".data-row");
            const details = row.nextElementSibling;
            const isOpen = details.classList.contains("open");

            /*
             * Закрываем остальные строки.
             */
            document
                .querySelectorAll(".details-row.open")
                .forEach(item => {
                    item.classList.remove("open");
                });

            document
                .querySelectorAll(".data-row.expanded")
                .forEach(item => {
                    item.classList.remove("expanded");
                });

            /*
             * Открываем текущую строку.
             */
            if (!isOpen) {
                details.classList.add("open");
                row.classList.add("expanded");
            }
        }


        /* =========================================================
           ФАЙЛЫ
           ========================================================= */

        function openFiles(button) {
            /*
             * Убираем существующие popup.
             */
            document
                .querySelectorAll(".file-popup")
                .forEach(el => el.remove());

            const wrapper = button.closest(".row-tools");
            const filesData = wrapper.querySelector(".files-data");
            const links = [...filesData.querySelectorAll("a")];


            /*
             * Один файл -> сразу открываем.
             */
            if (links.length === 1) {
                window.open(
                    links[0].href,
                    "_blank"
                );
                return;
            }

            /*
             * Несколько файлов -> список.
             */
            const popup = document.createElement("div");
            popup.className = "file-popup";

            links.forEach(source => {

                const link = document.createElement("a");
                link.href = source.href;
                link.target = "_blank";
                link.textContent = source.textContent.trim();
                popup.appendChild(link);
            });

            document.body.appendChild(popup);
            const rect = button.getBoundingClientRect();
            popup.style.left =
                Math.max(
                    8,
                    rect.right - popup.offsetWidth
                ) + "px";

            popup.style.top = rect.bottom + 6 + "px";


            /*
             * Закрываем при клике вне.
             */
            setTimeout(() => {
                document.addEventListener(
                    "click",
                    function closePopup(event) {
                        if (
                            !popup.contains(event.target) &&
                            event.target !== button
                        ) {
                            popup.remove();
                            document.removeEventListener("click",closePopup);
                        }
                    }
                );

            }, 0);
        }
        updateOrganizationColumn();
    </script>
    <script>
        (function () {
            const MONTHS_NOM = [
                'Январь','Февраль','Март','Апрель','Май','Июнь',
                'Июль','Август','Сентябрь','Октябрь','Ноябрь','Декабрь'
            ];
            const MONTHS_SHORT = [
                'Янв','Фев','Мар','Апр','Май','Июн',
                'Июл','Авг','Сен','Окт','Ноя','Дек'
            ];

            /* ── Границы из ViewBag (Razor → JS) ── */
            const BOUND_START = parseBound('@ViewBag.PeriodRange?.PeriodStart?.ToString("yyyy-MM-dd")');
            const BOUND_END   = parseBound('@ViewBag.PeriodRange?.PeriodEnd?.ToString("yyyy-MM-dd")');
            const CURRENT_VAL = '@ViewBag.ChosePeriod?.ToString("yyyy-MM-dd")';

             function parseBound(str) {
            if (!str || str.trim() === '') return null;
            const d = new Date(str);
            return isNaN(d) ? null : { y: d.getFullYear(), m: d.getMonth() };
        }

        /* ── Текущий выбранный месяц ── */
        const currentParsed = parseBound(CURRENT_VAL);
        const now = new Date();
        let selY = currentParsed ? currentParsed.y : (BOUND_START ? BOUND_START.y : now.getFullYear());
        let selM = currentParsed ? currentParsed.m : (BOUND_START ? BOUND_START.m : now.getMonth());

        /* Подстраховка: если выбранный период вдруг вне границ — подтягиваем к ближайшей границе */
        if (isBeforeStart(selY, selM) && BOUND_START) {
            selY = BOUND_START.y;
            selM = BOUND_START.m;
        } else if (isAfterEnd(selY, selM) && BOUND_END) {
            selY = BOUND_END.y;
            selM = BOUND_END.m;
        }

            /* Год в попапе */
            let popY = selY;

            /* ── Ограничения ── */
            function isBeforeStart(y, m) {
                if (!BOUND_START) return false;
                return y < BOUND_START.y || (y === BOUND_START.y && m < BOUND_START.m);
            }

            function isAfterEnd(y, m) {
                if (!BOUND_END) return false;
                return y > BOUND_END.y || (y === BOUND_END.y && m > BOUND_END.m);
            }

            function isOutOfBounds(y, m) {
                return isBeforeStart(y, m) || isAfterEnd(y, m);
            }

            /* ── Рендер строки ── */
            function renderBar() {
                const lbl   = document.getElementById('ppLabel');
                const prev  = document.getElementById('ppPrev');
                const next  = document.getElementById('ppNext');
                const input = document.getElementById('ppPeriodInput');

                if (lbl) lbl.textContent = MONTHS_NOM[selM ] + ' ' + selY;

                /* Границы стрелок */
                let prevY = selY, prevM = selM - 1;
                if (prevM < 0) { prevM = 11; prevY--; }

                let nextY = selY, nextM = selM + 1;
                if (nextM > 11) { nextM = 0; nextY++; }

                if (prev) prev.disabled = isOutOfBounds(prevY, prevM);
                if (next) next.disabled = isOutOfBounds(nextY, nextM);

                if (input) input.value = selY + '-' + String(selM + 1).padStart(2, '0') + '-01';
            }

            /* ── Рендер попапа ── */
            function renderPopup() {
                const yearEl = document.getElementById('ppPopYear');
                const grid   = document.getElementById('ppPopGrid');
                const prevYB = document.getElementById('ppPopYearPrev');
                const nextYB = document.getElementById('ppPopYearNext');

                if (yearEl) yearEl.textContent = popY;

                /* Кнопки года */
                if (prevYB) prevYB.disabled =
                    BOUND_START ? popY <= BOUND_START.y : false;
                if (nextYB) nextYB.disabled =
                    BOUND_END   ? popY >= BOUND_END.y   : false;

                if (!grid) return;
                grid.innerHTML = '';

                for (let m = 0; m < 12; m++) {
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'pp-popup-month';
                    btn.textContent = MONTHS_SHORT[m];
                    btn.title = MONTHS_NOM[m] + ' ' + popY;

                    const disabled = isOutOfBounds(popY, m);
                    btn.disabled = disabled;

                    if (popY === selY && m === selM) btn.classList.add('pp-m-selected');
                    else if (popY === now.getFullYear() && m === now.getMonth())
                        btn.classList.add('pp-m-current');

                    if (!disabled) {
                        btn.addEventListener('click', () => {
                            selY = popY;
                            selM = m;
                            renderBar();
                            ppClosePopup();
                        });
                    }

                    grid.appendChild(btn);
                }
            }

            /* ── Сдвиг месяца стрелками ── */
            window.ppShift = function (dir) {
                let y = selY, m = selM + dir;
                if (m < 0)  { m = 11; y--; }
                if (m > 11) { m = 0;  y++; }
                if (isOutOfBounds(y, m)) return;
                selY = y; selM = m;
                renderBar();
                document.getElementById('ppForm')?.submit(); // добавлено: сразу отправляем форму
            };

            /* ── Сдвиг года в попапе ── */
            window.ppPopYearShift = function (dir) {
                const ny = popY + dir;
                if (BOUND_START && ny < BOUND_START.y) return;
                if (BOUND_END   && ny > BOUND_END.y)   return;
                popY = ny;
                renderPopup();
            };

            /* ── Попап ── */
            window.ppTogglePopup = function () {
                const p = document.getElementById('ppPopup');
                if (!p) return;
                const willOpen = !p.classList.contains('pp-popup-open');
                p.classList.toggle('pp-popup-open');
                if (willOpen) { popY = selY; renderPopup(); }
            };

            function ppClosePopup() {
                document.getElementById('ppPopup')?.classList.remove('pp-popup-open');
            }

            /* Клик вне попапа — закрыть */
            document.addEventListener('click', function (e) {
                if (!e.target.closest('.pp-quick-wrap')) ppClosePopup();
            });

            /* Перед отправкой — обновить скрытый input */
            document.getElementById('ppForm')?.addEventListener('submit', function () {
                const inp = document.getElementById('ppPeriodInput');
                if (inp) inp.value = selY + '-' + String(selM + 1).padStart(2, '0') + '-01';
            });

            /* ── Инициализация ── */
            renderBar();
        })();
    </script>
}