@using BusinessLayer.Enums
@using BusinessLayer.Helpers
@using BusinessLayer.Interfaces.Shared
@using BusinessLayer.Models.KDO
@model MvcLayer.Models.FormViewModel
@inject BusinessLayer.Interfaces.ContractInterfaces.IFileService Files
@inject BusinessLayer.Interfaces.ContractInterfaces.IFormService Form
@inject BusinessLayer.Interfaces.ContractInterfaces.IContractService Contract
@inject BusinessLayer.Interfaces.ContractInterfaces.IOrganizationService Organization
@inject BusinessLayer.Interfaces.ContractInterfaces.IScopeWorkService Scopes
@inject IHttpContextUserProvider HttpHelper

@{
    var id = ViewBag.contractId;
    var contract = id > 0
            ? Contract.GetById(id, useArchiveData: true)
            : (Model?.ContractId is > 0
                ? Contract.GetById(Model?.ContractId??0, useArchiveData: true)
                : null
        );

    int backId = ViewBag.returnContractId == 0
            ? ViewBag.contractId
            : ViewBag.returnContractId;

    ViewData["Title"] = ViewBag.IsEngineering != true ?
            $"Фактическое выполнение работ (услуг) согласно справкам о стоимости выполненных работ формы С-3а" :
            $"Акты оказанных услуг согласно договору";

    var actionName = ViewBag.IsEngineering == false
            ? "IndexArch"
            : "Engineerings";

    var days = Contract.GetPaymentDueDate(id) ?? 0;
    decimal sumCostTotal = (Model?.SmrContractCost + Model?.SmrNdsCost + Model?.PnrCost + Model?.AdditionalCost + Model?.EquipmentCost) ?? 0;
    decimal sumDeductTotal = (Model?.OffsetTargetPrepayment + Model?.OffsetCurrentPrepayment + Model?.MaterialCost +
        Model?.OtherExpensesCost + Model?.GenServiceCost + Model?.Reserve) ?? 0;
    decimal sumSubTotal = 0;
    decimal sumSubDeduct = 0;

}

<link rel="stylesheet" href="~/css/period-month-picker.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/form-c3a-details-md3.css" asp-append-version="true" />

<div class="dm-overlay">
    <div class="dm-table">
        <div class="dm-cell">
            <div class="dm-modal">
                <div class="am-wrap">

                    <!-- Шапка -->
                    <div class="am-header">
                        <span class="am-header-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                <polyline points="14 2 14 8 20 8" />
                                <line x1="16" y1="13" x2="8" y2="13" />
                                <line x1="16" y1="17" x2="8" y2="17" />
                            </svg>
                        </span>
                        <div class="am-header-info">
                            <h1 class="am-header-title">
                                @ViewData["Title"]
                                @if (contract != null)
                                {
                                    <span>, за <span style="color:var(--md3-primary);">@Model?.Period?.ToString("MMMM yyyy")</span></span>
                                }
                            </h1>
                            @if (contract?.NameObject != null)
                            {
                                <div class="am-header-sub">
                                    <span> по договору № <span style="color:var(--md3-primary);">@contract.Number</span></span>
                                </div>
                            }
                        </div>
                        <div class="am-header-actions">
                            @if (backId > 0)
                            {
                                <a asp-controller="Contracts" asp-action="DetailsArch" asp-route-id="@backId" class="close-btn" aria-label="Закрыть"></a>
                            }
                            else
                            {
                                <a asp-controller="Contracts" asp-action="@actionName" class="close-btn" aria-label="Закрыть"></a>
                            }
                        </div>
                    </div>

                    <div style="display: flex;justify-content: space-between;">
                        <form asp-action="GetArchByContractId" id="ppForm" method="get" style="padding-left: 30px;max-width: 550px;">
                            <input name="contractId" value="@ViewBag.contractId" hidden />
                            <input name="isEngineering" value="@ViewBag.IsEngineering" hidden />
                            <input name="returnContractId" value="@ViewBag.returnContractId" hidden />
                            <input id="ppPeriodInput" name="chosePeriod" type="text" hidden />

                            <div class="pp-bar">
                                <!-- Иконка -->
                                <span class="pp-icon">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="2"
                                         stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="4" width="18" height="18" rx="2" />
                                        <line x1="16" y1="2" x2="16" y2="6" />
                                        <line x1="8" y1="2" x2="8" y2="6" />
                                        <line x1="3" y1="10" x2="21" y2="10" />
                                    </svg>
                                </span>

                                <!-- Стрелка назад -->
                                <button type="button" class="pp-arrow" id="ppPrev"
                                        onclick="ppShift(-1)" title="Предыдущий месяц">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="2.5"
                                         stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="15 18 9 12 15 6" />
                                    </svg>
                                </button>

                                <!-- Текущий месяц -->
                                <span class="pp-current-label" id="ppLabel">…</span>

                                <!-- Стрелка вперёд -->
                                <button type="button" class="pp-arrow" id="ppNext"
                                        onclick="ppShift(+1)" title="Следующий месяц">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="2.5"
                                         stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="9 18 15 12 9 6" />
                                    </svg>
                                </button>

                                <!-- Разделитель -->
                                <span class="pp-sep"></span>

                                <!-- Быстрый выбор месяца -->
                                <div class="pp-quick-wrap">
                                    <button type="button" class="pp-quick-btn" id="ppQuickBtn"
                                            onclick="ppTogglePopup()">
                                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none"
                                             stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="3" y="4" width="18" height="18" rx="2" />
                                            <line x1="3" y1="10" x2="21" y2="10" />
                                        </svg>
                                        Выбрать месяц
                                    </button>

                                    <div class="pp-popup" id="ppPopup">
                                        <div class="pp-popup-year">
                                            <button type="button" class="pp-popup-year-btn"
                                                    id="ppPopYearPrev" onclick="ppPopYearShift(-1)">
                                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none"
                                                     stroke="currentColor" stroke-width="2.5"
                                                     stroke-linecap="round" stroke-linejoin="round">
                                                    <polyline points="15 18 9 12 15 6" />
                                                </svg>
                                            </button>
                                            <span class="pp-popup-year-val" id="ppPopYear"></span>
                                            <button type="button" class="pp-popup-year-btn"
                                                    id="ppPopYearNext" onclick="ppPopYearShift(+1)">
                                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none"
                                                     stroke="currentColor" stroke-width="2.5"
                                                     stroke-linecap="round" stroke-linejoin="round">
                                                    <polyline points="9 18 15 12 9 6" />
                                                </svg>
                                            </button>
                                        </div>
                                        <div class="pp-popup-grid" id="ppPopGrid"></div>
                                    </div>
                                </div>

                                <!-- Применить -->
                                <button type="submit" class="pp-apply" id="ppApply">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="2.5"
                                         stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="20 6 9 17 4 12" />
                                    </svg>
                                    Применить
                                </button>
                            </div>


                        </form>
                    </div>

                    <!-- Карточка -->
                    <div>
                        @if (Model is not null)
                        {
                            <div class="table-card">
                                <div class="table-scroll">
                                    <table id="costTable">
                                        <thead>
                                            @if (ViewBag.IsEngineering == false)
                                            {
                                                <tr>
                                                    <!-- Организация скрывается, если её нет -->
                                                    <th class="simple-head w-org"
                                                        data-org-column>
                                                        @* Заказчик/Подрядчик *@
                                                    </th>
                                                    <th class="group-head group-cost w-cost">
                                                        <div class="group-inner">
                                                            Общая стоимость и оборудование
                                                            <span class="group-count">4</span>
                                                        </div>
                                                    </th>
                                                    <th class="group-head group-deduction w-deduction">
                                                        <div class="group-inner">
                                                            Удержания
                                                            <span class="group-count">5</span>
                                                        </div>
                                                    </th>
                                                    <th class="group-head group-pay w-pay">
                                                        К оплате
                                                    </th>
                                                </tr>
                                            }
                                            else
                                            {
                                                <tr>
                                                    <th class="simple-head w-org" data-org-column>         </th>
                                                    <th class="simple-head w-dates">
                                                        @Html.DisplayNameFor(model => model.DateSigning)
                                                    </th>
                                                    <th class="group-head group-cost w-cost">
                                                        <div class="group-inner">
                                                            Дата оплаты по договору
                                                        </div>
                                                    </th>
                                                    <th class="group-head group-cost w-cost">
                                                        <div class="group-inner">
                                                            Объем работ
                                                        </div>
                                                    </th>
                                                </tr>
                                            }

                                        </thead>
                                        <tbody>
                                            <tr class="data-row">
                                                <td class="main-cell" data-org-column>
                                                    @{
                                                        var allFiles = Files.GetAttachedFiles(Model.Id, Folder.Form3C);
                                                    }
                                                    <span class="org-name">
                                                        @Organization.GetNameByContractId((int)Model.ContractId)
                                                    </span>
                                                    <span class="org-type">
                                                        Генподрядная организация
                                                    </span>
                                                    <div class="row-tools">

                                                        <button class="row-tool"
                                                                type="button"
                                                                title="Файлы"
                                                                onclick="openFiles(this)">

                                                            <svg viewBox="0 0 24 24"
                                                                 fill="none"
                                                                 stroke="currentColor"
                                                                 stroke-width="1.7">

                                                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                                                <path d="M14 2v6h6" />

                                                            </svg>

                                                            <span class="file-badge">@allFiles.Count()</span>

                                                        </button>

                                                        <button class="row-tool"
                                                                type="button"
                                                                title="Подробнее"
                                                                onclick="toggleRow(this)">

                                                            <svg class="expand-icon"
                                                                 viewBox="0 0 24 24"
                                                                 fill="none"
                                                                 stroke="currentColor"
                                                                 stroke-width="2">

                                                                <path d="m6 9 6 6 6-6" />

                                                            </svg>

                                                        </button>

                                                        <div class="files-data" hidden>

                                                            @foreach (var file in allFiles)
                                                            {
                                                                <a class="detail-file" href="~/Files/OpenFile?id=@file.Id" target="_blank">@file.FileName</a>
                                                            }
                                                        </div>

                                                    </div>
                                                </td>
                                                @if (ViewBag.IsEngineering == false)
                                                {

                                                    <!-- поступление -->
                                                    <td>
                                                        <div class="amount-grid cost-grid">
                                                            <div class="amount-item">
                                                                <span class="amount-label">
                                                                    Неизменная
                                                                </span>
                                                                <span class="amount-value cost-value">
                                                                    @((Model?.SmrContractCost + Model?.SmrNdsCost)?.ToString("N2"))
                                                                </span>
                                                            </div>

                                                            <div class="amount-item">
                                                                <span class="amount-label">
                                                                    ПНР
                                                                </span>
                                                                <span class="amount-value cost-value">
                                                                    @Model?.PnrCost.ToString("N2")
                                                                </span>
                                                            </div>

                                                            <div class="amount-item">
                                                                <span class="amount-label">
                                                                    Доп.работы
                                                                </span>
                                                                <span class="amount-value cost-value">
                                                                    @Model?.AdditionalCost.ToString("N2")
                                                                </span>
                                                            </div>
                                                            <div class="amount-item">
                                                                <span class="amount-label">
                                                                    Оборудование
                                                                </span>
                                                                <span class="amount-value cost-value">
                                                                    @Model?.EquipmentCost.ToString("N2")
                                                                </span>
                                                            </div>
                                                        </div>
                                                        <div class="amount-total-row">
                                                            <div class="amount-total">
                                                                <span class="amount-total-label">
                                                                    Итого (c оборудованием)
                                                                </span>
                                                                <span class="amount-total-value cost">
                                                                    @(sumCostTotal.ToString("N2"))
                                                                </span>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <!-- удержание -->
                                                    <td>
                                                        <div class="amount-grid ded-grid">
                                                            <div class="amount-item">
                                                                <span class="amount-label">Цел. аванс</span>
                                                                <span class="amount-value ded-value">@Model?.OffsetTargetPrepayment.ToString("N2")</span>
                                                            </div>
                                                            <div class="amount-item">
                                                                <span class="amount-label">Тек. аванс</span>
                                                                <span class="amount-value ded-value">@Model?.OffsetCurrentPrepayment.ToString("N2")</span>
                                                            </div>
                                                            <div class="amount-item">
                                                                <span class="amount-label">Материалы</span>
                                                                <span class="amount-value ded-value">@Model?.MaterialCost.ToString("N2")</span>
                                                            </div>
                                                            <div class="amount-item">
                                                                <span class="amount-label">Прочие</span>
                                                                <span class="amount-value ded-value">@Model?.OtherExpensesCost.ToString("N2")</span>
                                                            </div>
                                                            <div class="amount-item">
                                                                <span class="amount-label">Генуслуги</span>
                                                                <span class="amount-value ded-value">@Model?.GenServiceCost.ToString("N2")</span>
                                                            </div>

                                                        </div>

                                                        <div class="amount-total-row">
                                                            <div class="amount-total">
                                                                <span class="amount-total-label">
                                                                    Итого удержаний
                                                                </span>
                                                                <span class="amount-total-value ded">
                                                                    @(sumDeductTotal.ToString("N2"))
                                                                </span>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <!-- итого к оплате -->
                                                    <td class="pay-cell">
                                                        <span class="pay-value">
                                                            @Model?.TotalCostToBePaid.ToString("N2")
                                                        </span>
                                                    </td>
                                                }
                                                else
                                                {
                                                    <td>@Model?.DateSigning?.ToShortDateString()</td>
                                                    <td>@(Model?.DateSigning?.AddDays(days).ToShortDateString())</td>
                                                    <td class="text-end">@Model?.TotalCostToBePaid.ToString("N2")</td>
                                                }


                                            </tr>
                                            <!-- DETAILS -->
                                            <tr class="details-row">
                                                <td class="details-cell" colspan="4">
                                                    <div class="details-panel">
                                                        @if (ViewBag.IsEngineering == false)
                                                        {
                                                            <div class="details-layout">

                                                                <section>
                                                                    <div class="details-title">
                                                                        Общая стоимость
                                                                    </div>
                                                                    <div class="details-list">
                                                                        <span class="details-label">
                                                                            Неизменная договорная цена (с НДС)
                                                                        </span>
                                                                        <span class="details-value">
                                                                            @((Model?.SmrContractCost + Model?.SmrNdsCost)?.ToString("N2"))
                                                                        </span>
                                                                        <span class="details-label">
                                                                            @Html.DisplayNameFor(model => model.PnrCost)
                                                                        </span>
                                                                        <span class="details-value">
                                                                            @Model?.PnrCost.ToString("N2")
                                                                        </span>
                                                                        <span class="details-label">
                                                                            @Html.DisplayNameFor(model => model.AdditionalCost)
                                                                        </span>
                                                                        <span class="details-value">
                                                                            @Model?.AdditionalCost.ToString("N2")
                                                                        </span>
                                                                        <span class="details-label">
                                                                            @Html.DisplayNameFor(model => model.EquipmentCost)
                                                                        </span>
                                                                        <span class="details-value">
                                                                            @Model?.EquipmentCost.ToString("N2")
                                                                        </span>
                                                                    </div>
                                                                </section>

                                                                <section>
                                                                    <div class="details-title">
                                                                        Удержания
                                                                    </div>
                                                                    <div class="details-list">
                                                                        <span class="details-label">
                                                                            @Html.DisplayNameFor(model => model.OffsetTargetPrepayment)
                                                                        </span>
                                                                        <span class="details-value ded">
                                                                            @Model?.OffsetTargetPrepayment.ToString("N2")
                                                                        </span>
                                                                        <span class="details-label">
                                                                            @Html.DisplayNameFor(model => model.OffsetCurrentPrepayment)
                                                                        </span>
                                                                        <span class="details-value ded">
                                                                            @Model?.OffsetCurrentPrepayment.ToString("N2")
                                                                        </span>
                                                                        <span class="details-label">
                                                                            @Html.DisplayNameFor(model => model.MaterialCost)
                                                                        </span>
                                                                        <span class="details-value ded">
                                                                            @Model?.MaterialCost.ToString("N2")
                                                                        </span>
                                                                        <span class="details-label">
                                                                            @Html.DisplayNameFor(model => model.OtherExpensesCost)
                                                                        </span>
                                                                        <span class="details-value ded">
                                                                            @Model?.OtherExpensesCost.ToString("N2")
                                                                        </span>
                                                                        <span class="details-label">
                                                                            @Html.DisplayNameFor(model => model.GenServiceCost)
                                                                        </span>
                                                                        <span class="details-value ded">
                                                                            @Model?.GenServiceCost.ToString("N2")
                                                                        </span>
                                                                        <span class="details-label">
                                                                            @Html.DisplayNameFor(model => model.Reserve)
                                                                        </span>
                                                                        <span class="details-value ded">
                                                                            @Model?.Reserve.ToString("N2")
                                                                        </span>
                                                                    </div>
                                                                </section>

                                                            </div>
                                                        }
                                                        <div class="details-layout details-bottom" style="grid-template-columns:repeat(3, 1fr)">
                                                            <section>
                                                                <div class="details-title">
                                                                    Даты
                                                                </div>
                                                                <div class="details-list">
                                                                    <span class="details-label">
                                                                        @Html.DisplayNameFor(model => model.DateSigning)
                                                                    </span>
                                                                    <span class="details-value">
                                                                        @Model?.DateSigning?.ToShortDateString()
                                                                    </span>
                                                                    <span class="details-label">
                                                                        Дата оплаты по договору
                                                                    </span>
                                                                    <span class="details-value">
                                                                        @(Model?.DateSigning?.AddDays(days).ToShortDateString())
                                                                    </span>
                                                                </div>
                                                            </section>
                                                            <section>
                                                                @if (allFiles.Any())
                                                                {
                                                                    <div class="details-title">
                                                                        Файлы
                                                                    </div>
                                                                    <div class="detail-files">
                                                                        @foreach (var file in allFiles)
                                                                        {
                                                                            <div class="am-file-row">
                                                                                <a class="am-file-link"
                                                                                   title="@file.FileName"
                                                                                   href="~/Files/OpenFile?id=@file.Id"
                                                                                   target="_blank">@file.FileName</a>
                                                                            </div>
                                                                        }

                                                                    </div>
                                                                }
                                                            </section>
                                                        </div>

                                                        @* <div class="details-bottom"></div> *@
                                                    </div>
                                                </td>
                                            </tr>
                                            <!-- =====================================================
                                                СУБПОДРЯД
                                                ===================================================== -->
                                            @{
                                                var formNested = Form.GetNestedFormsByPeriodAndContrId((int)Model?.ContractId, (DateTime)Model?.Period);
                                            }
                                            @foreach (var sub in formNested)
                                            {

                                                var allFilesNested = Files.GetAttachedFiles(sub.Id, Folder.Form3C);

                                                <tr class="data-row">
                                                    <td class="main-cell" data-org-column>
                                                        <span class="org-name">
                                                            @Organization.GetNameByContractId((int)sub.ContractId)
                                                        </span>
                                                        <span class="org-type">
                                                            Субподрядная организация
                                                        </span>
                                                        <div class="row-tools">
                                                            <button class="row-tool"
                                                                    type="button"
                                                                    title="Файлы"
                                                                    onclick="openFiles(this)">
                                                                <svg viewBox="0 0 24 24"
                                                                     fill="none"
                                                                     stroke="currentColor"
                                                                     stroke-width="1.7">
                                                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                                                    <path d="M14 2v6h6" />
                                                                </svg>
                                                                <span class="file-badge">@allFilesNested.Count()</span>
                                                            </button>
                                                            <button class="row-tool"
                                                                    type="button"
                                                                    title="Подробнее"
                                                                    onclick="toggleRow(this)">
                                                                <svg class="expand-icon"
                                                                     viewBox="0 0 24 24"
                                                                     fill="none"
                                                                     stroke="currentColor"
                                                                     stroke-width="2">
                                                                    <path d="m6 9 6 6 6-6" />
                                                                </svg>
                                                            </button>
                                                            <div class="files-data" hidden>
                                                                @foreach (var file in allFilesNested)
                                                                {
                                                                    <a class="detail-file" href="~/Files/OpenFile?id=@file.Id" target="_blank">@file.FileName</a>
                                                                }
                                                        </div>

                                                    </div>
                                                </td>
                                                <!-- поступление -->
                                                <td>
                                                    <div class="amount-grid cost-grid">
                                                        <div class="amount-item">
                                                            <span class="amount-label">
                                                                Неизменная
                                                            </span>
                                                            <span class="amount-value cost-value">
                                                                @((sub?.SmrContractCost + sub?.SmrNdsCost)?.ToString("N2"))
                                                            </span>
                                                        </div>
                                                        <div class="amount-item">
                                                            <span class="amount-label">
                                                                ПНР
                                                            </span>
                                                            <span class="amount-value cost-value">
                                                                @sub?.PnrCost.ToString("N2")
                                                            </span>
                                                        </div>
                                                        <div class="amount-item">
                                                            <span class="amount-label">
                                                                Доп.работы
                                                            </span>
                                                            <span class="amount-value cost-value">
                                                                @sub?.AdditionalCost.ToString("N2")
                                                            </span>
                                                        </div>
                                                        <div class="amount-item">
                                                            <span class="amount-label">
                                                                Оборудование
                                                            </span>
                                                            <span class="amount-value cost-value">
                                                                @sub?.EquipmentCost.ToString("N2")
                                                            </span>
                                                        </div>
                                                    </div>
                                                    <div class="amount-total-row">
                                                        <div class="amount-total">
                                                            <span class="amount-total-label">
                                                                Итого (c оборудованием)
                                                            </span>
                                                            <span class="amount-total-value cost">
                                                                @((sub?.SmrContractCost + sub?.SmrNdsCost + sub?.PnrCost + sub?.AdditionalCost + sub?.EquipmentCost)?.ToString("N2"))
                                                            </span>
                                                        </div>
                                                    </div>
                                                </td>
                                                <!-- удержание -->
                                                <td>
                                                    <div class="amount-grid ded-grid">
                                                        <div class="amount-item">
