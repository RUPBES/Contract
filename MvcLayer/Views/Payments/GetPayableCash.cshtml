@* @model IEnumerable<MvcLayer.Models.Reports.GetPayableCashPaymentsViewModel> *@
@model IndexViewModel
@using BusinessLayer.Helpers;
@using BusinessLayer.Models
@using MvcLayer.Models.Reports;
@using MvcLayer.Models.SettingModel
@inject BusinessLayer.Interfaces.ContractInterfaces.IContractService Contract

@{
    ViewData["Title"] = "Денежные средства по договорам, подлежащие к оплате";   
    int PageNumber = ViewBag.PageNum;
    var formModel = ViewData["FilterViewModel"] as FilterViewModel;
}
@section Table {

    <style>
        table {
            text-align: center;
        }

        .wrapper-table {
            width: 100%;
            height: 75vh;
            overflow: scroll;
        }

            .wrapper-table tbody, td, tfoot, th, thead, tr {
                /* border-color: #373b3e; */
                border-style: solid;
                border-width: 0;
            }

            .wrapper-table table td:first-child {
                position: sticky;
                z-index: 10;
                left: -1px;
                background-color: #adadad;
            }

            .wrapper-table table tr:first-child th:first-child {
                position: sticky;
                z-index: 1000;
                left: -1px;
                top: 0;
            }

            .wrapper-table thead {
                position: sticky;
                z-index: 20;
                left: 0;
                top: 0;
                opacity: 1;
                border-color: #373b3e;
            }
    </style>
    
    <div class="modal-window_filter">
        <div class="content-window">
            <div class="modal-window_filter__close-btn">
                <div class="close-btn"></div>
            </div>
            <div class="laber-window">Выберете настройки поиска</div>
            <div class="content-window__hr"></div>
            <div class="form-window">
            </div>
        </div>
    </div>
    <input type="text" id="client_filter" value="@formModel?.Client" hidden/>
    <input type="text" id="gencontr_filter" value="@formModel?.GenContractor" hidden />


    <div class="header-view">
        <h3>@ViewData["Title"]</h3>
        <div class="nav_panel_btns">
            <div class="link_add_emp"></div>
            <div class="btn_panel_search">
                <button type="button" class="btn btn-primary btn-ctr to_filter">Фильтр<img class="icon" src="~/icons/funnel.svg" /></button>
                <form asp-controller="Payments" asp-action="GetPayableCash" style="search-form" method="get">
                    <input class="btn-ctr" type="text" name="searchString" placeholder="Поиск по организации" value="@ViewData["CurrentFilter"]" id="er" />
                    <button type="submit" class="subSearch"><img src="~/icons/search.svg" title="Поиск организации" alt="Поиск организации" class="search_btn" /></button>
                </form>
            </div>
        </div>
    </div>
    <hr class="modal-line" />
    <div class="wrapper-table">
        <table class="table table-bordered table-main table-main-short table-hover">
            <thead class="text-center text-white align-top" style="position:sticky">
                <tr>
                    <th rowspan="2">
                        Номер и дата договора
                    </th>
                    <th rowspan="2">
                        Наименование объекта
                    </th>
                    <th rowspan="2">
                        Заказчик
                    </th>
                    <th rowspan="2">
                        Генподрядчик (филиал-исполнитель по приказу)
                    </th>
                    <th rowspan="2">
                        Сроки выполнения работ
                    </th>
                    <th rowspan="2">
                        Срок ввода
                    </th>
                    <th rowspan="2">
                        Валюта расчетов
                    </th>
                    <th rowspan="2">
                        Всего по договору с НДС
                    </th>
                    <th rowspan="2">
                        Остаток по выполнению
                    </th>
                    <th rowspan="2">
                        Объем на текущий год
                    </th>
                    <th rowspan="2">
                        Фактическое выполнение по справке С-3а
                    </th>
                    <th rowspan="2">
                        Зарезервированные средства
                    </th>
                </tr>
            </thead>
            <tbody style="height:70vh;">
                @foreach (VPaymentCashDTO item in Model.Objects)
                {
                    <tr>
                        <td>
                            <a asp-action="DetailsPayableCash" asp-route-contractId="@item.Id">
                                @item?.Number <br>
                                от<br>
                                @item?.Date?.ToShortDateString()
                            </a>
                        </td>
                        <td>
                            @item?.NameObject
                        </td>
                        <td>
                            @item?.Client
                        </td>
                        <td>
                            @item?.GenContractor
                        </td>
                        <td>
                            @item?.DateBeginWork?.ToShortDateString() - @item?.DateEndWork?.ToShortDateString()
                        </td>
                        <td>
                            @item?.EnteringTerm?.ToShortDateString()
                        </td>
                        <td>
                            @item?.Сurrency
                        </td>
                        <td class="text-end">
                            @((item?.ContractPrice??0).ToString("N2"))
                        </td>
                        <td class="text-end">
                            @(((item?.ContractPrice - item?.FactSum) ?? 0).ToString("N2")))
                        </td>
                        <td class="text-end">
                            @((item?.ThisYearSum??0).ToString("N2"))
                        </td>
                        <td class="text-end">
                            @((item?.FactSum ?? 0).ToString("N2"))
                        </td>
                        <td class="text-end">
                            @((item?.ReserveSum??0).ToString("N2"))
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <nav aria-label="Page navigation example" style="margin-top:10px;">
        <ul class="pagination justify-content-center">
            <li class="page-item previous_btn">
                @{
                    @if (Model.PageViewModel.PageNumber > 1)
                    {
                        <a class="page-link" asp-action="GetPayableCash"
                           asp-route-page="@(Model.PageViewModel.PageNumber - 1)"
                           asp-route-currentFilter="@ViewData["CurrentFilter"]">
                            &lt;
                        </a>
                    }
                    else
                    {
                        <a class="page-link disabled" href="#"
                           tabindex="-1">
                            &lt;
                        </a>
                    }
                }

            </li>
            @{
                int counter = 1;
                int index = Model.PageViewModel.PageNumber <= 3 ? 1 : Model.PageViewModel.PageNumber - 2;
                int end = 0;
                if (Model.PageViewModel.PageNumber <= 3) end = Model.PageViewModel.TotalPages > 5 ? 5 : Model.PageViewModel.TotalPages;
                else if (Model.PageViewModel.TotalPages <= 5)
                    end = Model.PageViewModel.TotalPages;
                else if (Model.PageViewModel.TotalPages >= Model.PageViewModel.PageNumber + 2)
                    end = Model.PageViewModel.PageNumber + 2;
                else
                {
                    end = Model.PageViewModel.TotalPages;
                    index = Model.PageViewModel.TotalPages - 4;
                }

                for (int i = index; i <= end; i++)
                {
                    <li class="page-item pag_btn_num @(i == Model.PageViewModel.PageNumber ? "active":"")">
                        <a class="page-link "                           
                           asp-action="GetPayableCash"
                           asp-route-page="@i"
                           asp-route-currentFilter="@ViewData["CurrentFilter"]"
                           value="@i">@i</a>
                    </li>
                    if (counter == 5)
                    {
                        counter = 1;
                        break;
                    }
                }
            }

            <li class="page-item next_btn">
                @{
                    @if (Model.PageViewModel.PageNumber < Model.PageViewModel.TotalPages)
                    {
                        <a class="page-link" asp-action="GetPayableCash"
                           asp-route-page="@(Model.PageViewModel.PageNumber + 1)"
                           asp-route-currentFilter="@ViewData["CurrentFilter"]">
                            &gt;
                        </a>
                    }
                    else
                    {
                        <a class="page-link disabled" href="#"
                           tabindex="-1">
                            &gt;
                        </a>
                    }
                }
            </li>
        </ul>
    </nav>
}
}
@section Scripts {
    @{
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                let window_filter = document.querySelector(" .modal-window_filter");
                let btn_filter = document.querySelector("button.to_filter");
                let btn_close = document.querySelector(".close-btn");

                btn_filter.addEventListener('click', function(){
                    $.ajax({
                        type: 'POST',
                        url: '@Url.Action("GetFilterForm", "Payments")',
                        // contentType: "application/html; charset=utf-8",
                        data: { client: $("#client_filter").val(), genContractor: $("#gencontr_filter").val() },
                        // dataType: 'html',
                        success: function (result) {
                            $('.form-window').html(result);
                        },
                        error: function (result) {
                            alert("Ошибка отображения");
                        }
                    });

                    window_filter.classList.add("open");
                });
                btn_close.addEventListener('click', function(){
                    window_filter.classList.remove("open");
                    });
                document.addEventListener('keydown', function(event) {
                    if (event.key === 'Escape') {
                        window_filter.classList.remove("open");
                    }
                });
            });
        </script>
    }
}