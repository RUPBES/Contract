@model IEnumerable<MvcLayer.Models.ActViewModel>
@using BusinessLayer.Enums;
@using BusinessLayer.Helpers
@using BusinessLayer.Interfaces.Shared
@using BusinessLayer.Models;
@using BusinessLayer.Models.KDO
@inject BusinessLayer.Interfaces.ContractInterfaces.IFileService Files
@inject BusinessLayer.Interfaces.ContractInterfaces.IScopeWorkService Scopes
@inject BusinessLayer.Interfaces.ContractInterfaces.IContractService Contract
@inject IHttpContextUserProvider HttpHelper


@{
    var permissions = HttpHelper.GetUserPermissions();
    ViewData["Title"] = "Акты приостановления/возобновления работ (услуг)";

    int backId = ViewBag.returnContractId == 0 ? (int)ViewBag.contractId : (int)ViewBag.returnContractId;

    var contract = Model?.FirstOrDefault()?.ContractId is > 0
        ? Contract.GetById(Model?.FirstOrDefault()?.ContractId ?? 0)
        : null;

    string redirectAction = "GetByContractId";
    string redirectController = "Acts";

    var isThereScopeWorks = Scopes.Find(x => x.ContractId == (contract?.Id ?? (int)ViewBag?.contractId))?.Count() > 0 && contract?.IsMultiple != true ? true : false;
    var isGRP_Contract = permissions.GroupeName.Contains(Constants.GRP_CONTRACT);
}
<style>
    .dm-modal {
        width: min(90vw, 1600px) !important;
        max-width: 1600px !important;
    }
</style>
<link rel="stylesheet" href="~/css/organization-details.css" asp-append-version="true" />

<div class="dm-overlay">
    <div class="dm-table">
        <div class="dm-cell">
            <div class="dm-modal">
                <div class="am-wrap">
                    <!-- Шапка -->
                    <div class="am-header">
                        <span class="am-header-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                <polyline points="14 2 14 8 20 8" />
                                <line x1="16" y1="13" x2="8" y2="13" />
                                <line x1="16" y1="17" x2="8" y2="17" />
                            </svg>
                        </span>
                        <div class="am-header-info">
                            <h1 class="am-header-title">
                                @ViewData["Title"]
                                @if (contract != null)
                                {
                                    <span> по договору <span style="color:var(--md3-primary);">№@contract.Number</span></span>
                                }
                            </h1>
                            @if (contract?.NameObject != null)
                            {
                                <div class="am-header-sub">@contract.NameObject</div>
                            }
                        </div>
                        <div class="am-header-actions">
                            @if (backId > 0)
                            {
                                <a asp-controller="Contracts" asp-action="Details" asp-route-id="@backId" class="close-btn" aria-label="Закрыть"></a>
                            }
                            else
                            {
                                <a asp-controller="Contracts" asp-action="" class="close-btn" aria-label="Закрыть"></a>
                            }
                        </div>
                    </div>
                    <!-- Панель инструментов -->
                    @if (isThereScopeWorks && permissions.IsCreator && isGRP_Contract)
                    {
                        <div class="am-toolbar">
                            <div class="am-toolbar-actions">
                                <a asp-action="Create" asp-controller="Acts" asp-route-contractId="@ViewBag.contractId" asp-route-returnContractId="@ViewBag.returnContractId" class="am-btn am-btn-primary md3-btn--tonal" title="Добавить акт приостановки/возобновления">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="12" y1="5" x2="12" y2="19" />
                                        <line x1="5" y1="12" x2="19" y2="12" />
                                    </svg>
                                    <span>Добавить</span>
                                </a>
                            </div>
                        </div>
                    }
                    <!-- Карточка -->
                    <div class="am-card">
                        @if (Model.Any())
                        {
                            <div class="am-table-scroll">
                                <table class="am-table">
                                    <thead>
                                        <!-- Строка 1: основные колонки + объединённый «Сроки» -->
                                        <tr>
                                            <th class="col-6per-67max " rowspan="2"> @Html.DisplayNameFor(model => model.DateAct)</th>
                                            <th class="col-4per" rowspan="2">Приостановка/возобновление работ</th>
                                            <th class="col-30per-250max" rowspan="2">@Html.DisplayNameFor(model => model.Reason)</th>
                                            <th class="col-4per" colspan="2">Период приостановки</th>
                                            <th class="col-4per" rowspan="2">@Html.DisplayNameFor(model => model.DateRenewal)</th>
                                            <th class="col-4per-50max-files" rowspan="2">Файлы</th>
                                            <th class="am-col-actions col-4per" rowspan="2"></th>
                                        </tr>
                                        <!-- Строка 2: начало / окончание -->
                                        <tr>
                                            <th class="col-4per am-col-date">начало</th>
                                            <th class="col-4per am-col-date" style="border-right: 1px solid var(--md3-outline);">окончание</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            <tr>
                                                <!-- Номер и дата -->
                                                <td class="col-6per-67max">
                                                    <div class="am-num">
                                                        @item.DateAct?.ToShortDateString()
                                                    </div>
                                                </td>
                                                <!--  -->
                                                <td class="am-col-price col-5per">
                                                    <span class="am-price">
                                                        @(item.IsSuspension is true ? "приостановка" : "возобновление")
                                                    </span>
                                                </td>
                                                <!-- Причина -->
                                                <td class="col-30per-250max">
                                                    @Html.DisplayFor(modelItem => item.Reason)
                                                </td>
                                                <!-- Начало работ -->
                                                <td class="col-1pern am-col-date">
                                                    <span class="am-date-val">
                                                        @item.DateSuspendedFrom?.ToShortDateString()
                                                    </span>
                                                </td>
                                                <!-- Окончание работ -->
                                                <td class="col-1per am-col-date">
                                                    <span class="am-date-val">
                                                        @item.DateSuspendedUntil?.ToShortDateString()
                                                    </span>
                                                </td>

                                                <!--  -->
                                                <td class="col-1per am-col-date">
                                                    <span class="am-date-val">
                                                        @item.DateRenewal?.ToShortDateString()
                                                    </span>
                                                </td>
                                                <!-- Файлы -->
                                                <td class="col-5per-50max-files">
                                                    @foreach (FileDTO file in Files.GetAttachedFiles(item.Id, Folder.Acts))
                                                    {
                                                        <div class="am-file-row">
                                                            <a href="~/Files/OpenFile?id=@file.Id"
                                                               title="@file.FileName" class="am-file-link" target="_blank">@file.FileName</a>
                                                            @if (permissions is not null && (permissions.IsAdmin || permissions.IsDeleter) && isGRP_Contract)
                                                            {
                                                                <a asp-controller="Files" asp-action="Delete" asp-route-id="@file.Id"
                                                                   asp-route-redirectAction="@redirectAction"
                                                                   asp-route-redirectController="@redirectController"
                                                                   asp-route-contractId="@item.ContractId"
                                                                   asp-route-returnContractId="@ViewBag.returnContractId"
                                                                   title="Удалить файл"
                                                                   class="am-file-del modal-link"
                                                                   data-message="Прикрепленный файл будет удален. Продолжить?"> × </a>
                                                            }
                                                        </div>
                                                    }
                                                </td>

                                                <!-- Действия -->
                                                <td class="am-col-actions col-4per">
                                                    <div class="am-actions-cell">
                                                        @if (permissions is not null && permissions.IsCreator && isGRP_Contract)
                                                        {
                                                            <span class="icon file-add" title="Добавить файл к акту">
                                                                <a asp-action="AddFile" asp-controller="Files" asp-route-entityId="@item.Id" asp-route-fileCategory="@Folder.Acts" asp-route-redirectAction=@redirectAction asp-route-redirectController=@redirectController asp-route-contractId="@item.ContractId" asp-route-returnContractId="@ViewBag.returnContractId"></a>
                                                            </span>
                                                        }
                                                        @if (permissions is not null && permissions.IsEditor && isGRP_Contract)
                                                        {
                                                            <span class="icon edit" title="Редактировать акт">
                                                                <a asp-action="Edit" asp-route-id="@item.Id" asp-route-contractId="@item.ContractId" asp-route-returnContractId="@ViewBag.returnContractId"></a>
                                                            </span>
                                                        }
                                                        @if (permissions is not null && (permissions.IsAdmin || permissions.IsDeleter) && isGRP_Contract)
                                                        {
                                                            <span class="icon delete" title="Удалить акт">
                                                                <a asp-action="Delete"
                                                                   asp-route-id="@item.Id"
                                                                   asp-route-contractId="@item.ContractId"
                                                                   asp-route-returnContractId="@ViewBag.returnContractId"
                                                                   class="modal-link"
                                                                   data-message="Акт приостановки/возобновления работ (услуг) и прикрепленные файлы будут удалены. Продолжить?">
                                                                </a>
                                                            </span>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <!-- Подвал с итогами -->
                            <div class="am-footer-row">
                                <span class="am-footer-badge count">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="8" y1="6" x2="21" y2="6" />
                                        <line x1="8" y1="12" x2="21" y2="12" />
                                        <line x1="8" y1="18" x2="21" y2="18" />
                                        <line x1="3" y1="6" x2="3.01" y2="6" />
                                        <line x1="3" y1="12" x2="3.01" y2="12" />
                                        <line x1="3" y1="18" x2="3.01" y2="18" />
                                    </svg>
                                    Актов: @Model.Count()
                                </span>

                                <span class="am-footer-badge total">
                                    @* <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="12" y1="1" x2="12" y2="23" />
                                            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                                        </svg> *@
                                    Текущий статус: <span style="text-transform:uppercase"> @(Model?.LastOrDefault()?.IsSuspension is true ? "работа приостановлена" : "работа возобновлена")</span>
                                </span>
                            </div>
                        }
                        else
                        {
                            <!-- Пустое состояние -->
                            <div class="am-empty">
                                <svg class="am-empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                    <polyline points="14 2 14 8 20 8" />
                                    <line x1="9" y1="13" x2="15" y2="13" />
                                </svg>
                                <p class="am-empty-text">Заполненные акты приостановления/возобновления работ отсутствуют</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>