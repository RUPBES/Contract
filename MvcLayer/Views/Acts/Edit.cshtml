@model MvcLayer.Models.ActViewModel

@{
    ViewData["Title"] = "Редактирование акта приостановки/возобновления";
    int backId = 0;
    if (ViewBag.returnContractId == 0)
        backId = ViewBag.contractId;
    else backId = ViewBag.returnContractId;
    var contid = ViewBag.contractId;
    var s = Model;
}


<link rel="stylesheet" href="~/css/organization-details.css" asp-append-version="true" />

<div class="dm-overlay">
    <div class="dm-table">
        <div class="dm-cell">
            <div class="dm-modal" style="max-width:760px; width:100%;">
                <div class="org-modal" role="dialog" aria-modal="true"
                     aria-labelledby="editOrgTitle">

                    @*   {{-- ══ ШАПКА ══ --}} *@
                    <div class="org-header" style="border-bottom:1.5px solid var(--md3-outline); gap:10px;">
                        <div class="org-header-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none">
                                <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"
                                      stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"
                                      stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </div>
                        <div class="org-header-info">
                            <h2 class="org-header-title" id="editOrgTitle"
                                style="font-size:15px; margin:0 0 1px;">
                                @ViewData["Title"]
                            </h2>
                            <p class="org-header-sub" style="font-size:11px;">
                                Акт от @Model?.DateAct?.ToShortDateString()
                            </p>
                        </div>
                        @if (backId != null && backId > 0)
                        {
                            <a asp-controller="Acts" asp-action="GetByContractId" asp-route-id="@backId" class="close-btn" aria-label="Закрыть"></a>
                        }
                        @if (backId == null || backId == 0)
                        {
                            <a asp-controller="Contracts" asp-action="" class="close-btn" aria-label="Закрыть"></a>
                        }
                    </div>

                    @* {{-- ══ ФОРМА ══ --}} *@
                    <form asp-action="Edit" asp-route-returnContractId="@ViewBag.returnContractId" method="post" novalidate>
                        <input type="hidden" asp-for="Id" />
                        <input asp-for="ContractId" value="@Model?.ContractId" hidden>

                        <div class="org-body" style="padding:12px 16px; gap:10px;">
                            @* {{-- ── Основные сведения ── --}} *@
                            <div>
                                <div class="org-section-badge create-bdg">
                                    <svg viewBox="0 0 24 24" width="11" height="11" fill="none">
                                        <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"
                                              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                    Основные сведения
                                </div>
                            </div>
                            <div class="org-fieldset">

                                <div class="org-fieldset-body" style="grid-template-columns: 1fr 1fr;">
                                    <div class="md3-field full-width-org">
                                        <label asp-for="Reason" class="md3-label">
                                            <span class="required-star">*</span>
                                            @Html.DisplayNameFor(m => m.Reason)
                                        </label>
                                        <div class="md3-input-wrap">
                                            <textarea rows="3" asp-for="Reason" class="md3-input" placeholder="Введите причину" required></textarea>
                                        </div>
                                        <span asp-validation-for="Reason" class="md3-validation-msg"></span>
                                    </div>
                                    <div class="md3-field full-width-org">
                                        <div class="md3-input-wrap">

                                            <label class="md3-label" style="cursor:pointer;">
                                                <span class="md3-input">
                                                    <input type="checkbox" name="IsSuspension" value="true"
                                                           @(Model?.IsSuspension == true ? "checked" : "") />
                                                    <input type="hidden" name="IsSuspension" value="false" />
                                                </span>
                                                <span class="wz-opt-lbl" style="font-weight:600;">@Html.DisplayNameFor(m => m.IsSuspension)</span>
                                            </label>

                                        </div>
                                    </div>

                                </div>
                            </div>

                            @* {{-- ── Основание и содержание изменений ── --}} *@
                            <div>
                                <div class="org-section-badge create-bdg">
                                    <svg viewBox="0 0 24 24" width="11" height="11" fill="none">
                                        <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"
                                              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                    Сроки
                                </div>
                            </div>
                            <div class="org-fieldset">
                                <div class="org-fieldset-body" style="grid-template-columns: 1fr 1fr;">
                                    <div class="md3-field">
                                        <label asp-for="DateAct" class="md3-label">
                                            <span class="required-star">*</span>
                                            @Html.DisplayNameFor(m => m.DateAct)
                                        </label>
                                        <div class="md3-input-wrap">
                                            <div class="md3-input-icon">
                                                <svg viewBox="0 0 24 24" width="13" height="13" fill="none">
                                                    <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.7" />
                                                    <path d="M7 17l3.5-10L14 17M8.5 13h5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                                                </svg>
                                            </div>
                                            <input asp-for="DateAct" type="text" value="@Model?.DateAct?.ToString("yyyy-MM-dd")" class="md3-input" required />
                                        </div>
                                        <span asp-validation-for="DateAct" class="md3-validation-msg"></span>
                                    </div>
                                    <div class="md3-field">
                                        <label asp-for="DateSuspendedFrom" class="md3-label"></label>
                                        <div class="md3-input-wrap">
                                            <div class="md3-input-icon">
                                                <svg viewBox="0 0 24 24" width="13" height="13" fill="none">
                                                    <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.7" />
                                                    <path d="M7 17l3.5-10L14 17M8.5 13h5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                                                </svg>
                                            </div>
                                            <input asp-for="DateSuspendedFrom"
                                                   type="text"
                                                   value="@Model?.DateSuspendedFrom?.ToString("yyyy-MM-dd")"
                                                   class="md3-input"
                                                   required />
                                        </div>
                                        <span asp-validation-for="DateSuspendedFrom" class="md3-validation-msg"></span>
                                    </div>
                                    <div class="md3-field">
                                        <label asp-for="DateSuspendedUntil" class="md3-label"></label>
                                        <div class="md3-input-wrap">
                                            <div class="md3-input-icon">
                                                <svg viewBox="0 0 24 24" width="13" height="13" fill="none">
                                                    <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.7" />
                                                    <path d="M7 17l3.5-10L14 17M8.5 13h5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                                                </svg>
                                            </div>
                                            <input asp-for="DateSuspendedUntil"
                                                   type="text"
                                                   value="@Model?.DateSuspendedUntil?.ToString("yyyy-MM-dd")"
                                                   class="md3-input"
                                                   required />
                                        </div>
                                        <span asp-validation-for="DateSuspendedUntil" class="md3-validation-msg"></span>
                                    </div>
                                    <div class="md3-field">
                                        <label asp-for="DateRenewal" class="md3-label"></label>
                                        <div class="md3-input-wrap">
                                            <div class="md3-input-icon">
                                                <svg viewBox="0 0 24 24" width="13" height="13" fill="none">
                                                    <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.7" />
                                                    <path d="M7 17l3.5-10L14 17M8.5 13h5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                                                </svg>
                                            </div>
                                            <input asp-for="DateRenewal"
                                                   type="text"
                                                   value="@Model?.DateRenewal?.ToString("yyyy-MM-dd")"
                                                   class="md3-input" />
                                        </div>
                                        <span asp-validation-for="DateRenewal" class="md3-validation-msg"></span>
                                    </div>
                                </div>
                            </div>

                            @* 
                            <div>
                                <div class="org-section-badge create-bdg">
                                    <svg viewBox="0 0 24 24" width="11" height="11" fill="none">
                                        <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"
                                              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                    Приложения
                                </div>
                            </div>
                            <div class="org-fieldset">
                                <div class="org-fieldset-body">

                                    <div class="md3-field full-width-org">
                                        <label asp-for="FilesEntity" class="md3-label">
                                            <span class="required-star">*</span>
                                            @Html.DisplayNameFor(m => m.FilesEntity)
                                        </label>
                                        <div class="md3-input-wrap no-icon">
                                            <input asp-for="FilesEntity" type="file" class="md3-input" />
                                        </div>
                                        <span asp-validation-for="FilesEntity" class="md3-validation-msg"></span>
                                    </div>
                                </div>
                            </div>*@
                        </div>

                        @*  {{-- ══ ФУТЕР ══ --}} *@
                        <div class="org-footer" style="padding:10px 16px 14px;">
                            <a asp-controller="Acts" asp-action="@(backId > 0 ? "GetByContractId" : "Index")"
                               asp-route-id=@(backId > 0 ? @backId : null)
                               class="md3-btn md3-btn-ghost" style="padding:6px 14px; font-size:12px;">
                                <svg viewBox="0 0 24 24" width="13" height="13" fill="none">
                                    <path d="M19 12H5M12 5l-7 7 7 7"
                                          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                Отмена
                            </a>
                            <div class="org-footer-spacer"></div>
                            <button type="submit" class="md3-btn md3-primary-btn" style="padding:6px 16px; font-size:12px;">
                                <svg viewBox="0 0 24 24" width="13" height="13" fill="none">
                                    <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"
                                          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                    <path d="M17 21v-8H7v8M7 3v5h8"
                                          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                Сохранить
                            </button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script type="text/javascript">
        $(document).ready(function () {

            // 1. Управление значением чекбокса
            $("#checkActId").on("change", function () {
                $(this).val($(this).prop('checked') ? "true" : "false");
            });

            // 2. Инициализация календарей (datepicker)
            let datepickerOptions = {
                format: "d MM yyyy",
                language: "ru",
                calendarWeeks: true,
                autoclose: true,
                keyboardNavigation: false,
                assumeNearbyYear: true,
                toggleActive: true,
                todayHighlight: true
            };

            $("#DateAct").datepicker(datepickerOptions);

            $("#DateSuspendedFrom").datepicker(datepickerOptions).on('changeDate', function () {
                changeDateBeg();
            });

            $("#DateSuspendedUntil").datepicker(datepickerOptions).on('changeDate', function () {
                changeDateEnd();
            });

            $("#DateRenewal").datepicker(datepickerOptions).on('changeDate', function () {
                changeDateRenew();
            });

            // 3. Функции зависимости дат (используем нативные методы JS Date)
            function changeDateBeg() {
                let dateBeg = $("#DateSuspendedFrom").datepicker('getDate');
                let dateEnd = $("#DateSuspendedUntil").datepicker('getDate');
                let dateRenew = $("#DateRenewal").datepicker('getDate');

                if (dateBeg && !isNaN(dateBeg.getTime())) {
                    let datePlusOne = addDays(dateBeg, 1);
                    let datePlusTwo = addDays(dateBeg, 2);

                    if (dateEnd && dateBeg >= dateEnd) {
                        $("#DateSuspendedUntil").datepicker('update', datePlusOne);
                    }
                    if (dateRenew && dateBeg >= dateRenew) {
                        $("#DateRenewal").datepicker('update', datePlusTwo);
                    }
                }
            }

            function changeDateEnd() {
                let dateBeg = $("#DateSuspendedFrom").datepicker('getDate');
                let dateEnd = $("#DateSuspendedUntil").datepicker('getDate');
                let dateRenew = $("#DateRenewal").datepicker('getDate');

                if (dateEnd && !isNaN(dateEnd.getTime())) {
                    let datePlusOne = addDays(dateEnd, 1);
                    let dateDecOne = addDays(dateEnd, -1);

                    if (dateBeg && dateBeg >= dateEnd) {
                        $("#DateSuspendedFrom").datepicker('update', dateDecOne);
                    }
                    if (dateRenew && dateEnd >= dateRenew) {
                        $("#DateRenewal").datepicker('update', datePlusOne);
                    }
                }
            }

            function changeDateRenew() {
                let dateBeg = $("#DateSuspendedFrom").datepicker('getDate');
                let dateEnd = $("#DateSuspendedUntil").datepicker('getDate');
                let dateRenew = $("#DateRenewal").datepicker('getDate');

                if (dateRenew && !isNaN(dateRenew.getTime())) {
                    let dateDecTwo = addDays(dateRenew, -2);
                    let dateDecOne = addDays(dateRenew, -1);

                    if (dateBeg && dateBeg >= dateRenew) {
                        $("#DateSuspendedFrom").datepicker('update', dateDecTwo);
                    }
                    if (dateEnd && dateEnd >= dateRenew) {
                        $("#DateSuspendedUntil").datepicker('update', dateDecOne);
                    }
                }
            }

            // 4. Безопасный парсинг даты из формата "yyyy-MM-dd" (избегает сдвига часовых поясов)
            function parseISODate(isoString) {
                if (!isoString) return null;
                let parts = isoString.split('-');
                if (parts.length === 3) {
                    let year = parseInt(parts[0], 10);
                    let month = parseInt(parts[1], 10) - 1; // в JS месяцы начинаются с 0
                    let day = parseInt(parts[2], 10);
                    let date = new Date(year, month, day);
                    return isNaN(date.getTime()) ? null : date;
                }
                return null;
            }

            // 5. Идеально работающая функция добавления дней (поддерживает переходы месяцев/лет)
            function addDays(date, countDays) {
                if (!date || isNaN(date.getTime())) return null;
                let result = new Date(date);
                result.setDate(result.getDate() + countDays);
                return result;
            }

            // 6. Безопасная первоначальная установка значений (только если они есть в HTML)
            setupInitialDate("#DateAct");
            setupInitialDate("#DateSuspendedFrom");
            setupInitialDate("#DateSuspendedUntil");
            setupInitialDate("#DateRenewal");

            function setupInitialDate(selector) {
                let input = document.querySelector(selector);
                if (input && input.value) {
                    let parsedDate = parseISODate(input.value);
                    if (parsedDate) {
                        $(selector).datepicker("setDate", parsedDate);
                    }
                }
            }
        });
    </script>
}