@model MvcLayer.Models.ContractViewModel
@* @inject BusinessLayer.Interfaces.ContractInterfaces.IContractService Contract *@

@{
    // var contract = Model.GetById(Model.Id);
    ViewData["Title"] = $"Удаление контракта №{Model.Number}";
}
<div class="dm-overlay">
    <div class="dm-table">
        <div class="dm-cell">
            <div class="dm-modal" style="max-width:800px;">
                <div class="top-modal-block">
                    <label class="my-modal-title">@ViewData["Title"]</label>
                    @if (Model.IsEngineering != true)
                    {
                        <a asp-controller="Contracts" asp-action="Index" class="close-btn"></a>
                    }
                    else
                    {
                        <a asp-controller="Contracts" asp-action="Engineerings" class="close-btn"></a>
                    }
                </div>
                <hr class="modal-line" />
                <div>
                    <dl class="row">
                        <dt class="col-sm-4">
                            @Html.DisplayNameFor(model => model.Number)
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.Number)
                        </dd>
                        <dt class="col-sm-4">
                            @Html.DisplayNameFor(model => model.NameObject)
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.NameObject)
                        </dd>

                        <dt class="col-sm-4">
                            @Html.DisplayNameFor(model => model.Date)
                        </dt>
                        <dd class="col-sm-8">
                            @Model.Date?.ToShortDateString()
                        </dd>
                        <dt class="col-sm-4">
                           Заказчик
                        </dt>
                        <dd class="col-sm-8">
                            @Model.ContractOrganizations.FirstOrDefault(x => x.IsClient == true)?.Organization.Name
                        </dd>
                        <dt class="col-sm-4">
                            @Html.DisplayNameFor(model => model.DateBeginWork)
                        </dt>
                        <dd class="col-sm-8">
                            @Model.DateBeginWork?.ToShortDateString()
                        </dd>
                        <dt class="col-sm-4">
                            @Html.DisplayNameFor(model => model.DateEndWork)
                        </dt>
                        <dd class="col-sm-8">
                            @Model.DateEndWork?.ToShortDateString()
                        </dd>
                        <dt class="col-sm-4">
                            @Html.DisplayNameFor(model => model.ContractPrice)
                        </dt>
                        <dd class="col-sm-8">
                            @Model.ContractPrice.ToString("N2")
                        </dd>
                        <dt class="col-sm-4">
                            @Html.DisplayNameFor(model => model.Сurrency)
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.Сurrency)
                        </dd>
                       
                    </dl>
                </div>
                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <input asp-for="IsEngineering" type="hidden" />
                    <div class="btn_position mt-4">
                        <button type="submit" class="btn btn-danger">Удалить</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>