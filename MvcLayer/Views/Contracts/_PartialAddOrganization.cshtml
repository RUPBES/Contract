@model MvcLayer.Models.ContractViewModel
@{
    int index = 0;
    int indexFS = 0;
}

<div data-bs-backdrop="static" id="staticBackdrop" data-bs-keyboard="false" aria-labelledby="staticBackdropLabel" aria-hidden="false">
    <div>
        <div class="modal-content">
            <div class="org-modal" role="dialog" aria-modal="true"
                 aria-labelledby="editOrgTitle">
                <div class="org-header" style="border-bottom:1.5px solid var(--md3-outline); gap:10px;">
                    <div class="org-header-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none">
                            <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"
                                  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"
                                  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </div>
                    <div class="org-header-info">
                    </div>
                    <button type="button" class="btn-close" data-dismiss="modal" aria-label="Close" style="margin: 10px 0;">
                    </button>

                </div>
                <div id="existOrgId" style="padding-right: 20px; padding-left: 20px; width:350px;"></div>

                <form asp-controller="Contracts" asp-action="AddNewOrganization" id="theFormOrg" method="post" novalidate>
                    <input type="hidden" asp-for="EmployeeContracts[2].Employee.IsActive" value="true" />
                    <input asp-for="IsSubContract" hidden />
                    <input asp-for="SubContractId" type="number" hidden />
                    <input asp-for="IsAgreementContract" hidden />
                    <input asp-for="AgreementContractId" hidden />
                    <input asp-for="IsEngineering" hidden />

                    <input asp-for="Date" type="datetime" hidden />
                    <input asp-for="DateBeginWork" type="datetime" class="form-control" hidden>
                    <input asp-for="DateEndWork" type="datetime" hidden>
                    <input asp-for="EnteringTerm" type="datetime" hidden>
                    <input asp-for="ContractTerm" type="datetime" hidden>

                    <input asp-for="Number" hidden />
                    <input asp-for="FundingSource" hidden />
                    <input asp-for="NameObject" hidden />

                    <input asp-for="EmployeeContracts[0].EmployeeId" hidden />
                    <input asp-for="EmployeeContracts[1].EmployeeId" hidden />

                    <input asp-for="ContractOrganizations[0].OrganizationId" type="number" hidden />
                    <input asp-for="ContractOrganizations[1].OrganizationId" type="number" hidden />
                    <input asp-for="ContractOrganizations[2].OrganizationId" type="number" hidden />

                    <input asp-for="ContractPrice" hidden />
                    <input asp-for="Сurrency" hidden />
                    <input asp-for="TypeWorkContracts[0].TypeWorkId" hidden />
                    <input asp-for="PaymentСonditionsPrice" type="text" hidden>

                    @foreach (var item in Model.PaymentCA)
                    {
                        <input asp-for="PaymentCA[index]" hidden />
                        index++;
                    }
                    @foreach (var item in Model.FundingFS)
                    {
                        <input asp-for="FundingFS[indexFS]" hidden />
                        indexFS++;
                    }

                    <input asp-for="PaymentConditionsDaysRaschet" hidden />
                    <input asp-for="PaymentСonditionsRaschet" hidden />
                    <input asp-for="SelectionProcedures[0].TypeProcedure" hidden />

                    <div class="org-body" style="padding:12px 16px; gap:10px;">
                        @* {{-- ── Основные сведения ── --}} *@                        
        
                                                                  
                        <div class="org-fieldset">

                            <div class="org-fieldset-body">
                                <div class="md3-field full-width-org">
                                    <label asp-for="ContractOrganizations[3].Organization.Name" class="md3-label">
                                        <span class="required-star">*</span>
                                        @Html.DisplayNameFor(m => m.ContractOrganizations[3].Organization.Name)
                                    </label>
                                    <div class="md3-input-wrap">
                                        <div class="md3-input-icon">
                                            <svg viewBox="0 0 24 24" width="13" height="13" fill="none">
                                                <path d="M3 21h18M3 7v1a3 3 0 006 0V7m0 1a3 3 0 006 0V7m0 1a3 3 0 006 0V7H3l2-4h14l2 4z"
                                                      stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                                            </svg>
                                        </div>
                                        <input asp-for="ContractOrganizations[3].Organization.Name" class="md3-input" id="checkNameOrgId" placeholder="Полное наименование" />
                                    </div>
                                    <span asp-validation-for="ContractOrganizations[3].Organization.Name" class="md3-validation-msg"></span>
                                </div>
                                <div class="md3-field full-width-org">
                                    <label asp-for="ContractOrganizations[3].Organization.Abbr" class="md3-label">
                                        <span class="required-star">*</span>
                                        @Html.DisplayNameFor(m => m.ContractOrganizations[3].Organization.Abbr)
                                    </label>
                                    <div class="md3-input-wrap">
                                        <div class="md3-input-icon">
                                            <svg viewBox="0 0 24 24" width="13" height="13" fill="none">
                                                <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.7" />
                                                <path d="M7 17l3.5-10L14 17M8.5 13h5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                                            </svg>
                                        </div>
                                        <input asp-for="ContractOrganizations[3].Organization.Abbr" class="md3-input" placeholder="ОАО «Название»" />
                                    </div>
                                    <span asp-validation-for="ContractOrganizations[3].Organization.Abbr" class="md3-validation-msg"></span>
                                </div>
                                <div class="md3-field">
                                    <label asp-for="ContractOrganizations[3].Organization.Unp" class="md3-label">
                                        @Html.DisplayNameFor(m => m.ContractOrganizations[3].Organization.Unp)
                                    </label>
                                    <div class="md3-input-wrap no-icon">
                                        <input asp-for="ContractOrganizations[3].Organization.Unp" class="md3-input" placeholder="000000000" />
                                    </div>
                                    <span asp-validation-for="ContractOrganizations[3].Organization.Unp" class="md3-validation-msg"></span>
                                </div>

                                <div class="md3-field">
                                    <label asp-for="ContractOrganizations[3].Organization.Email" class="md3-label"></label>
                                    <div class="md3-input-wrap">
                                        <div class="md3-input-icon">
                                            <svg viewBox="0 0 24 24" width="13" height="13" fill="none">
                                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" stroke="currentColor" stroke-width="1.7" />
                                                <path d="M22 6l-10 7L2 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                                            </svg>
                                        </div>
                                        <input asp-for="ContractOrganizations[3].Organization.Email" type="email" class="md3-input" placeholder="office@company.by" />
                                    </div>
                                    <span asp-validation-for="ContractOrganizations[3].Organization.Email" class="md3-validation-msg"></span>
                                </div>

                                <div class="md3-field">
                                    <label class="md3-label">Телефон</label>
                                    <div class="md3-input-wrap">
                                        <div class="md3-input-icon">
                                            <svg viewBox="0 0 24 24" width="13" height="13" fill="none">
                                                <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"
                                                      stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                                            </svg>
                                        </div>
                                        <input asp-for="ContractOrganizations[3].Organization.Phones[0].Number"
                                               class="md3-input phone-number-pattern-fill"
                                               placeholder="+375335555555"
                                               pattern="8[0-9]{3} [0-9]{3}-[0-9]{2}-[0-9]{2}" />
                                    </div>
                                    <span asp-validation-for="ContractOrganizations[3].Organization.Phones[0].Number" class="md3-validation-msg"></span>
                                </div>

                                <div class="md3-field">
                                    <label asp-for="ContractOrganizations[3].Organization.Addresses[0].SiteAddress" class="md3-label">Сайт</label>
                                    <div class="md3-input-wrap">
                                        <div class="md3-input-icon">
                                            <svg viewBox="0 0 24 24" width="13" height="13" fill="none">
                                                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.7" />
                                                <path d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10A15.3 15.3 0 0112 2z"
                                                      stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                                            </svg>
                                        </div>
                                        <input asp-for="ContractOrganizations[3].Organization.Addresses[0].SiteAddress" class="md3-input" placeholder="http://www.company.by" />
                                    </div>
                                    <span asp-validation-for="ContractOrganizations[3].Organization.Addresses[0].SiteAddress" class="md3-validation-msg"></span>
                                </div>



                                @* {{-- ── Реквизиты + Адреса (одна строка) ── --}} *@
                                <div class="md3-field">
                                    <label asp-for="ContractOrganizations[3].Organization.Addresses[0].PostIndex" class="md3-label"></label>
                                    <div class="md3-input-wrap no-icon">
                                        <input asp-for="ContractOrganizations[3].Organization.Addresses[0].PostIndex" class="md3-input" placeholder="220000" />
                                    </div>
                                    <span asp-validation-for="ContractOrganizations[3].Organization.Addresses[0].PostIndex" class="md3-validation-msg"></span>
                                </div>
                                <div class="md3-field full-width-org">
                                    <label asp-for="ContractOrganizations[3].Organization.PaymentAccount" class="md3-label"></label>
                                    <div class="md3-input-wrap">
                                        <div class="md3-input-icon">
                                            <svg viewBox="0 0 24 24" width="13" height="13" fill="none">
                                                <path d="M21 4H3a2 2 0 00-2 2v12a2 2 0 002 2h18a2 2 0 002-2V6a2 2 0 00-2-2zM1 10h22"
                                                      stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                                            </svg>
                                        </div>
                                        <input asp-for="ContractOrganizations[3].Organization.PaymentAccount" type="text"
                                               class="md3-input monospace ac" id="ac"
                                               placeholder="BY20-OLMP-3135-0000-0010-0000-0933" />
                                    </div>
                                    <span asp-validation-for="ContractOrganizations[3].Organization.PaymentAccount" class="md3-validation-msg"></span>
                                </div>

                                <div class="md3-field full-width-org">
                                    <label asp-for="ContractOrganizations[3].Organization.Addresses[0].FullAddress" class="md3-label">
                                        <span class="required-star">*</span>
                                        @Html.DisplayNameFor(m => m.ContractOrganizations[3].Organization.Addresses[0].FullAddress)
                                    </label>
                                    <div class="md3-input-wrap no-icon">
                                        <input asp-for="ContractOrganizations[3].Organization.Addresses[0].FullAddress" class="md3-input" placeholder="Юридический адрес" />
                                    </div>
                                    <span asp-validation-for="ContractOrganizations[3].Organization.Addresses[0].FullAddress" class="md3-validation-msg"></span>
                                </div>

                                <div class="md3-field full-width-org">
                                    <label asp-for="ContractOrganizations[3].Organization.Addresses[0].FullAddressFact" class="md3-label"></label>
                                    <div class="md3-input-wrap no-icon">
                                        <input asp-for="ContractOrganizations[3].Organization.Addresses[0].FullAddressFact" class="md3-input" placeholder="Фактический адрес" />
                                    </div>
                                    <span asp-validation-for="ContractOrganizations[3].Organization.Addresses[0].FullAddressFact" class="md3-validation-msg"></span>
                                </div>


                            </div>
                        </div>
                        @*Добавляем отдел со значением NULL*@
                        <input asp-for="ContractOrganizations[3].Organization.Departments[0].Name" value="@string.Empty" hidden />


                    </div>



                    @*  {{-- ══ ФУТЕР ══ --}} *@
                    <div class="org-footer" style="padding:10px 16px 14px;">
                        <button class="md3-btn md3-primary-btn" type="button" id="searchButton" style="width: 100%;min-width: fit-content;">
                            Проверить наличие
                        </button>
                        <div class="org-footer-spacer"></div>
                        <button type="button" id="submitForm" hidden class="md3-btn md3-primary-btn">
                            <svg viewBox="0 0 24 24" width="13" height="13" fill="none">
                                <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"
                                      stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                <path d="M17 21v-8H7v8M7 3v5h8"
                                      stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            Сохранить
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $('button.btn-close').click(function () {
        $('#modDialog').modal('hide');
    });

    $("#searchButton").click(function (e) {
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("FindDuplicates", "Organizations")',
                    dataType: 'json',
                    data: { orgName: $("#checkNameOrgId").val() },
                    success: function (resultChecking) {
                         $("#existOrgId").html('');
                        if (resultChecking.length > 0) {
                            let count = 0;
                            $.each(resultChecking, function (index, value) {
                                $("#existOrgId").append('<span class="text-secondary">' + value.name  +'</span><br /><br />');
                                count++;
                            });
                            $("#existOrgId").prepend('<h5 class="text-danger"> Найдено ' + count  +' совпадений с таким названием</h5>');
                        }
                        else {
                            $("#submitForm").attr('type','submit');
                            $("#submitForm").removeAttr("hidden");
                            $("#existOrgId").prepend('<h5 class="text-secondary"> Совпадений не найдено</h5><br />');
                        }
                    },
                    error: function (ex) {
                        alert('Ошибка поиска');
                    }
                });
            });
</script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>