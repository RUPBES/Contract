@using BusinessLayer.Enums;
@using BusinessLayer.Interfaces.Shared
@model MvcLayer.Models.ContractViewModel
@inject BusinessLayer.Interfaces.ContractInterfaces.IOrganizationService Organization
@inject BusinessLayer.Interfaces.ContractInterfaces.IEmployeeService Employee
@inject IConverterService Converter
@inject BusinessLayer.Interfaces.ContractInterfaces.ITypeWorkService TypeWork

@{
    string title = "Договор";
    string organizationLabel = "Заказчик";
    string workTypeLabel = "Вид работ";
    if (Model.IsAgreementContract)
    {
        title = "Соглашение с филиалом";
        organizationLabel = "Филиал";
    }
    else if (Model.IsEngineering)
    {
        title = "Договор на инжиниринговые услуги";
        workTypeLabel = "Вид услуг";
    }
    else if (Model.IsSubContract)
    {
        title = "Субподрядный договор";
        organizationLabel = "Субподрядчик";
    }
}

<div class="dm-overlay">
    <div class="dm-table">
        <div class="dm-cell">
            <div class="dm-modal" style="max-width:1100px;">
                <div class="top-modal-block">
                    <h2 style="text-align: center;">@title</h2>
                    @if ((bool)Model.IsAgreementContract && Model.AgreementContractId != null)
                    {
                        <a class="close-btn" asp-action="Details" asp-route-id="@Model.AgreementContractId"></a>
                    }
                    else if ((bool)Model.IsSubContract && Model.SubContractId != null)
                    {
                        <a class="close-btn" asp-action="Details" asp-route-id="@Model.SubContractId"></a>
                    }
                    else
                    {
                        <a class="close-btn" asp-action="Index"></a>
                    }
                    @* <a class="close-btn" onclick="window.history.go(-1)"></a> *@
                </div>

                <div id="modDialog" class="modal fade" style="background: rgba(0, 0, 0, 0.65);">
                    <div id="dialogContent" class="modal-dialog modal-dialog-centered" role="document"></div>
                </div>

                <form class="row align-content-start" asp-action="Create" method="post" id="MainForm" enctype="multipart/form-data">
                    <input asp-for="IsAgreementContract" value="@Model.IsAgreementContract" hidden />
                    <input asp-for="IsEngineering" value="@Model.IsEngineering" hidden />
                    <input asp-for="IsSubContract" value="@Model.IsSubContract" hidden />
                    <input asp-for="AgreementContractId" hidden />
                    <input asp-for="SubContractId" hidden />
                    <input asp-for="Author" hidden />
                    <input asp-for="Owner" hidden />

                    <div class="col-4">
                        <div class="row">
                            <div class="col-12">
                                <label asp-for="Number" class="control-label" for="NumDC"></label>
                                <div class="input-group">
                                    <div class="input-group-text">№</div>
                                    <input asp-for="Number" class="form-control" required id="NumDC">
                                    <button class="btn btn-warning" type="button" id="searchButton"><img src="/icons/search.svg" title="Проверить, существует ли договор с таким номером"></button>
                                </div>
                            </div>
                            @if (Model.IsEngineering == true)
                            {
                                <div class="col-12 mt-3">
                                    <label asp-for="Date" class="control-label" for="DateDC"></label>
                                    <div class="input-group">
                                        <div class="input-group-text"><img src="~/icons/calendar-date.svg" /></div>
                                        <input asp-for="Date" type="text" class="form-control" required id="DateDC">
                                    </div>
                                </div>
                                <div class="form-group mt-3">
                                    <label for="CDC">Стоимость оказания услуг</label>
                                    <div class="input-group">
                                        <div class="input-group-text"><img src="~/icons/cash-coin.svg" /></div>
                                        <input asp-for="ContractPrice" type="text" class="form-control cost" id="CDC">
                                    </div>
                                </div>
                                <div class="form-group mt-3">
                                    <label asp-for="PaymentСonditionsPrice"></label>
                                    <input asp-for="PaymentСonditionsPrice" maxlength="5" type="text" class="form-control cost">
                                </div>
                            }

                            @*Орагнизации *********@
                            <div class="col-12 mt-3">
                                <fieldset class="border rounded-3 p-3">
                                    <legend class="float-none w-auto px-3">
                                        <a asp-action="AddOrganization" id="addOrganization" class="btn btn-sm btn-success">
                                            <img src="~/icons/house-add.svg" />
                                            Добавить новую организацию
                                        </a>
                                    </legend>


                                    <div class="col-12">
                                        <label>@organizationLabel</label>
                                        <input name="ContractOrganizations[0].IsClient" type="checkbox" value="true" checked selected hidden>
                                        <select name="ContractOrganizations[0].OrganizationId" class="form-control js-chosen" id="selectOrgOne">
                                            @if (Model?.ContractOrganizations[0].OrganizationId > 0)
                                            {
                                                var item = Organization.GetById((int)Model?.ContractOrganizations[0].OrganizationId);
                                                <option selected value="@item?.Id">@item?.Name</option>
                                            }
                                            @if (Model?.ContractOrganizations[0].OrganizationId == 0)
                                            {
                                                <option value="null" selected>Выберите организацию</option>
                                            }

                                            @foreach (var item in Organization.GetAll())
                                            {
                                                <option value="@item.Id">@item.Name</option>
                                            }
                                        </select>
                                    </div>
                                    @if (Model.IsEngineering || (bool)Model.IsSubContract || (bool)Model.IsAgreementContract)
                                    {
                                        <input name="ContractOrganizations[1].Organization" hidden />
                                        <input name="ContractOrganizations[2].Organization" hidden />
                                        <input name="ContractOrganizations[3].Organization" hidden />
                                    }
                                    @if (!Model.IsEngineering && !(bool)Model.IsSubContract && !(bool)Model.IsAgreementContract)
                                    {
                                        <div class="col-12">
                                            <label>Генподрядчик</label>
                                            <input name="ContractOrganizations[1].IsGenContractor" type="checkbox" value="true" checked selected hidden>
                                            <select name="ContractOrganizations[1].OrganizationId" class="form-control js-chosen slt-add-organization" id="selectOrgTwo">
                                                @if (Model?.ContractOrganizations[1].OrganizationId > 0)
                                                {
                                                    var item = Organization.GetById((int)Model?.ContractOrganizations[1]?.OrganizationId);
                                                    <option selected value="@item?.Id">@item?.Name</option>
                                                }
                                                @if (Model?.ContractOrganizations[1].OrganizationId == 0)
                                                {
                                                    <option value="null" selected>Выберите организацию</option>
                                                }
                                                @foreach (var item in Organization.GetAll())
                                                {
                                                    <option value="@item.Id">@item.Name</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-12">
                                            <label>Ответственный за производство работ</label>
                                            <input name="ContractOrganizations[2].IsResponsibleForWork" type="checkbox" value="true" checked selected hidden>
                                            <select name="ContractOrganizations[2].OrganizationId" class="form-control js-chosen slt-add-organization" id="selectOrgThree">
                                                @if (Model?.ContractOrganizations[2].OrganizationId > 0)
                                                {
                                                    var item = Organization.GetById((int)Model?.ContractOrganizations[2]?.OrganizationId);
                                                    <option selected value="@item?.Id">@item?.Name</option>
                                                }
                                                @if (Model?.ContractOrganizations[2].OrganizationId == 0)
                                                {
                                                    <option value="null" selected>Выберите организацию</option>
                                                }
                                                @foreach (var item in Organization.GetAll())
                                                {
                                                    <option value="@item.Id">@item.Name</option>
                                                }
                                            </select>
                                        </div>
                                        <input name="ContractOrganizations[3].Organization" hidden />
                                    }


                                </fieldset>
                            </div>

                            @if (!Model.IsEngineering)
                            {
                                <div class="col-12 mt-3" id="EmployeeFieldSet">
                                    <fieldset class="border rounded-3 p-3">
                                        <legend class="float-none w-auto px-3">
                                            <a asp-action="AddEmployee" id="addEmployee" class="btn btn-sm btn-success">
                                                <img src="~/icons/person-plus.svg" />
                                                Добавить нового сотрудника
                                            </a>
                                        </legend>
                                        <div class="col-12">
                                            <label>Подписант договора</label>
                                            <input name="EmployeeContracts[0].IsSignatory" type="checkbox" value="true" checked selected hidden>
                                            <select name="EmployeeContracts[0].EmployeeId" class="form-control js-chosen" id="selectEmpOne">
                                                @if (Model?.EmployeeContracts[0].EmployeeId > 0)
                                                {
                                                    var item = Employee.GetById(Model.EmployeeContracts[0].EmployeeId);
                                                    <option selected value="@item?.Id">@item?.FullName</option>
                                                }
                                                @if (Model?.EmployeeContracts[0].EmployeeId == 0)
                                                {
                                                    <option value="null" selected>Выберите сотрудника</option>
                                                }

                                                @foreach (var item in Employee.Find(x => x.IsActive == true))
                                                {
                                                    <option value="@item.Id">@item.FullName</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-12">
                                            <label>Ответственный за ведение договора</label>
                                            <input name="EmployeeContracts[1].IsResponsible" type="checkbox" value="true" checked selected hidden>
                                            <select name="EmployeeContracts[1].EmployeeId" class="form-control js-chosen" id="selectEmpTwo">
                                                @if (Model?.EmployeeContracts[1].EmployeeId > 0)
                                                {
                                                    var item = Employee.GetById(Model.EmployeeContracts[1].EmployeeId);
                                                    <option selected value="@item?.Id">@item?.FullName</option>
                                                }
                                                @if (Model?.EmployeeContracts[1].EmployeeId == 0)
                                                {
                                                    <option value="null" selected>Выберите сотрудника</option>
                                                }
                                                @foreach (var item in Employee.Find(x => x.IsActive == true))
                                                {
                                                    <option value="@item.Id">@item.FullName</option>
                                                }
                                            </select>
                                        </div>
                                        <input name="EmployeeContracts[2].Employee" hidden />
                                    </fieldset>
                                </div>
                            }
                            @if (Model.IsEngineering)
                            {
                                <input name="EmployeeContracts[0].Employee" hidden />
                                <input name="EmployeeContracts[1].Employee" hidden />
                                <input name="EmployeeContracts[2].Employee" hidden />
                            }
                            <div class="col-12 mt-3">
                                <fieldset class="border rounded-3 p-3">
                                    <legend class="float-none w-auto px-3">
                                        <a asp-action="AddTypeWork" id="addTypeWork" class="btn btn-sm btn-success">
                                            <img src="~/icons/house-add.svg" />
                                            Добавить новый @(Model.IsEngineering ? "вид услуг" : "вид работ")
                                        </a>
                                    </legend>
                                    <div class="col-12">
                                        <label>@workTypeLabel</label>
                                        <input name="TypeWorkContracts[0].TypeWork" hidden />
                                        <select name="TypeWorkContracts[0].TypeWorkId" class="form-control js-chosen slt-add-organization">
                                            @if (Model?.TypeWorkContracts[0] is not null)
                                            {
                                                var item = TypeWork.GetById((int)Model?.TypeWorkContracts[0].TypeWorkId);
                                                <option selected value="@item?.Id">@item?.Name</option>
                                            }
                                            @if (Model?.TypeWorkContracts[0] is null)
                                            {
                                                <option selected>Выберите @(Model.IsEngineering ? "вид услуг" : "вид работ")</option>
                                            }

                                            @foreach (var item in TypeWork.GetAll())
                                            {
                                                <option value="@item.Id">@item.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <input name="TypeWorkContracts[1].TypeWork" hidden />
                                </fieldset>
                            </div>
                        </div>
                    </div>

                    <div class="col-4">
                        @if (!Model.IsEngineering)
                        {
                            <div class="col-12">
                                <label asp-for="Date" class="control-label" for="DateDC"></label>
                                <div class="input-group">
                                    <div class="input-group-text"><img src="~/icons/calendar-date.svg" /></div>
                                    <input asp-for="Date" type="text" class="form-control" required id="DateDC">
                                </div>
                            </div>
                            <div class="form-group">
                                <label asp-for="ContractPrice" for="CDC"></label>
                                <div class="input-group">
                                    <div class="input-group-text"><img src="~/icons/cash-coin.svg" /></div>
                                    <input name="ContractPrice" value="@Model.ContractPrice" type="text" class="form-control" id="CDC">
                                </div>
                            </div>
                        }

                        <div class="col-12">
                            <label asp-for="NameObject" class="control-label"></label>
                            <textarea asp-for="NameObject" class="form-control" rows="2" required="@(!Model.IsSubContract && !Model.IsAgreementContract && !Model.IsOneOfMultiple)" disabled="@(Model.IsSubContract || Model.IsAgreementContract)"></textarea>
                        </div>

                        <fieldset class="border rounded-1 p-3">
                            <legend class="float-none w-auto px-3">Условия авансирования</legend>
                            @{
                                int numberCheckbox = 0;
                            }
                            @foreach (var item in Enum.GetValues<PrepaymentCondition>())
                            {
                                var value = $"{Converter.ToPrepaymentConditionTerm((int)item)}";
                                var valueArray = Model?.PaymentCA?.Where(element => element == value)?.FirstOrDefault();
                                string idCh = "check" + @numberCheckbox;

                                <div>
                                    <div class="input-group mb-3">
                                        <div class="input-group-prepend">
                                            <div class="input-group-text" style="display: block;">
                                                @if (valueArray is not null)
                                                {
                                                    <input type="checkbox" name="PaymentCA" id="@idCh" value="@value" checked>
                                                }
                                                @if (valueArray is null)
                                                {
                                                    <input type="checkbox" name="PaymentCA" id="@idCh" value="@value">
                                                }
                                            </div>
                                        </div>
                                        <input type="text" class="form-control" value="@value" disabled>
                                    </div>
                                </div>
                                numberCheckbox++;
                            }
                        </fieldset>


                        <fieldset class="border rounded-3 p-3">
                            <legend class="float-none w-auto px-3">Процедура выбора</legend>
                            @foreach (var item in Enum.GetValues<Procedure>())
                            {
                                var name = $"{Converter.ToProcedureType((int)item)}";
                                int numberEnum = (int)item;
                                var procedure = Model?.SelectionProcedures?[0].TypeProcedure;
                                <div>
                                    <div class="input-group mb-3">
                                        <div class="input-group-prepend">
                                            <div class="input-group-text" style="display: block;">

                                                @if (procedure is not null && procedure?.Equals(name, StringComparison.OrdinalIgnoreCase) == true)
                                                {
                                                    <input type="radio" name="SelectionProcedures[0].TypeProcedure" value="@name" checked>
                                                }

                                                @if ((procedure is null || procedure?.Equals(name, StringComparison.OrdinalIgnoreCase) == false) && numberEnum == 0)
                                                {
                                                    <input type="radio" name="SelectionProcedures[0].TypeProcedure" value="@name" checked>
                                                }

                                                @if ((procedure is null || procedure?.Equals(name, StringComparison.OrdinalIgnoreCase) == false) && numberEnum != 0)
                                                {
                                                    <input type="radio" name="SelectionProcedures[0].TypeProcedure" value="@name">
                                                }

                                            </div>
                                        </div>
                                        <input type="text" class="form-control" value="@name" disabled>
                                    </div>
                                </div>
                            }
                        </fieldset>

                        @if (!Model.IsEngineering && !Model.IsAgreementContract && !Model.IsSubContract)
                        {
                            <div class="col-12 mt-2">
                                <div class="input-group mb-2">
                                    <div class="input-group-prepend">
                                        <div class="input-group-text" style="display: block;">
                                            <input type="checkbox" asp-for="IsMultiple">
                                        </div>
                                    </div>
                                    <input style="font-weight: bold;" type="text" class="form-control" value="Имеются подобъекты?" disabled>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="col-4">
                        <div class="form-group">
                            <label asp-for="Сurrency" for="CurDC"></label>
                            <div class="input-group">
                                <div class="input-group-text" style="max-width:10%; padding: 3px;">
                                    <img style="height: 22px;" src="~/icons/currency-exchange.svg" />
                                </div>
                                <select name="Сurrency" class="form-control js-chosen" id="CurDC">
                                    @if (Model?.Сurrency is null)
                                    {
                                        <option value=@null selected>Выбрать валюту</option>
                                    }
                                    @if (Model?.Сurrency is not null)
                                    {
                                        <option selected value="@Model?.Сurrency">@Model?.Сurrency</option>
                                    }
                                    @foreach (var item in Enum.GetValues<Currency>())
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <fieldset class="border rounded-3 p-3">
                            <legend class="float-none w-auto px-3">Сроки</legend>
                            <label class="control-label" asp-for="DateBeginWork"></label>
                            <input asp-for="DateBeginWork" type="text" class="form-control" required id="DateBeginWork">
                            <label class="form-label" id="labelBeginWork" style="display:none"></label>

                            <label class="control-label" asp-for="DateEndWork"></label>
                            <input asp-for="DateEndWork" type="text" class="form-control" required id="DateEndWork">
                            <label class="form-label" id="labelEndWork" style="display:none"></label>

                            @if (!Model.IsEngineering)
                            {
                                <label class="control-label" asp-for="EnteringTerm"></label>
                                <input asp-for="EnteringTerm" type="text" class="form-control" required id="EnteringTerm">
                                <label class="form-label" id="labelEnteringTerm" style="display:none"></label>

                                <label class="control-label" asp-for="ContractTerm" hidden></label>
                                <input asp-for="ContractTerm" type="text" class="form-control" hidden id="ContractTerm">
                                @* <label class="form-label" id="labelContractTerm" style="display:none"></label> *@
                            }
                        </fieldset>

                        <fieldset class="border rounded-1 p-3">
                            <legend class="float-none w-auto px-3">Источник финансирования</legend>
                            @foreach (var item in Enum.GetValues<FundingSource>())
                            {
                                var value = $"{Converter.ToFundingSourceTerm((int)item)}";
                                var valueArray = Model?.FundingFS?.Where(element => element == value)?.FirstOrDefault();

                                <div>
                                    <div class="input-group mb-3">
                                        <div class="input-group-prepend">
                                            <div class="input-group-text" style="display: block;">
                                                @if (valueArray is not null)
                                                {
                                                    <input type="checkbox" name="FundingFS" value="@value" checked>
                                                }
                                                @if (valueArray is null)
                                                {
                                                    <input type="checkbox" name="FundingFS" value="@value">
                                                }
                                            </div>
                                        </div>
                                        <input type="text" class="form-control" value="@value" disabled>
                                    </div>
                                </div>
                            }
                        </fieldset>
                    </div>

                    <div class="col-8 mt-1 fieldset_container">
                        <fieldset class="border rounded-1 p-3 fieldset_mr">
                            <legend class="float-none w-auto px-3">Расчет за выполненные @(Model.IsEngineering ? "услуги" : "работы")</legend>
                            @foreach (var item in Enum.GetValues<Payment>())
                            {
                                var name = $"{Converter.ToPaymentTerm((int)item, Model.IsEngineering)}";
                                bool hasMatchingPaymentTerm = Model?.PaymentСonditionsRaschet?.Equals(name, StringComparison.OrdinalIgnoreCase) ?? false;

                                <div class="input-group mb-2">
                                    <div class="input-group-prepend">
                                        <div class="input-group-text" style="display: block;">
                                            @if (Model?.PaymentСonditionsRaschet is not null && hasMatchingPaymentTerm)
                                            {
                                                <input class="checkChoise" type="radio" name="PaymentСonditionsRaschet" value="@name" checked>
                                            }
                                            @if (Model?.PaymentСonditionsRaschet is null || !hasMatchingPaymentTerm)
                                            {
                                                <input class="checkChoise" type="radio" name="PaymentСonditionsRaschet" value="@name">
                                            }
                                        </div>
                                    </div>
                                    @if (Model?.PaymentConditionsDaysRaschet > 0 && hasMatchingPaymentTerm)
                                    {
                                        <div class="col-1" id="inpValueRaschet"><input type="number" name="PaymentConditionsDaysRaschet" class="form-control" value="@Model?.PaymentConditionsDaysRaschet.Value" min="1"></div>
                                    }
                                    <div class="col-9">
                                        <input type="text" class="form-control" value="@name" disabled>
                                    </div>
                                </div>
                            }
                        </fieldset>
                        <button type="submit" class="btn btn-primary btn_fieldset" id="subBtn">Сохранить</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/creationContractFunc.js"></script>
    <script type="text/javascript">
        $(function ($) {
            var allCost = $(".cost")
            for (let el of allCost) {
                digits_float(el)
            }
            $('body').on('input', '.cost', function (e) {
                digits_float(this);
            });
            $('body').on('input', '#CDC', function (e) {
                digits_float(this);
            });
            digits_float('#CDC');
        });

        $(document).ready(function () {

            const styleName = "border:solid 1px red !important;background-color: rgba(255, 0, 0, 0.1);";
            checkTwoSelectValues("#selectEmpOne", "#selectEmpTwo", "#EmployeeFieldSet", "#subBtn", styleName);
            checkTwoSelectValues("#selectEmpTwo", "#selectEmpOne", "#EmployeeFieldSet", "#subBtn", styleName);

            checkThreeSelectValuesWithChosenStyle("#selectOrgOne", "#selectOrgTwo", "#selectOrgThree", "#subBtn");

            $(".checkChoise").click(function (e) {
                let elemNumber = $("#dayInput");
                $("#inpValueRaschet").remove();
                if (elemNumber !== null || elemNumber !== undefined) {
                    $("#dayInput").parent().remove();
                }

                $(this).parent().parent().last().after(`<div class='col-1'><input class='form-control' id="dayInput" type='number' name='PaymentConditionsDaysRaschet' min='1'></div>`);
            });

            $("#searchButton").click(function (e) {
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("ExistContractByNumber", "Contracts")',
                    dataType: 'json',
                    data: { contractNumber: $("#NumDC").val() },
                    success: function (resultChecking) {
                        if (resultChecking) {
                            alert(`Договор с таким номером уже создан`)
                        }
                        else {
                            alert(`Договор с таким номером не найден`)
                        }
                    },
                    error: function (ex) {
                        alert('Ошибка поиска');
                    }
                });
            });

            $("#addOrganization").click(function (e) {
                e.preventDefault();
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("AddOrganization", "Contracts")',
                    dataType: 'html',
                    data: $("#MainForm").serialize(),
                    success: (function (result) {
                        $('#dialogContent').html(result);
                        $('#modDialog').modal({ backdrop: false });
                        $('#modDialog').modal('show');
                    })
                });
            });

            $("#addEmployee").click(function (e) {
                e.preventDefault();
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("AddEmployee", "Contracts")',
                    dataType: 'html',
                    data: $("#MainForm").serialize(),
                    success: (function (result) {
                        $('#dialogContent').html(result);
                        $('#modDialog').modal({ backdrop: false });
                        $('#modDialog').modal('show');
                    })
                });
            });

            $("#addTypeWork").click(function (e) {
                e.preventDefault();
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("AddTypeWork", "Contracts")',
                    dataType: 'html',
                    data: $("#MainForm").serialize(),
                    success: (function (result) {
                        $('#dialogContent').html(result);
                        $('#modDialog').modal({ backdrop: false });
                        $('#modDialog').modal('show');
                    })
                });
            });
        });
    </script>
}