@using BusinessLayer.Helpers;
@using BusinessLayer.Models
@using BusinessLayer.Models.KDO
@model ScopeWorkReportModel
@{
    var ownForm = Model.Scopes.ContainsKey("formOwn");
    var ownScope = Model.Scopes.ContainsKey("scopeOwn");
    var cost_column = ownForm || ownScope ? "cost-summary__column-l" : "cost-summary__column-s";
    var price_column = ownForm || ownScope ? "price-breakdown__column-l" : "price-breakdown__column-s";
    ViewData["Title"] = $"Объем работ";
}

<div class="dm-overlay">
    <div class="dm-table">
        <div class="dm-cell">
            <div class="dm-modal">
                <div class="top-modal-block">
                    <h2 style="text-align: center;">@ViewData["Title"]</h2>
                    <div style="color:red; font-weight:700;">@ViewBag.AmendmentInfo</div>
                    <a onclick="history.go(-1)" class="close-btn"></a>
                </div>
                <hr class="modal-line" />
                <div style="display:grid; height:100%; max-height: 600px;">
                    <div class="scp-container">
                        <div class="cost-summary">
                            <div class="@cost_column">
                                <div class="cost-summary__column-header">Объем работ</div>
                                <div class="cost-summary__list title">
                                    <div class="cost-summary__list-item">План</div>
                                </div>
                                <div class="cost-summary__list title">
                                    <div class="cost-summary__list-item">Факт</div>
                                </div>
                                @if (ownScope)
                                {
                                    <div class="cost-summary__list title">
                                        <div class="cost-summary__list-item">План соб. силами</div>
                                    </div>
                                }
                                @if (ownForm)
                                {
                                    <div class="cost-summary__list title">
                                        <div class="cost-summary__list-item">Факт соб. силами</div>
                                    </div>
                                }
                            </div>
                            <div class="@cost_column">

                                <div class="cost-summary__column-header">Вид работ</div>
                                <div class="cost-summary__list category">
                                    @foreach (var item in Model.Scopes["scope"])
                                    {
                                        <div class="cost-summary__list-item">@item.WorkType</div>
                                    }

                                </div>
                                <div class="cost-summary__list category">
                                    @foreach (var item in Model.Scopes["form"])
                                    {
                                        <div class="cost-summary__list-item">@item.WorkType</div>
                                    }

                                </div>

                                @if (ownScope)
                                {
                                    <div class="cost-summary__list category">
                                        @foreach (var item in Model.Scopes["scopeOwn"])
                                        {
                                            <div class="cost-summary__list-item">@item.WorkType</div>
                                        }
                                    </div>
                                }

                                @if (ownForm)
                                {
                                    <div class="cost-summary__list category">
                                        @foreach (var item in Model.Scopes["formOwn"])
                                        {
                                            <div class="cost-summary__list-item">@item.WorkType</div>
                                        }
                                    </div>
                                }

                            </div>
                            <div class="@cost_column">
                                <div class="cost-summary__column-header">Стоимость работ</div>
                                <div class="cost-summary__list scp-price">
                                    @foreach (var item in Model.Scopes["scope"])
                                    {
                                        <div class="cost-summary__list-item">@item.Price.ToString("N2")</div>
                                    }
                                </div>
                                <div class="cost-summary__list scp-price">
                                    @foreach (var item in Model.Scopes["form"])
                                    {
                                        <div class="cost-summary__list-item">@item.Price.ToString("N2")</div>
                                    }
                                </div>

                                @if (ownScope)
                                {
                                    <div class="cost-summary__list scp-price">
                                        @foreach (var item in Model.Scopes["scopeOwn"])
                                        {
                                            <div class="cost-summary__list-item">@item.Price.ToString("N2")</div>
                                        }
                                    </div>
                                }
                                @if (ownForm)
                                {
                                    <div class="cost-summary__list scp-price">
                                        @foreach (var item in Model.Scopes["formOwn"])
                                        {
                                            <div class="cost-summary__list-item">@item.Price.ToString("N2")</div>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="@cost_column">
                                <div class="cost-summary__column-header">Выполнено на 01.01 тек.года</div>
                                <div class="cost-summary__list scp-price">
                                    @foreach (var item in Model.Scopes["scope"])
                                    {
                                        <div class="cost-summary__list-item">@item.CompletedBeforeYear?.ToString("N2")</div>
                                    }
                                </div>
                                <div class="cost-summary__list scp-price">
                                    @foreach (var item in Model.Scopes["form"])
                                    {
                                        <div class="cost-summary__list-item">@item.CompletedBeforeYear?.ToString("N2")</div>
                                    }
                                </div>

                                @if (ownScope)
                                {
                                    <div class="cost-summary__list scp-price">
                                        @foreach (var item in Model.Scopes["scopeOwn"])
                                        {
                                            <div class="cost-summary__list-item">@item.CompletedBeforeYear?.ToString("N2")</div>
                                        }
                                    </div>
                                }
                                @if (ownForm)
                                {
                                    <div class="cost-summary__list scp-price">
                                        @foreach (var item in Model.Scopes["formOwn"])
                                        {
                                            <div class="cost-summary__list-item">@item.CompletedBeforeYear?.ToString("N2")</div>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="@cost_column">
                                <div class="cost-summary__column-header">Остаток по выполнению</div>
                                <div class="cost-summary__list scp-price">
                                    @*  @foreach (var item in Model.Scopes["scope"])
                                    {
                                        <div class="cost-summary__list-item">@item.Remaining?.ToString("N2")</div>
                                    } *@
                                    @for (int i = 0; i < Model.Scopes["scope"].Count; i++)
                                    {
                                        <div class="cost-summary__list-item">
                                            @((Model.Scopes["scope"][i].Price - Model.Scopes["form"][i].Price).ToString("N2"))
                                        </div>
                                    }

                                </div>
                                <div class="cost-summary__list scp-price">
                                    @foreach (var item in Model.Scopes["form"])
                                    {
                                        @* <div class="cost-summary__list-item">@item.Remaining?.ToString("N2")</div> *@
                                        <div class="cost-summary__list-item">@string.Empty</div>
                                    }
                                </div>

                                @if (ownScope)
                                {
                                    <div class="cost-summary__list scp-price">
                                       @*  @foreach (var item in Model.Scopes["scopeOwn"])
                                        {
                                            <div class="cost-summary__list-item">@item.Remaining?.ToString("N2")</div>
                                        } *@

                                        @for (int i = 0; i < Model.Scopes["scopeOwn"].Count; i++)
                                        {
                                            <div class="cost-summary__list-item">
                                                @((Model.Scopes["scopeOwn"][i].Price - Model.Scopes["formOwn"][i].Price).ToString("N2"))
                                            </div>
                                        }
                                    </div>
                                }
                                @if (ownForm)
                                {
                                    <div class="cost-summary__list scp-price">
                                        @foreach (var item in Model.Scopes["formOwn"])
                                        {
                                            @* <div class="cost-summary__list-item">@item.Price.ToString("N2")</div> *@
                                            <div class="cost-summary__list-item">@string.Empty</div>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="@cost_column">
                                <div class="cost-summary__column-header">Объем на текущий год</div>
                                <div class="cost-summary__list scp-price">
                                    @foreach (var item in Model.Scopes["scope"])
                                    {
                                        <div class="cost-summary__list-item">@item.VolumeThisYear?.ToString("N2")</div>
                                    }
                                </div>
                                <div class="cost-summary__list scp-price">
                                    @foreach (var item in Model.Scopes["form"])
                                    {
                                        @* <div class="cost-summary__list-item">@item.VolumeThisYear?.ToString("N2")</div> *@
                                        <div class="cost-summary__list-item">@string.Empty</div>
                                    }
                                </div>

                                @if (ownScope)
                                {
                                    <div class="cost-summary__list scp-price">
                                        @foreach (var item in Model.Scopes["scopeOwn"])
                                        {
                                            <div class="cost-summary__list-item">@item.VolumeThisYear?.ToString("N2")</div>
                                        }
                                    </div>
                                }
                                @if (ownForm)
                                {
                                    <div class="cost-summary__list scp-price">
                                        @foreach (var item in Model.Scopes["formOwn"])
                                        {
                                            @* <div class="cost-summary__list-item">@item.Price.ToString("N2")</div> *@
                                            <div class="cost-summary__list-item">@string.Empty</div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="price-breakdown">
                            @for (int i = 0; i < ViewBag.Periods.Count; i++)
                            {
                                DateTime period = ViewBag.Periods[i];
                                <div class="@price_column">
                                    <div class="price-breakdown__column-header">@period.ToString("MMM yyyy")</div>
                                    <div class="price-breakdown__list">
                                        @foreach (var item in @Model.Scopes["scope"])
                                        {
                                            var cost = item?.Costs?.FirstOrDefault(x => x.Period.Year == period.Year && x.Period.Month == period.Month)?.Value;
                                            <div class="price-breakdown__list-item">@(cost?.ToString("N2") ?? "0,00")</div>
                                        }
                                    </div>
                                    <div class="price-breakdown__list">
                                        @foreach (var item in @Model.Scopes["form"])
                                        {
                                            var cost = item?.Costs?.FirstOrDefault(x => x.Period.Year == period.Year && x.Period.Month == period.Month)?.Value;
                                            <div class="price-breakdown__list-item">@(cost?.ToString("N2") ?? "0,00")</div>
                                        }
                                    </div>

                                    @if (ownScope)
                                    {
                                        <div class="cost-summary__list">
                                            @foreach (var item in Model.Scopes["scopeOwn"])
                                            {
                                                var cost = item?.Costs?.FirstOrDefault(x => x.Period.Year == period.Year && x.Period.Month == period.Month)?.Value;
                                                <div class="cost-summary__list-item">@(cost?.ToString("N2") ?? "0,00")</div>
                                            }
                                        </div>
                                    }
                                    @if (ownForm)
                                    {
                                        <div class="cost-summary__list">
                                            @foreach (var item in Model.Scopes["formOwn"])
                                            {
                                                var cost = item?.Costs?.FirstOrDefault(x => x.Period.Year == period.Year && x.Period.Month == period.Month)?.Value;
                                                <div class="cost-summary__list-item">@(cost?.ToString("N2") ?? "0,00")</div>
                                            }
                                        </div>
                                    }
                                </div>
                            }

                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const costSummary = document.querySelector('.cost-summary');
        const priceBreakdown = document.querySelector('.price-breakdown');
        const container = document.querySelector('.scp-container');

        // Синхронизация прокрутки при скролле контейнера
        container.addEventListener('scroll', function(e) {
            if (e.target === container) {
                costSummary.scrollTop = container.scrollTop;
                priceBreakdown.scrollTop = container.scrollTop;
            }
        });

        // Синхронизация прокрутки при скролле таблицы цен
        priceBreakdown.addEventListener('scroll', function(e) {
            if (e.target === priceBreakdown) {
                container.scrollTop = priceBreakdown.scrollTop;
                costSummary.scrollTop = priceBreakdown.scrollTop;
            }
        });

        // Синхронизация прокрутки при скролле основной таблицы
        costSummary.addEventListener('scroll', function(e) {
            if (e.target === costSummary) {
                container.scrollTop = costSummary.scrollTop;
                priceBreakdown.scrollTop = costSummary.scrollTop;
            }
        });
    });
</script>