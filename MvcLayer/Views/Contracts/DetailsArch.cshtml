@using System.Diagnostics
@using BusinessLayer.Enums;
@using BusinessLayer.Helpers
@using BusinessLayer.Interfaces.Shared
@model MvcLayer.Models.ContractViewModel
@inject BusinessLayer.Interfaces.ContractInterfaces.IVContractService Contracts
@inject BusinessLayer.Interfaces.ContractInterfaces.IScopeWorkService Scopes
@inject BusinessLayer.Interfaces.ContractInterfaces.IOrganizationService Organization
@inject BusinessLayer.Interfaces.ContractServices.IAdditionalTermService AdditionalTerm
@inject BusinessLayer.Interfaces.ContractInterfaces.IArchiveService ArchiveService
@inject IHttpContextUserProvider HttpHelper
@inject IConverterService Convertor

@{
    var permissions = HttpHelper.GetUserPermissions();

    var branchAgreement = Contracts.GetSubsByType(Model.Id, ContractType.Agreement, useArchiveData: true);
    var subContract = Contracts.GetSubsByType(Model.Id, ContractType.SubContract, useArchiveData: true);
    var subObjectsOfContract = Contracts.GetSubsByType(Model.Id, ContractType.MultipleContract, useArchiveData: true);

    var isEngineering = Model.IsEngineering == true ? true : false;
    string redirectAction = "DetailsArch";
    string redirectController = "Contracts";
    var isGRP_Contract = permissions.GroupeName.Contains(Constants.GRP_CONTRACT);
}
<link rel="stylesheet" href="~/css/contract-details-md3.css" asp-append-version="true" />

<div class="page">
    @if ((Model.AgreementContractId is > 0) || (Model.SubContractId is > 0) || (Model.MultipleContractId is > 0))
    {
        var ContractMainid = 0;
        if (Model.AgreementContractId is > 0) ContractMainid = (int)Model.AgreementContractId;
        if (Model.SubContractId is > 0) ContractMainid = (int)Model.SubContractId;
        if (Model.MultipleContractId is > 0) ContractMainid = (int)Model.MultipleContractId;

        <br />
        <a class="back-link" asp-action="DetailsArch" asp-controller="Contracts" asp-route-id="@ContractMainid">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M15 18l-6-6 6-6" /></svg>
            Вернуться к генподрядному договору
        </a>

    }
    else
    {
        <a class="restore-page-state back-link" href="/archive/Contracts@(isEngineering ? "/Engineerings" : "")">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M15 18l-6-6 6-6" /></svg>
            Вернуться к списку
        </a>
    }


    <!-- ==================== ГЛАВНЫЙ ДОГОВОР ==================== -->
    <div class="main-card">
        <div class="main-card-top">
            <div class="main-card-title-row">
                <span class="main-num">№ @Model?.Number</span>
                <span class="main-date">от @Model?.Date?.ToShortDateString()</span>
            </div>
            <div class="menu-wrap">
                <button class="kebab-btn" onclick="toggleMenu(this)">
                    <svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="5" r="2" /><circle cx="12" cy="12" r="2" /><circle cx="12" cy="19" r="2" /></svg>
                </button>
                <div class="action-menu">
                    <div class="menu-header">Просмотр</div>
                    <a class="menu-item" asp-action="OpenScopeArch" asp-route-id="@Model?.Id" asp-controller="Contracts">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M7 2h10a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z" />
                        </svg>
                        @(isEngineering ? "График объема услуг" : "График объема работ")
                    </a>
                    <a class="menu-item" asp-action="GetArchByContractId" asp-controller="ScopeWorks" asp-route-contractId="@Model?.Id" asp-route-isEngineering="@isEngineering" asp-route-returnContractId="@Model.Id">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M7 2h10a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z" />
                        </svg>
                        @(isEngineering ? "Oбъем услуг" : "Oбъем работ")
                    </a>
                    <a class="menu-item" asp-action="GetArchByContractId" asp-controller="Forms" asp-route-contractId="@Model?.Id" asp-route-isEngineering="@isEngineering" asp-route-returnContractId="@Model.Id">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="4" width="18" height="14" rx="2" />
                            <path d="M3 9h18" />
                        </svg>
                        Акты оказанных услуг
                    </a>
                    <a class="menu-item" asp-action="GetArchByContractId" asp-controller="Prepayments" asp-route-contractId="@Model?.Id" asp-route-isEngineering="@isEngineering" asp-route-returnContractId="@Model.Id">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                        </svg>
                        Авансы
                    </a>
                    <a class="menu-item" asp-action="GetArchByContractId" asp-controller="Amendments" asp-route-id="@Model?.Id" asp-route-isEngineering="@isEngineering"  asp-route-returnContractId="@Model.Id">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M9 11l3 3L22 4" />
                            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
                        </svg>
                        Дополнительные соглашения
                    </a>
                    @if (!isEngineering)
                    {
                        @* <a class="menu-item" asp-action="GetByContractId" asp-controller="AdditionalTerm" asp-route-id="@Model?.Id">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="3" width="18" height="18" rx="2" />
                                <path d="M3 9h18M9 21V9" />
                            </svg>
                            Продление сроков исполнения обязательств по договору
                        </a> *@
                        <a class="menu-item" asp-action="GetArchByContractId" asp-controller="Acts" asp-route-id="@Model?.Id" asp-route-isEngineering="@isEngineering" asp-route-returnContractId="@Model.Id">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="3" width="18" height="18" rx="2" />
                                <path d="M3 9h18M9 21V9" />
                            </svg>
                            Акт приостановки/возобновления
                        </a>
                    }

                    <a class="menu-item" asp-action="GetArchByContractId" asp-controller="CommissionActs" asp-route-id="@Model?.Id" asp-route-isEngineering="@isEngineering" asp-route-returnContractId="@Model.Id">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 6L9 17l-5-5" />
                        </svg>
                        Акт ввода
                    </a>
                    <a class="menu-item" asp-action="GetArchByContractId" asp-controller="Correspondences" asp-route-id="@Model?.Id" asp-route-isEngineering="@isEngineering" asp-route-returnContractId="@Model.Id">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                        </svg>
                        Переписка с заказчиком
                    </a>
                    <a class="menu-item" asp-action="GetArchByContractId" asp-controller="EstimateDocs" asp-route-contractId="@Model?.Id" asp-route-isEngineering="@isEngineering" asp-route-returnContractId="@Model.Id">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        </svg>
                        ПСД
                    </a>
                    <a class="menu-item" asp-action="GetArchByContractId" asp-controller="Files" asp-route-id="@Model.Id" asp-route-fileCategory="@Folder.Contracts" asp-route-contractId="@Model?.Id"
                       asp-route-redirectAction=@redirectAction asp-route-redirectController=@redirectController asp-route-returnContractId="@Model.Id" asp-route-isEngineering="@isEngineering">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z" />
                        </svg>
                        Файлы
                    </a>
                </div>
            </div>
        </div>
        <div class="main-object">
            <div class="tt-wrap">
                <div class="clamp-2">@Model?.NameObject</div>
                <div class="tt-popover">@Model?.NameObject</div>
            </div>
        </div>
        <div class="main-grid">
            <div class="field">
                <span class="lbl">Заказчик</span>
                <span class="val">
                    @Model?.Client                    
                </span>
            </div>
            @if (!isEngineering)
            {
                <div class="field">
                    <span class="lbl">Генподрядчик</span>
                    <span class="val gen">
                        @Model?.GenContractor                        
                    </span>
                </div>
            }

            <div class="field">
                <span class="lbl">Источник финансирования</span>
                <span class="val">@Model?.FundingSource</span>
            </div>

            <div class="field">
                <span class="lbl">Сроки выполнения работ</span>
                <span class="val">@Model?.DateBeginWork?.ToShortDateString() – @Model?.DateEndWork?.ToShortDateString()</span>
                <span class="val" style="font-size:12px; color:var(--md3-on-surface-low);">ввод: @Model?.EnteringTerm?.ToShortDateString()</span>
            </div>
            <div class="field">
                <span class="lbl">Процедура выбора</span>
                <span class="val" style="color:var(--md3-primary); font-weight:600;">
                    @if (Model?.Author?.Equals(permissions.Company, StringComparison.OrdinalIgnoreCase) == true || permissions?.Company.Equals("ContrOrgBes", StringComparison.OrdinalIgnoreCase) == true)
                    {
                        <a class="procedure-link" asp-action="GetArchByContractId"
                           asp-controller="SelectionProcedures"
                           asp-route-contractId="@Model?.Id"
                           asp-route-returnContractId="@Model?.Id">
                            @Model?.ProcedureName                           
                        </a>
                    }
                    else
                    {
                        @Model?.ProcedureName
                    }
                </span>
                <span class="lbl">Контрактная цена, с НДС</span>
                <span class="val num">
                    @Model?.ContractPrice.ToString("N2")
                    <span style="font-size:12px; color:var(--md3-on-surface-low); font-weight:400;"> @Model?.Сurrency</span>
                </span>
            </div>
            <div class="field">
                <span class="lbl">Условия оплаты</span>
                @* Авансирование *@

                @{
                    var hasNone = @Model?.PaymentСonditionsAvans?.Contains("Без авансов");
                    var hasCurrent = @Model?.PaymentСonditionsAvans?.Contains("С предоставлением текущего аванса");
                    var hasTarget = @Model?.PaymentСonditionsAvans?.Contains("С предоставлением целевого аванса");
                }

                @if (hasNone == true)
                {
                    <span class="pay-chip pc-none">Без авансов</span>
                }
                @if (hasCurrent == true && hasTarget == true)
                {
                    <span class="pay-chip pc-target"><a href="/Prepayments/GetArchByContractId?contractId=@Model?.Id">С текущим + целевым авансом</a></span>
                }
                else
                {
                    @if (hasCurrent == true)
                    {
                        <span class="pay-chip pc-current"><a href="/Prepayments/GetArchByContractId?contractId=@Model?.Id">С текущим авансом</a></span>
                    }

                    @if (hasTarget == true)
                    {
                        <span class="pay-chip pc-current"><a href="/Prepayments/GetArchByContractId?contractId=@Model?.Id">С целевым авансом</a></span>
                    }
                }

                @* Оплата *@
                <div class="tt-wrap val">
                    <div class="pay-terms">@Model?.PaymentСonditionsRaschet</div>
                    <div class="tt-popover">@Model?.PaymentСonditionsRaschet</div>
                </div>
            </div>
        </div>      

        <div class="main-people">
            <span><b>Подписант:</b>  @Model?.SignatoryEmp?.Replace("Подписант -", "") </span>
            <span>
                <b>Ответственное лицо за ведение договора:</b>
                @Model?.ResponsibleEmp?.Replace("Лицо, ответственное за ведение договора -", "")
            </span>
            <div class="tt-wrap" style="max-width:260px;">
                <span class="clamp-2" style="-webkit-line-clamp:1;"><b>Работы:</b> @Model?.WorkType</span>
            </div>
        </div>
    </div>
    <div style="display:flex; flex-direction:column; max-height:42vh; overflow-y:auto;">
        @if (subObjectsOfContract.Any() || branchAgreement.Any() || subContract.Any())
        {
            <!-- ==================== СТРУКТУРА ДОГОВОРА ==================== -->
            <div class="section-title">Структура договора</div>
        }


        <!-- --- Дерево подобъектов --- -->
        @if (subObjectsOfContract?.Any() == true)
        {
            <div class="tree-block">
                <div class="tree-header">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3h6v6H3zM15 3h6v6h-6zM3 15h6v6H3z" /><path d="M9 6h4M15 6H9M6 9v6M12 6v3a3 3 0 0 0 3 3h0" /></svg>
                    Подобъекты
                    <span class="tree-count">@subObjectsOfContract.Count()</span>
                </div>

                <!-- Подобъект 1 — со своим вложенным субподрядом -->
                @foreach (var contractBranch in subObjectsOfContract)
                {
                    <div class="tree-node">
                        <div class="tree-node-card">
                            <div class="row-grid">
                                <div class="row-cell-num">
                                    <span class="type-chip type-subobj">
                                        Подобъект
                                        <br />
                                        @if (contractBranch?.Author?.Equals(permissions.Company, StringComparison.OrdinalIgnoreCase) == false && contractBranch?.Author != null)
                                        {
                                            <span class="badge rounded-pill bg-secondary text-wrap" style="width:80%;font-size:0.9rem">
                                                @Convertor.GetNameOrganizationByCode(contractBranch?.Author)
                                            </span>
                                        }
                                    </span>
                                    @*  <span class="row-num">№ 33/22D-1</span>
                                <span class="row-date">от 10.07.2026</span> *@
                                </div>
                                <div class="row-object">
                                    <div class="tt-wrap"><div class="clamp-2">@contractBranch?.NameObject</div></div>
                                </div>
                                <div class="row-sides"><span class="empty-dash">— не заполняются для подобъекта —</span></div>
                                <div class="row-deadline">
                                    <span class="lbl">выполнения работ</span><br>
                                    <span class="val">@contractBranch?.DateBeginWork?.ToShortDateString() -  @contractBranch?.DateEndWork?.ToShortDateString()</span><br>
                                    <span class="lbl">ввод</span><br>
                                    <span class="val">@contractBranch?.EnteringTerm?.ToShortDateString()</span>
                                </div>
                                <div class="row-terms"><span class="empty-dash">—</span></div>
                                <div class="row-work"><span class="empty-dash">—</span></div>
                                <div class="row-fin">
                                    <span class="fin-val">
                                        @contractBranch?.ContractPrice?.ToString("N2")
                                        <span class="fin-cur">@contractBranch?.Сurrency</span>
                                    </span>
                                </div>
                                <div class="row-actions">
                                    @if (contractBranch?.Author?.Equals(permissions.Company, StringComparison.OrdinalIgnoreCase) == true || permissions.Company.Equals("ContrOrgBes", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <div class="menu-wrap">
                                            <button class="kebab-btn" style="width:32px;height:32px;" onclick="toggleMenu(this)">
                                                <svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="5" r="2" /><circle cx="12" cy="12" r="2" /><circle cx="12" cy="19" r="2" /></svg>
                                            </button>
                                            <div class="action-menu">
                                                <div class="menu-header">Просмотр</div>
                                                <a class="menu-item" asp-action="OpenScopeArch" asp-route-id="@contractBranch?.Id" asp-controller="Contracts" asp-route-mainId="@Model?.Id">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M7 2h10a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z" />
                                                    </svg>
                                                    @(isEngineering ? "График объема услуг" : "График объема работ")
                                                </a>
                                                <a class="menu-item" asp-action="GetArchByContractId" asp-controller="ScopeWorks" asp-route-contractId="@contractBranch?.Id" asp-route-isEngineering="@isEngineering" asp-route-returnContractId="@Model.Id">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M7 2h10a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z" />
                                                    </svg>
                                                    @(isEngineering ? "Oбъем услуг" : "Oбъем работ")
                                                </a>
                                                <a class="menu-item" asp-action="GetArchByContractId" asp-controller="Forms" asp-route-contractId="@contractBranch?.Id" asp-route-isEngineering="@isEngineering" asp-route-returnContractId="@Model?.Id">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                        <rect x="3" y="4" width="18" height="14" rx="2" />
                                                        <path d="M3 9h18" />
                                                    </svg>
                                                    Акты оказанных услуг
                                                </a>
                                                <a class="menu-item" asp-action="GetArchByContractId" asp-controller="Prepayments" asp-route-contractId="@contractBranch?.Id" asp-route-isEngineering="@isEngineering" asp-route-returnContractId="@Model?.Id">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                                                    </svg>
                                                    Авансы
                                                </a>
                                                <a class="menu-item" asp-action="GetArchByContractId" asp-controller="Amendments" asp-route-id="@contractBranch?.Id" asp-route-returnContractId="@Model?.Id">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M9 11l3 3L22 4" />
                                                        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
                                                    </svg>
                                                    Дополнительные соглашения
                                                </a>
                                                @if (!isEngineering)
                                                {

                                                    @*  <a class="menu-item" asp-action="GetByContractId" asp-controller="AdditionalTerm" asp-route-id="@contractBranch?.Id" asp-route-returnContractId="@Model?.Id">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                            <rect x="3" y="3" width="18" height="18" rx="2" />
                                                            <path d="M3 9h18M9 21V9" />
                                                        </svg>
                                                        Продление сроков исполнения обязательств по договору
                                                    </a> *@
                                                    <a class="menu-item" asp-action="GetArchByContractId" asp-controller="Acts" asp-route-id="@contractBranch?.Id" asp-route-returnContractId="@Model?.Id">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                            <rect x="3" y="3" width="18" height="18" rx="2" />
                                                            <path d="M3 9h18M9 21V9" />
                                                        </svg>
                                                        Акт приостановки/возобновления
                                                    </a>
                                                }

                                                <a class="menu-item" asp-action="GetArchByContractId" asp-controller="CommissionActs" asp-route-id="@contractBranch?.Id" asp-route-isEngineering="@isEngineering" asp-route-returnContractId="@Model?.Id">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M20 6L9 17l-5-5" />
                                                    </svg>
                                                    Акт ввода
                                                </a>
                                                <a class="menu-item" asp-action="GetArchByContractId" asp-controller="Correspondences" asp-route-id="@contractBranch?.Id" asp-route-isEngineering="@isEngineering" asp-route-returnContractId="@Model?.Id">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                                                    </svg>
                                                    Переписка с заказчиком
                                                </a>
                                                <a class="menu-item" asp-action="GetArchByContractId" asp-controller="EstimateDocs" asp-route-contractId="@contractBranch?.Id" asp-route-returnContractId="@Model?.Id">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                                    </svg>
                                                    ПСД
                                                </a>
                                                <a class="menu-item" asp-action="GetArchByContractId" asp-controller="Files"
                                                   asp-route-id="@contractBranch.Id"
                                                   asp-route-fileCategory="@Folder.Contracts"
                                                   asp-route-contractId="@contractBranch?.Id"
                                                   asp-route-redirectAction=@redirectAction
                                                   asp-route-redirectController=@redirectController
                                                   asp-route-isEngineering=""
                                                   asp-route-returnContractId="@Model?.Id">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z" />
                                                    </svg>
                                                    Файлы
                                                </a>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- вложенный аккордеон: субподряды именно этого подобъекта -->

                            <div class="nested-accordion">

                                @{
                                    var branchAgreementNested = Contracts.GetSubsByType(contractBranch.Id, ContractType.Agreement, useArchiveData: true);
                                    var subContractNested = Contracts.GetSubsByType(contractBranch.Id, ContractType.SubContract, useArchiveData: true);
                                }

                                <div class="nested-toggle open" onclick="toggleNested(this)">
                                    <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M9 6l6 6-6 6" /></svg>
                                    Договоры субподряда подобъекта
                                    <span class="nested-count">@(branchAgreementNested.Count() + subContractNested.Count())</span>
                                </div>
                                <div class="nested-body open">
                                    @foreach (var nestedBranch in branchAgreementNested)
                                    {
                                        <div class="nested-row-card">
                                            <div class="row-grid">
                                                <div class="row-cell-num">
                                                    <span class="type-chip type-agreement">Соглашение</span>
                                                    <span class="row-num">№ @nestedBranch?.Number</span>
                                                    <span class="row-date">от @nestedBranch?.Date?.ToShortDateString()</span>
                                                </div>
                                                <div class="row-sides">
                                                    <span class="side-lbl">Процедура выбора</span><br>
                                                    @if (Model?.Author?.Equals(permissions.Company, StringComparison.OrdinalIgnoreCase) == true || permissions?.Company.Equals("ContrOrgBes", StringComparison.OrdinalIgnoreCase) == true)
                                                    {
                                                        <span class="val">
                                                            <a class="procedure-link" asp-action="GetArchByContractId" asp-controller="SelectionProcedures" asp-route-contractId="@nestedBranch?.Id"
