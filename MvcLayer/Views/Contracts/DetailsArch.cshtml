<script>
    function toggleAccordion(header){
      header.classList.toggle('open');
      header.nextElementSibling.classList.toggle('open');
    }
    function toggleNested(el){
      el.classList.toggle('open');
      el.nextElementSibling.classList.toggle('open');
    }

    /* ---- kebab-меню: портал в body, fixed-позиционирование ---- */
    let openMenu = null, openBtn = null, homeParent = null, homeNextSibling = null;

    function closeMenu(){
      if(!openMenu) return;
      openMenu.classList.remove('open');
      openMenu.style.position = '';
      openMenu.style.top = '';
      openMenu.style.left = '';
      if(homeParent){
        if(homeNextSibling){ homeParent.insertBefore(openMenu, homeNextSibling); }
        else { homeParent.appendChild(openMenu); }
      }
      openMenu = null; openBtn = null; homeParent = null; homeNextSibling = null;
    }

    function toggleMenu(btn){
      const menu = btn.parentElement.querySelector('.action-menu');
      if(openMenu === menu){ closeMenu(); return; }
      closeMenu();
      homeParent = menu.parentNode;
      homeNextSibling = menu.nextSibling;
      document.body.appendChild(menu);
      menu.classList.add('open');
      menu.style.position = 'fixed';
      positionMenu(btn, menu);
      openMenu = menu; openBtn = btn;
    }

    function positionMenu(btn, menu){
      const btnRect = btn.getBoundingClientRect();
      const menuRect = menu.getBoundingClientRect();
      const vw = window.innerWidth, vh = window.innerHeight, margin = 8;
      let top = btnRect.bottom + 4;
      let left = btnRect.right - menuRect.width;
      if(top + menuRect.height > vh - margin){ top = btnRect.top - menuRect.height - 4; }
      if(top < margin){ top = margin; }
      if(left < margin){ left = margin; }
      if(left + menuRect.width > vw - margin){ left = vw - margin - menuRect.width; }
      menu.style.top = top + 'px';
      menu.style.left = left + 'px';
    }

    document.addEventListener('click', function(e){
      if(openMenu && !openMenu.contains(e.target) && e.target !== openBtn && !openBtn.contains(e.target)){
        closeMenu();
      }
    });
    window.addEventListener('scroll', closeMenu, true);
    window.addEventListener('resize', closeMenu);
</script>